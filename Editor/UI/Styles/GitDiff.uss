/*
 * git-diff: 내장 diff 뷰어(색은 Themes/*.uss 의 --git-diff-* 토큰). 통합 보기(diff-row) 와 나란히 보기(diff-row--split, 양쪽 diff-side) 두 줄 모양을 쓴다.
 * 색은 GitHub·VS Code 의 어두운 테마 diff 색에 맞췄다(초록=더함, 빨강=지움, 진한 칸=줄 안에서 실제로 바뀐 부분).
 */

.git-diff {
    flex-grow: 1;
    background-color: var(--git-bg);
    color: var(--git-text);
}

.git-diff__toolbar {
    flex-shrink: 0;
}

.git-diff__title {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    -unity-text-align: middle-left;
    margin: 0 6px;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.git-diff__info {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    height: 22px;
    padding: 0 6px;
    background-color: var(--git-header-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.git-diff__stat {
    font-size: 11px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    margin-right: 6px;
    padding: 0;
}

.git-diff__stat--added {
    color: var(--git-diff-added-sign);
}

.git-diff__stat--removed {
    color: var(--git-diff-removed-sign);
}

.git-diff__revisions {
    flex-shrink: 1;
    font-size: 10px;
    color: var(--git-text-muted);
    margin-left: 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.git-diff__nav {
    width: 22px;
    height: 18px;
    padding: 0;
    margin: 0 0 0 2px;
}

.git-diff__notice {
    margin: 16px;
    -unity-text-align: middle-center;
    color: var(--git-text-muted);
    white-space: normal;
}

/* "불러오는 중": 내용 위에 겹쳐 띄운다(자리를 차지하지 않아 내용이 밀리지 않는다). */
.git-diff__loading {
    position: absolute;
    left: 0;
    right: 0;
    top: 40%;
    -unity-text-align: middle-center;
    color: var(--git-text-muted);
}

/* 비어 있을 때는 위의 안내 문구가 대신 말하므로 ListView 기본 "List is empty" 는 숨긴다. */
.git-diff__list .unity-list-view__empty-label {
    display: none;
}

.git-diff__list {
    flex-grow: 1;
    flex-basis: 0;
    background-color: var(--git-diff-bg);
}

/* ── 줄 하나 ───────────────────────────────── */
.diff-row {
    flex-direction: row;
    height: 18px;
    align-items: stretch;
}

.diff-side {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    overflow: hidden;
}

.diff-side--left {
    border-right-width: 1px;
    border-right-color: var(--git-diff-split-border);
}

.diff-row__number {
    width: 48px;
    min-width: 48px;
    padding: 0 6px 0 0;
    margin: 0;
    font-size: 11px;
    -unity-text-align: middle-right;
    color: var(--git-diff-number);
    background-color: var(--git-diff-gutter);
}

.diff-row__sign {
    width: 16px;
    min-width: 16px;
    padding: 0;
    margin: 0;
    -unity-text-align: middle-center;
    color: var(--git-diff-number);
}

.diff-row__code {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

/* 앞·바뀐 부분·뒤 세 조각. 공백을 그대로 보이게 줄바꿈 없이 붙인다. */
.diff-row__part {
    padding: 0;
    margin: 0;
    flex-shrink: 0;
    white-space: pre;
    -unity-text-align: middle-left;
    color: var(--git-diff-text);
}

.diff-row--added,
.diff-side--added {
    background-color: var(--git-diff-added-line);
}

.diff-row--added .diff-row__change,
.diff-side--added .diff-row__change {
    background-color: var(--git-diff-added-change);
}

.diff-row--removed,
.diff-side--removed {
    background-color: var(--git-diff-removed-line);
}

.diff-row--removed .diff-row__change,
.diff-side--removed .diff-row__change {
    background-color: var(--git-diff-removed-change);
}

.diff-row--added .diff-row__sign,
.diff-side--added .diff-row__sign {
    color: var(--git-diff-added-sign);
}

.diff-row--removed .diff-row__sign,
.diff-side--removed .diff-row__sign {
    color: var(--git-diff-removed-sign);
}

/* 반대편에 짝이 없는 칸(나란히 보기). 빗금 대신 더 어두운 칸으로 비어 있음을 보인다. */
.diff-side--empty {
    background-color: var(--git-diff-empty);
}

/* 바뀐 덩어리 머리(@@ -a,b +c,d @@)·"\ No newline at end of file": Fork 처럼 바탕을 칠하지 않고 흐린 글자로만 보인다
   (파랗게 칠하면 코드보다 눈에 띈다). */
.diff-row--hunk,
.diff-side--hunk {
    background-color: rgba(0, 0, 0, 0);
}

.diff-row--hunk .diff-row__part,
.diff-side--hunk .diff-row__part,
.diff-row--meta .diff-row__part,
.diff-side--meta .diff-row__part {
    color: var(--git-text-muted);
}

/* ── 이미지 diff (GitImageDiffView) ─────────────────── */
.git-image-diff {
    flex-grow: 1;
    flex-basis: 0;
}

.git-image-diff__toolbar {
    flex-shrink: 0;
}

.git-image-diff__slider {
    width: 220px;
    margin: 0 6px;
    align-items: center;
}

.git-image-diff__slider > .unity-base-field__label {
    min-width: 0;
    padding-right: 6px;
}

.git-image-diff__slider .unity-base-slider__input {
    min-width: 60px;
}

.git-image-diff__slider .unity-base-field__input {
    min-width: 30px;
}

.git-image-diff__zoom {
    min-width: 44px;
    margin-right: 4px;
    font-size: 11px;
    -unity-text-align: middle-right;
    color: var(--git-text-muted);
}

.git-image-diff__info {
    font-size: 11px;
    margin-right: 12px;
    padding: 0;
    white-space: nowrap;
    color: var(--git-text);
}

.git-image-diff__size-changed {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-diff-removed-sign);
}

.git-image-diff__info--changed {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-diff-hunk-text);
}

.git-image-diff__stage {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    background-color: var(--git-diff-bg);
}

.git-image-diff__viewport {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    overflow: hidden;
}

.git-image-diff__viewport--left {
    border-right-width: 1px;
    border-right-color: var(--git-diff-split-border);
}

/* 위치·크기는 코드가 배율에 맞춰 정한다. */
.git-image-diff__layer {
    position: absolute;
    left: 0;
    top: 0;
}

/* 투명 픽셀이 보이도록 깔아 두는 체커보드. 2×2 텍스처를 16px 칸으로 반복한다(칸 하나 8px). */
.git-image-diff__checker {
    background-repeat: repeat repeat;
    background-size: 16px 16px;
}

.git-image-diff__clip {
    overflow: hidden;
}

.git-image-diff__caption {
    position: absolute;
    left: 6px;
    top: 4px;
    padding: 1px 6px;
    font-size: 10px;
    border-radius: 3px;
    color: #ffffff;
    background-color: rgba(0, 0, 0, 0.55);
}

.git-image-diff__mode-controls {
    flex-direction: row;
    align-items: center;
}

/* 새로 만든·지운 이미지: 이미지 둘레 테두리와 위 가운데 상태 글자(GitHub 처럼 추가는 초록, 삭제는 빨강). */
.git-image-diff__frame {
    border-width: 1px;
}

.git-image-diff--added .git-image-diff__frame {
    border-color: var(--git-success);
}

.git-image-diff--deleted .git-image-diff__frame {
    border-color: var(--git-danger);
}

.git-image-diff__status {
    position: absolute;
    left: 0;
    right: 0;
    top: 6px;
    -unity-text-align: middle-center;
    font-size: 13px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
}

.git-image-diff--added .git-image-diff__status {
    color: var(--git-success);
}

.git-image-diff--deleted .git-image-diff__status {
    color: var(--git-danger);
}

.git-image-diff__placeholder {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 14px;
    color: var(--git-text-muted);
}

.git-image-diff__swipe-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    align-items: center;
    cursor: link;
}

.git-image-diff__swipe-line {
    width: 2px;
    flex-grow: 1;
    background-color: var(--git-accent);
}

/* 경계선 가운데의 동그라미 손잡이. 손잡이 칸(12px)보다 넓어 가운데에 맞춰 양옆으로 넘친다. */
.git-image-diff__swipe-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 30px;
    height: 30px;
    translate: -50% -50%;
    border-width: 2px;
    border-radius: 15px;
    border-color: var(--git-accent);
    background-color: #ffffff;
    align-items: center;
    justify-content: center;
    /* 손잡이 칸보다 넓어 칸 밖으로 넘친 부분에서도 같은 커서가 보이게 따로 준다. */
    cursor: link;
}

/* 아이콘은 흰색(Material Symbols "arrows_outward")이라 흰 손잡이 위에서 보이도록 어둡게 물들인다. */
.git-image-diff__swipe-knob-arrows {
    width: 20px;
    height: 20px;
    background-image: url("../Icons/SwipeArrows.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #1f1f1f;
}

/* ── 바이너리 파일 카드(이미지 밖, 또는 새로 만든·지운 이미지): Fork 처럼 상태·아이콘·확장자·크기 ─────────── */
.git-diff-binary {
    flex-grow: 1;
    align-items: center;
    padding-top: 24px;
}

.git-diff-binary__status {
    margin: 0 0 10px 0;
    font-size: 13px;
    -unity-text-align: middle-center;
}

.git-diff-binary__status--created {
    color: var(--git-success);
}

.git-diff-binary__status--deleted {
    color: var(--git-danger);
}

.git-diff-binary__status--modified {
    color: var(--git-warning);
}

.git-diff-binary__cards {
    flex-direction: row;
    align-items: center;
}

.git-diff-binary__column {
    align-items: center;
    margin: 0 10px;
}

/* 회색 카드 안 가운데에 파일 아이콘과 확장자. */
.git-diff-binary__card {
    width: 164px;
    height: 194px;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    background-color: var(--git-pressed);
}

.git-diff-binary__icon {
    width: 32px;
    height: 32px;
    margin-bottom: 8px;
}

.git-diff-binary__extension {
    margin: 0;
    font-size: 13px;
    color: var(--git-text);
    -unity-text-align: middle-center;
}

.git-diff-binary__size {
    margin: 10px 0 0 0;
    font-size: 12px;
    color: var(--git-text);
    -unity-text-align: middle-center;
}

.git-diff-binary__arrow {
    margin: 0 6px 30px 6px;
    font-size: 20px;
    color: var(--git-text-muted);
}

.git-diff-binary__error {
    margin: 16px;
    color: var(--git-danger);
    white-space: normal;
}

/* ── 이미지 속성 칸(Show properties): 아래쪽에 이전·이후 판의 크기·형식·해상도를 줄 번호와 함께. 다른 값은 diff 색으로 ─── */
.git-image-diff__properties {
    flex-direction: row;
    flex-shrink: 0;
    overflow: hidden;
    background-color: var(--git-diff-bg);
}


/* 속성 칸 위 경계. 잡기 쉽게 5px 높이로 두고 가운데 1px 선(…-line)만 보인다. */
.git-image-diff__properties-splitter {
    flex-shrink: 0;
    height: 5px;
    justify-content: center;
    cursor: resize-vertical;
    background-color: var(--git-diff-bg);
}

.git-image-diff__properties-splitter-line {
    height: 1px;
    background-color: var(--git-border);
}

.git-image-diff__properties-splitter:hover .git-image-diff__properties-splitter-line {
    height: 2px;
    background-color: var(--git-accent);
}

.git-image-diff__properties-column {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    padding-bottom: 6px;
}

.git-image-diff__properties-gutter {
    width: 1px;
    background-color: var(--git-diff-split-border);
}

.git-image-diff__properties-header {
    margin: 0;
    padding: 3px 8px;
    font-size: 11px;
    -unity-text-align: middle-center;
    color: var(--git-text-muted);
    background-color: var(--git-header-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.git-image-diff__property {
    flex-direction: row;
    height: 18px;
    align-items: center;
}

.git-image-diff__property--before {
    background-color: var(--git-diff-removed-line);
}

.git-image-diff__property--after {
    background-color: var(--git-diff-added-line);
}

.git-image-diff__property-number {
    width: 28px;
    margin: 0;
    padding: 0 6px 0 0;
    font-size: 11px;
    -unity-text-align: middle-right;
    color: var(--git-text-muted);
}

.git-image-diff__property-value {
    margin: 0;
    padding: 0;
    font-size: 12px;
    -unity-font-definition: url("../Fonts/Jetendard-Regular.ttf");
    color: var(--git-text);
}
