/*
 * git-diff: 내장 diff 뷰어(색은 Themes/*.uss 의 --git-diff-* 토큰). 통합 보기(diff-row) 와 나란히 보기(diff-row--split, 양쪽 diff-side) 두 줄 모양을 쓴다.
 * 색은 GitHub·VS Code 의 어두운 테마 diff 색에 맞췄다(초록=더함, 빨강=지움, 진한 칸=줄 안에서 실제로 바뀐 부분).
 */

.git-diff {
    flex-grow: 1;
    background-color: var(--git-bg);
    color: var(--git-text);
    /* 코드에서 끌어 고른 글의 배경. 코드(GitDiffPanel)가 읽어 리치 텍스트 <mark> 색으로 쓴다. */
    --diff-text-selection: var(--git-diff-text-selection);
}

/* 테마의 .git-theme--* .unity-toolbar(높이 26px)보다 세게. */
.git-diff > .unity-toolbar.git-diff__toolbar {
    flex-shrink: 0;
    overflow: hidden;
    height: 32px;
    align-items: center;
    padding: 0 8px 0 2px;
}

/* ── 버튼 한 벌(GitKraken 처럼 diff 의 모든 버튼이 같은 높이·테두리·모서리·글자 크기) ──
   높이 22px·테두리 1px·모서리 --git-radius·글자 12px. 무채색 버튼은 --git-field-border 테두리에 바탕 없음,
   Stage 는 초록·버리기/Unstage 는 빨강 테두리에 같은 색을 옅게 깐 바탕(Staging 칸의 Stage All 과 같다). */

/* 좁아지면 파일 이름·판 설명이 말줄임으로 줄고, 오른쪽 버튼(외부 도구로 열기·다시 읽기·×)은 줄지 않는다 — 줄면 글자가 왼쪽 글 위로 넘쳐 겹친다. */
.git-diff .git-diff__toolbar > .unity-toolbar-button {
    flex-shrink: 0;
    height: 22px;
    margin: 0 0 0 6px;
    padding: 0 10px;
    border-width: 1px;
    border-color: var(--git-field-border);
    border-radius: var(--git-radius);
    background-color: rgba(0, 0, 0, 0);
    color: var(--git-text);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.git-diff .git-diff__toolbar > .unity-toolbar-button:hover {
    background-color: var(--git-hover);
}

/* 다시 읽기(아이콘만)는 정사각형. */
.git-diff .git-diff__toolbar > .unity-toolbar-button.git-diff__tool-button--icon {
    width: 22px;
    padding: 0;
    justify-content: center;
    align-items: center;
}

/* × 는 GitKraken 처럼 테두리 없는 아이콘 버튼. */
.git-diff .git-diff__toolbar > .unity-toolbar-button.git-diff__close {
    width: 22px;
    padding: 0;
    border-width: 0;
    font-size: 16px;
    color: var(--git-text-muted);
}

.git-diff .git-diff__toolbar > .unity-toolbar-button.git-diff__close:hover {
    color: var(--git-text);
}

.git-diff__title {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    -unity-text-align: middle-left;
    margin: 0 6px;
    min-width: 0;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* ── GitKraken 식 diff 막대 ─────────────────────────────
   [이 파일 편집]      [Unstaged] [파일 보기|Diff 보기]      [Blame|히스토리] [↑|↓] [▤|☰|◫] [¶|≡]
   왼쪽·오른쪽 묶음이 남는 폭을 반씩 가져 가운데 묶음이 늘 가운데에 온다. */
.git-diff__bar {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    height: 32px;
    padding: 0 8px;
    background-color: var(--git-header-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
    overflow: hidden;
}

.git-diff__bar-group {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.git-diff__bar-side {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.git-diff__bar-side--right {
    justify-content: flex-end;
}

.git-diff__bar-center {
    margin: 0 10px;
}

/* 버튼 하나. 묶음 안에서는 테두리를 묶음이 그리고 칸 사이에 선만 긋는다. */
.git-diff__bar-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 22px;
    min-width: 26px;
    margin: 0;
    padding: 0 9px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--git-text);
}

.git-diff__bar-button:hover {
    background-color: var(--git-hover);
}

.git-diff__bar-button--icon-only {
    width: 28px;
    padding: 0;
}

.git-diff__bar-button--checked,
.git-diff__bar-button--checked:hover {
    background-color: var(--git-selected);
    color: var(--git-selected-text);
}

.git-diff__bar-button:disabled {
    opacity: 0.4;
}

/* 묶음 밖에 홀로 선 버튼(이 파일 편집)은 자기 테두리를 그린다. */
.git-diff__bar-button--outlined {
    border-width: 1px;
    border-color: var(--git-field-border);
    border-radius: var(--git-radius);
}

.git-diff__bar-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--git-text-muted);
}

.git-diff__bar-button:hover .git-diff__bar-icon {
    -unity-background-image-tint-color: var(--git-text);
}

.git-diff__bar-button--checked .git-diff__bar-icon {
    -unity-background-image-tint-color: var(--git-selected-text);
}

.git-diff__bar-icon--edit { background-image: url("../Icons/DiffEdit.png"); -unity-background-image-tint-color: var(--git-accent); }
.git-diff__bar-icon--up { background-image: url("../Icons/DiffUp.png"); }
.git-diff__bar-icon--down { background-image: url("../Icons/DiffDown.png"); }
.git-diff__bar-icon--hunk { background-image: url("../Icons/DiffViewHunk.png"); }
.git-diff__bar-icon--inline { background-image: url("../Icons/DiffViewInline.png"); }
.git-diff__bar-icon--split { background-image: url("../Icons/DiffViewSplit.png"); }
.git-diff__bar-icon--whitespace { background-image: url("../Icons/DiffWhitespace.png"); }
.git-diff__bar-icon--wrap { background-image: url("../Icons/DiffWrap.png"); }

.git-diff__bar-text {
    margin: 0;
    padding: 0;
    font-size: 12px;
    white-space: nowrap;
}

.git-diff__bar-text--with-icon {
    margin-left: 6px;
}

/* 한 테두리 안의 칸 묶음([파일 보기|Diff 보기]·[↑|↓] 등). 묶음 사이는 6px. */
.git-diff__segment {
    flex-direction: row;
    flex-shrink: 0;
    margin-left: 6px;
    border-width: 1px;
    border-color: var(--git-field-border);
    border-radius: var(--git-radius);
    overflow: hidden;
}

.git-diff__bar-center > .git-diff__segment {
    margin-left: 8px;
}

/* 묶음 테두리(위·아래 1px)를 더해 홀로 선 버튼과 같은 22px 가 되게 칸은 20px. */
.git-diff__segment-button {
    height: 20px;
    border-left-width: 1px;
    border-left-color: var(--git-field-border);
}

.git-diff__segment-button--first {
    border-left-width: 0;
}

/* 지금 보는 쪽(Unstaged·Staged). 양쪽에 다 변경이 있을 때만 눌러 바꿀 수 있다. */
.git-diff__chip {
    height: 22px;
    margin: 0;
    padding: 0 10px;
    border-width: 1px;
    border-color: var(--git-selected);
    border-radius: var(--git-radius);
    background-color: var(--git-selected);
    color: var(--git-selected-text);
    font-size: 12px;
}

.git-diff__chip:disabled {
    opacity: 1;
}

.git-diff__chip--switchable:hover {
    border-color: var(--git-accent);
}

/* 좁은 칸(Git 창 가운데 등): 가운데 맞춤을 그만두고 왼쪽부터 차례로 놓는다(가운데 맞춤은 양옆이 같은 폭을 가져 겹친다).
   "이 파일 편집" 은 아이콘만, 더 좁으면 Blame·히스토리, 그보다 좁으면 공백·줄 바꿈 묶음을 뺀다. */
.git-diff__bar--compact .git-diff__bar-text--with-icon {
    display: none;
}

.git-diff__bar--compact .git-diff__bar-button--outlined {
    width: 28px;
    padding: 0;
}

/* 묶음은 자기 내용 폭보다 줄지 않는다. 줄면 오른쪽 묶음(오른쪽 맞춤)의 버튼이 왼쪽으로 넘쳐 가운데 묶음 위에 겹친다.
   그래도 모자라면 막대(overflow: hidden)가 오른쪽 끝을 자른다 — 겹치는 것보다 낫고, 그 전에 아래 단계들이 버튼을 뺀다. */
.git-diff__bar--compact .git-diff__bar-side,
.git-diff__bar--compact .git-diff__bar-center {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
}

.git-diff__bar--compact .git-diff__bar-center {
    margin: 0 0 0 8px;
}

.git-diff__bar--compact .git-diff__bar-side--right {
    flex-grow: 1;
}

.git-diff__bar--narrow .git-diff__segment--file-tools {
    display: none;
}

.git-diff__bar--tiny .git-diff__segment--display {
    display: none;
}

/* Git 창 가운데 칸처럼 아주 좁으면 보기 방식 셋도 뺀다(마지막에 고른 방식이 그대로 쓰인다). */
.git-diff__bar--micro .git-diff__segment--layouts {
    display: none;
}

.git-diff__stat {
    font-size: 11px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    margin-right: 6px;
    padding: 0;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

.git-diff__stat--added {
    color: var(--git-diff-added-sign);
}

.git-diff__stat--removed {
    color: var(--git-diff-removed-sign);
}

.git-diff__revisions {
    flex-shrink: 2;
    min-width: 0;
    -unity-text-align: middle-left;
    font-size: 10px;
    color: var(--git-text-muted);
    margin-left: 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}


.git-diff__notice {
    margin: 16px;
    -unity-text-align: middle-center;
    color: var(--git-text-muted);
    white-space: normal;
}

/* "불러오는 중": 내용 위에 겹쳐 띄운다(자리를 차지하지 않아 내용이 밀리지 않는다). */
.git-diff__loading {
    position: absolute;
    left: 0;
    right: 0;
    top: 40%;
    -unity-text-align: middle-center;
    color: var(--git-text-muted);
}

/* 비어 있을 때는 위의 안내 문구가 대신 말하므로 ListView 기본 "List is empty" 는 숨긴다. */
.git-diff__list .unity-list-view__empty-label {
    display: none;
}

.git-diff__list {
    flex-grow: 1;
    flex-basis: 0;
    background-color: var(--git-diff-bg);
}

/* ── 줄 하나 ───────────────────────────────── */
.diff-row {
    flex-direction: row;
    height: 18px;
    align-items: stretch;
}

.diff-side {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    overflow: hidden;
}

.diff-side--left {
    border-right-width: 1px;
    border-right-color: var(--git-diff-split-border);
}

.diff-row__number {
    width: 48px;
    min-width: 48px;
    padding: 0 6px 0 0;
    margin: 0;
    font-size: 11px;
    -unity-text-align: middle-right;
    color: var(--git-diff-number);
    background-color: var(--git-diff-gutter);
}

.diff-row__sign {
    width: 16px;
    min-width: 16px;
    padding: 0;
    margin: 0;
    -unity-text-align: middle-center;
    color: var(--git-diff-number);
}

/* 코드 칸은 편집기처럼 끌어 글을 고른다(I 모양 커서). 줄 고르기(부분 스테이징)는 거터·줄 번호 쪽에서 한다. */
.diff-row__code {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    cursor: text;
}

/* 앞·바뀐 부분·뒤 세 조각. 공백을 그대로 보이게 줄바꿈 없이 붙인다. */
.diff-row__part {
    padding: 0;
    margin: 0;
    flex-shrink: 0;
    white-space: pre;
    -unity-text-align: middle-left;
    color: var(--git-diff-text);
}

.diff-row--added,
.diff-side--added {
    background-color: var(--git-diff-added-line);
}

.diff-row--added .diff-row__change,
.diff-side--added .diff-row__change {
    background-color: var(--git-diff-added-change);
}

.diff-row--removed,
.diff-side--removed {
    background-color: var(--git-diff-removed-line);
}

.diff-row--removed .diff-row__change,
.diff-side--removed .diff-row__change {
    background-color: var(--git-diff-removed-change);
}

.diff-row--added .diff-row__sign,
.diff-side--added .diff-row__sign {
    color: var(--git-diff-added-sign);
}

.diff-row--removed .diff-row__sign,
.diff-side--removed .diff-row__sign {
    color: var(--git-diff-removed-sign);
}

/* 반대편에 짝이 없는 칸(나란히 보기). 빗금 대신 더 어두운 칸으로 비어 있음을 보인다. */
.diff-side--empty {
    background-color: var(--git-diff-empty);
}

/* 바뀐 덩어리 머리(@@ -a,b +c,d @@)·"\ No newline at end of file": Fork 처럼 바탕을 칠하지 않고 흐린 글자로만 보인다
   (파랗게 칠하면 코드보다 눈에 띈다). */
.diff-row--hunk,
.diff-side--hunk {
    background-color: rgba(0, 0, 0, 0);
}

.diff-row--hunk .diff-row__part,
.diff-side--hunk .diff-row__part,
.diff-row--meta .diff-row__part,
.diff-side--meta .diff-row__part {
    color: var(--git-text-muted);
}

/* ── 긴 줄 접어 보기(diff 막대의 ≡) ─────────────────
   줄 높이가 내용만큼 늘어난다(목록은 가변 높이). 번호·부호는 첫 줄 높이에 맞춰 위에 붙인다. */
.git-diff--wrap .diff-row {
    height: auto;
    min-height: 18px;
}

.git-diff--wrap .diff-row__code {
    align-items: flex-start;
}

.git-diff--wrap .diff-row__part {
    white-space: pre-wrap;
    flex-shrink: 1;
    min-width: 0;
    -unity-text-align: upper-left;
    padding-top: 1px;
}

.git-diff--wrap .diff-row__number {
    -unity-text-align: upper-right;
    padding-top: 1px;
}

.git-diff--wrap .diff-row__sign {
    -unity-text-align: upper-center;
    padding-top: 1px;
}

.git-diff--wrap .diff-row__gutter {
    justify-content: flex-start;
    padding-top: 1px;
}

/* ── 부분 스테이징(GitKraken 식) ──────────────────────
   바뀐 줄 위에 마우스를 올리면 줄 번호 칸 왼쪽에 + 버튼이 뜬다(Stage 는 초록, Unstage 는 빨강). 고른 줄은 왼쪽에 강조 선이 생기고 버튼이 계속 보인다.
   변경 묶음 머리 줄의 오른쪽에는 "hunk 스테이지" 버튼이 늘 보인다. */
/* + 버튼만의 칸. 줄 번호를 가리지 않도록 GitKraken 처럼 번호 왼쪽에 따로 둔다. 부분 스테이징이 안 되는 diff(커밋 비교 등)에서는 코드가 숨긴다. */
.diff-row__gutter {
    width: 24px;
    min-width: 24px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--git-diff-gutter);
}

.diff-row__stage {
    width: 16px;
    height: 16px;
    padding: 0;
    margin: 0;
    border-width: 0;
    border-radius: 3px;
    font-size: 13px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    -unity-text-align: middle-center;
    color: #ffffff;
    /* 목록의 Stage 버튼 색(--git-stage-bg)은 회색빛이라 작은 칸에서는 눈에 안 띈다. GitKraken 처럼 선명한 초록·빨강으로. */
    background-color: var(--git-success);
    visibility: hidden;
}

.diff-row__stage--unstage {
    background-color: var(--git-danger);
}

.diff-row__stage:hover {
    opacity: 0.8;
}

.diff-row--added:hover .diff-row__stage,
.diff-row--removed:hover .diff-row__stage,
.diff-row:hover > .diff-side--added .diff-row__stage,
.diff-row:hover > .diff-side--removed .diff-row__stage,
.diff-row--selected .diff-row__stage {
    visibility: visible;
}

/* 고른 줄의 왼쪽 강조 선. 폭은 늘 잡아 두어(투명) 고를 때 줄이 밀리지 않는다. */
.diff-row {
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
}

.diff-row--selected {
    border-left-color: var(--git-accent);
}

/* 변경 묶음(Hunk) 보기의 머리 줄 오른쪽: GitKraken 처럼 [Discard Hunk](빨강) [Stage Hunk](초록)를 늘 보인다.
   파일 전체를 보는 통합·나란히 보기에는 코드가 숨긴다(GitKraken 도 없다). 머리 줄 아래에는 얇은 선을 그어 묶음 시작을 가른다. */
.diff-row__hunk-actions {
    position: absolute;
    right: 8px;
    top: 0;
    bottom: 0;
    flex-direction: row;
    align-items: center;
    display: none;
}

/* 막대·머리 줄 버튼과 같은 한 벌(22px·1px·--git-radius·12px). 머리 줄이 그만큼 높다(.git-diff--tall-hunks). */
.diff-row__hunk-button {
    height: 22px;
    padding: 0 10px;
    margin: 0 0 0 6px;
    font-size: 12px;
    border-width: 1px;
    border-radius: var(--git-radius);
    color: var(--git-text);
}

/* 변경 묶음(Hunk) 보기의 머리 줄은 버튼이 들어가게 높인다(GitKraken 도 머리 줄이 코드 줄보다 높다). 목록은 이때 가변 높이다. */
.git-diff--tall-hunks .diff-row--hunk {
    height: 30px;
}

.diff-row--hunk {
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

/* Stage(초록)·버리기·Unstage(빨강): Staging 칸의 Stage All·Unstage All 과 같은 테두리·옅은 바탕. 위 기본 버튼 규칙보다 세게 하려고 클래스를 겹친다. */
.git-diff__toolbar > .unity-toolbar-button.git-diff__stage-file,
.diff-row .diff-row__hunk-button--stage {
    border-color: var(--git-success);
    background-color: rgba(95, 184, 101, 0.18);
    color: var(--git-text);
}

.git-diff__toolbar > .unity-toolbar-button.git-diff__stage-file:hover,
.diff-row .diff-row__hunk-button--stage:hover {
    background-color: rgba(95, 184, 101, 0.32);
}

.git-diff__toolbar > .unity-toolbar-button.git-diff__stage-file:active,
.diff-row .diff-row__hunk-button--stage:active {
    background-color: rgba(95, 184, 101, 0.45);
}

.git-diff__toolbar > .unity-toolbar-button.git-diff__stage-file.git-diff__stage-file--unstage,
.diff-row .diff-row__hunk-button--stage.diff-row__hunk-button--unstage,
.diff-row .diff-row__hunk-button--discard {
    border-color: var(--git-danger);
    background-color: rgba(219, 92, 92, 0.18);
    color: var(--git-text);
}

.git-diff__toolbar > .unity-toolbar-button.git-diff__stage-file.git-diff__stage-file--unstage:hover,
.diff-row .diff-row__hunk-button--stage.diff-row__hunk-button--unstage:hover,
.diff-row .diff-row__hunk-button--discard:hover {
    background-color: rgba(219, 92, 92, 0.32);
}

.git-diff__toolbar > .unity-toolbar-button.git-diff__stage-file.git-diff__stage-file--unstage:active,
.diff-row .diff-row__hunk-button--stage.diff-row__hunk-button--unstage:active,
.diff-row .diff-row__hunk-button--discard:active {
    background-color: rgba(219, 92, 92, 0.45);
}

/* ── 이미지 diff (GitImageDiffView) ─────────────────── */
.git-image-diff {
    flex-grow: 1;
    flex-basis: 0;
}

.git-image-diff__toolbar {
    flex-shrink: 0;
}

.git-image-diff__slider {
    width: 220px;
    margin: 0 6px;
    align-items: center;
}

.git-image-diff__slider > .unity-base-field__label {
    min-width: 0;
    padding-right: 6px;
}

.git-image-diff__slider .unity-base-slider__input {
    min-width: 60px;
}

.git-image-diff__slider .unity-base-field__input {
    min-width: 30px;
}

.git-image-diff__zoom {
    min-width: 44px;
    margin-right: 4px;
    font-size: 11px;
    -unity-text-align: middle-right;
    color: var(--git-text-muted);
}

.git-image-diff__info {
    font-size: 11px;
    margin-right: 12px;
    padding: 0;
    white-space: nowrap;
    color: var(--git-text);
}

.git-image-diff__size-changed {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-diff-removed-sign);
}

.git-image-diff__info--changed {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-diff-hunk-text);
}

.git-image-diff__stage {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    background-color: var(--git-diff-bg);
}

.git-image-diff__viewport {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    overflow: hidden;
}

.git-image-diff__viewport--left {
    border-right-width: 1px;
    border-right-color: var(--git-diff-split-border);
}

/* 위치·크기는 코드가 배율에 맞춰 정한다. */
.git-image-diff__layer {
    position: absolute;
    left: 0;
    top: 0;
}

/* 투명 픽셀이 보이도록 깔아 두는 체커보드. 2×2 텍스처를 16px 칸으로 반복한다(칸 하나 8px). */
.git-image-diff__checker {
    background-repeat: repeat repeat;
    background-size: 16px 16px;
}

.git-image-diff__clip {
    overflow: hidden;
}

.git-image-diff__caption {
    position: absolute;
    left: 6px;
    top: 4px;
    padding: 1px 6px;
    font-size: 10px;
    border-radius: 3px;
    color: #ffffff;
    background-color: rgba(0, 0, 0, 0.55);
}

.git-image-diff__mode-controls {
    flex-direction: row;
    align-items: center;
}

/* 새로 만든·지운 이미지: 이미지 둘레 테두리와 위 가운데 상태 글자(GitHub 처럼 추가는 초록, 삭제는 빨강). */
.git-image-diff__frame {
    border-width: 1px;
}

.git-image-diff--added .git-image-diff__frame {
    border-color: var(--git-success);
}

.git-image-diff--deleted .git-image-diff__frame {
    border-color: var(--git-danger);
}

.git-image-diff__status {
    position: absolute;
    left: 0;
    right: 0;
    top: 6px;
    -unity-text-align: middle-center;
    font-size: 13px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
}

.git-image-diff--added .git-image-diff__status {
    color: var(--git-success);
}

.git-image-diff--deleted .git-image-diff__status {
    color: var(--git-danger);
}

.git-image-diff__placeholder {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 14px;
    color: var(--git-text-muted);
}

.git-image-diff__swipe-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    align-items: center;
    cursor: link;
}

.git-image-diff__swipe-line {
    width: 2px;
    flex-grow: 1;
    background-color: var(--git-accent);
}

/* 경계선 가운데의 동그라미 손잡이. 손잡이 칸(12px)보다 넓어 가운데에 맞춰 양옆으로 넘친다. */
.git-image-diff__swipe-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 30px;
    height: 30px;
    translate: -50% -50%;
    border-width: 2px;
    border-radius: 15px;
    border-color: var(--git-accent);
    background-color: #ffffff;
    align-items: center;
    justify-content: center;
    /* 손잡이 칸보다 넓어 칸 밖으로 넘친 부분에서도 같은 커서가 보이게 따로 준다. */
    cursor: link;
}

/* 아이콘은 흰색(Material Symbols "arrows_outward")이라 흰 손잡이 위에서 보이도록 어둡게 물들인다. */
.git-image-diff__swipe-knob-arrows {
    width: 20px;
    height: 20px;
    background-image: url("../Icons/SwipeArrows.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #1f1f1f;
}

/* ── 바이너리 파일 카드(이미지 밖, 또는 새로 만든·지운 이미지): Fork 처럼 상태·아이콘·확장자·크기 ─────────── */
/* ── LFS 원본 없음 안내 ───────────────────────── */
.git-diff-lfs {
    flex-grow: 1;
    align-items: center;
    padding: 24px 16px 0 16px;
}

.git-diff-lfs__message {
    margin-bottom: 12px;
    -unity-text-align: middle-center;
    color: var(--git-text-muted);
    white-space: normal;
}

.git-diff-lfs__button {
    margin-top: 4px;
    padding: 4px 12px;
}

.git-diff-binary {
    flex-grow: 1;
    align-items: center;
    padding-top: 24px;
}

.git-diff-binary__status {
    margin: 0 0 10px 0;
    font-size: 13px;
    -unity-text-align: middle-center;
}

.git-diff-binary__status--created {
    color: var(--git-success);
}

.git-diff-binary__status--deleted {
    color: var(--git-danger);
}

.git-diff-binary__status--modified {
    color: var(--git-warning);
}

.git-diff-binary__cards {
    flex-direction: row;
    align-items: center;
}

.git-diff-binary__column {
    align-items: center;
    margin: 0 10px;
}

/* 회색 카드 안 가운데에 파일 아이콘과 확장자. */
.git-diff-binary__card {
    width: 164px;
    height: 194px;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    background-color: var(--git-pressed);
}

.git-diff-binary__icon {
    width: 32px;
    height: 32px;
    margin-bottom: 8px;
}

.git-diff-binary__extension {
    margin: 0;
    font-size: 13px;
    color: var(--git-text);
    -unity-text-align: middle-center;
}

.git-diff-binary__size {
    margin: 10px 0 0 0;
    font-size: 12px;
    color: var(--git-text);
    -unity-text-align: middle-center;
}

.git-diff-binary__arrow {
    margin: 0 6px 30px 6px;
    font-size: 20px;
    color: var(--git-text-muted);
}

.git-diff-binary__error {
    margin: 16px;
    color: var(--git-danger);
    white-space: normal;
}

/* ── 이미지 속성 칸(Show properties): 아래쪽에 이전·이후 판의 크기·형식·해상도를 줄 번호와 함께. 다른 값은 diff 색으로 ─── */
.git-image-diff__properties {
    flex-direction: row;
    flex-shrink: 0;
    overflow: hidden;
    background-color: var(--git-diff-bg);
}


/* 속성 칸 위 경계. 잡기 쉽게 5px 높이로 두고 가운데 1px 선(…-line)만 보인다. */
.git-image-diff__properties-splitter {
    flex-shrink: 0;
    height: 5px;
    justify-content: center;
    cursor: resize-vertical;
    background-color: var(--git-diff-bg);
}

.git-image-diff__properties-splitter-line {
    height: 1px;
    background-color: var(--git-border);
}

.git-image-diff__properties-splitter:hover .git-image-diff__properties-splitter-line {
    height: 2px;
    background-color: var(--git-accent);
}

.git-image-diff__properties-column {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    padding-bottom: 6px;
}

.git-image-diff__properties-gutter {
    width: 1px;
    background-color: var(--git-diff-split-border);
}

.git-image-diff__properties-header {
    margin: 0;
    padding: 3px 8px;
    font-size: 11px;
    -unity-text-align: middle-center;
    color: var(--git-text-muted);
    background-color: var(--git-header-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.git-image-diff__property {
    flex-direction: row;
    height: 18px;
    align-items: center;
}

.git-image-diff__property--before {
    background-color: var(--git-diff-removed-line);
}

.git-image-diff__property--after {
    background-color: var(--git-diff-added-line);
}

.git-image-diff__property-number {
    width: 28px;
    margin: 0;
    padding: 0 6px 0 0;
    font-size: 11px;
    -unity-text-align: middle-right;
    color: var(--git-text-muted);
}

.git-image-diff__property-value {
    margin: 0;
    padding: 0;
    font-size: 12px;
    -unity-font-definition: url("../Fonts/Jetendard-Regular.ttf");
    color: var(--git-text);
}
