/* 탭 블록들: pending-changes, incoming-changes, changesets, branches, branch-explorer, commit-detail. */

.view {
    flex-grow: 1;
}

.view__toolbar-label {
    -unity-text-align: middle-left;
    font-size: 10px;
    color: var(--git-text-muted);
    margin: 0 6px;
}

.view__split {
    flex-grow: 1;
}

.view__pane {
    flex-grow: 1;
    min-height: 60px;
}

/* ── pending-changes ──────────────────────────────── */
.pending-changes__header {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 2px 6px;
}

.pending-changes__summary {
    margin-left: 4px;
    color: var(--git-text);
}

/* 아래 커밋 칸. 높이는 분할이 정하고(경계선 끌기), 남는 높이는 메시지 칸이 갖는다. */
.pending-changes__commit {
    padding: 4px 6px 6px 6px;
    border-top-width: 1px;
    border-top-color: var(--git-border);
}

.pending-changes__commit-title {
    font-size: 10px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text-muted);
    margin-bottom: 2px;
}

/* 메시지가 길어도 칸을 밀어내지 않고 안에서 스크롤한다. */
.pending-changes__message {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin: 0;
}

.pending-changes__message > .unity-text-field__input {
    flex-grow: 1;
    min-height: 54px;
    -unity-text-align: upper-left;
    white-space: normal;
}

.pending-changes__commit-title,
.pending-changes__commit .notice,
.pending-changes__commit-footer {
    flex-shrink: 0;
}

.pending-changes__commit-footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 4px;
}

.pending-changes__commit-button {
    width: 120px;
    height: 24px;
}

/* ── branches ─────────────────────────────────────── */
.branches__new-name {
    width: 180px;
    min-width: 60px;
    flex-shrink: 1;
    margin: 1px 2px;
}

.branches__hint {
    flex-shrink: 0;
    -unity-text-align: middle-center;
    font-size: 10px;
    color: var(--git-text-muted);
    padding: 2px;
}

/* ── commit-detail: 고른 커밋의 메시지와 바뀐 파일 ─── */
.commit-detail {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    border-top-width: 1px;
    border-top-color: var(--git-border);
}

.commit-detail--hidden {
    display: none;
}

.commit-detail__header {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 2px 6px;
}

.commit-detail__title {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 10px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
}

.commit-detail__close {
    width: 20px;
    height: 18px;
    padding: 0;
}

.commit-detail__close--hidden {
    display: none;
}

.commit-detail__body {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    flex-direction: row;
    padding: 0 4px 4px 4px;
}

.commit-detail__message {
    width: 40%;
    margin: 0 4px 0 0;
}

.commit-detail__message > .unity-text-field__input {
    flex-grow: 1;
    -unity-text-align: upper-left;
    white-space: normal;
}

.commit-detail__files {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

/* ── workspace: Gluon 식 워크스페이스 탐색 ─────────── */
/* 위 줄: 넉넉한 높이에 필터·토글·요약을 가운데 맞춤. 클래스를 겹쳐 테마의 .unity-toolbar(26px)보다 세게 한다. */
.workspace .workspace__toolbar {
    height: 36px;
    min-height: 36px;
    padding: 0 10px;
    align-items: center;
}

/* 필터: 사이드바 필터와 같은 상자(26px·13px 글자·16px 돋보기·"Filter" 자리표시). */
.workspace .workspace__filter {
    width: 260px;
    height: 26px;
    min-height: 26px;
    margin: 0 8px 0 0;
    padding: 0 4px;
    border-radius: 5px;
    align-items: center;
}

.workspace .workspace__filter .unity-base-text-field__input {
    font-size: 13px;
    -unity-text-align: middle-left;
}

.workspace .workspace__filter .unity-search-field-base__search-button {
    width: 16px;
    height: 16px;
    margin-left: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Show Ignored·Changes Only: 켜짐·꺼짐이 한눈에 보이는 둥근 토글. 꺼지면 테두리만·흐린 글자, 켜지면 선택색 바탕·강조 테두리. */
.workspace .workspace__toolbar .workspace__toggle {
    height: 26px;
    margin: 0 4px 0 0;
    padding: 0 12px;
    border-width: 1px;
    border-radius: 13px;
    border-color: var(--git-button-border);
    background-color: rgba(0, 0, 0, 0);
    color: var(--git-text-muted);
    font-size: 12px;
}

.workspace .workspace__toolbar .workspace__toggle:hover {
    background-color: var(--git-hover);
    color: var(--git-text);
}

.workspace .workspace__toolbar .workspace__toggle:checked {
    background-color: var(--git-selected);
    border-color: var(--git-accent);
    color: var(--git-selected-text);
}

.workspace .workspace__toolbar .view__toolbar-label {
    margin-left: 8px;
    font-size: 11px;
}

/* 표 머리(Item·Status·Size·Modified): Unity 기본(밝은 회색·큰 글자) 대신 다른 목록 머리와 같은 바탕·구분선·작은 흐린 글자. */
.workspace .workspace__list .unity-multi-column-header,
.workspace .workspace__list .unity-multi-column-header__column-container {
    background-color: var(--git-header-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.workspace .workspace__list .unity-multi-column-header__column {
    height: 26px;
    min-height: 26px;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 1px;
    border-right-color: var(--git-divider);
}

.workspace .workspace__list .unity-multi-column-header__column:hover {
    background-color: var(--git-hover);
}

.workspace .workspace__list .unity-multi-column-header .unity-label {
    padding: 0 8px;
    font-size: 11px;
    color: var(--git-text-muted);
    -unity-text-align: middle-left;
}

.workspace__table {
    flex-direction: column;
}

.workspace__list {
    flex-grow: 1;
}

.workspace__item {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    height: 20px;
}

.workspace__arrow {
    width: 14px;
    flex-shrink: 0;
    padding: 0;
    -unity-text-align: middle-center;
    color: var(--git-text-muted);
    cursor: link;
}

.workspace__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 4px;
}

.workspace__name,
.workspace__cell {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding: 0 4px 0 0;
    -unity-text-align: middle-left;
    color: var(--git-text);
}

/* 상태별 글자색: 변경 = 수정 색, 비공개(새 파일) = 추가 색, 무시 = 흐리게. 제어됨은 기본색. */
.workspace--changed {
    color: var(--git-state-modified);
}

.workspace--untracked {
    color: var(--git-state-added);
}

.workspace--ignored {
    color: var(--git-text-muted);
}

.workspace__side {
    flex-direction: column;
    padding: 8px 10px;
    background-color: var(--git-sidebar-bg);
}

.workspace__info {
    flex-shrink: 0;
}

.workspace__info-name {
    font-size: 14px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
    margin-bottom: 6px;
}

.workspace__info-row {
    flex-direction: row;
    margin-bottom: 2px;
}

.workspace__info-caption {
    width: 80px;
    flex-shrink: 0;
    color: var(--git-text-muted);
}

.workspace__info-value {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    color: var(--git-text);
}

.workspace__history-title {
    flex-shrink: 0;
    margin-top: 12px;
    padding-bottom: 4px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.workspace__history {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

/* ── branch-explorer ──────────────────────────────── */
.branch-explorer__range {
    width: 110px;
    margin: 0 2px;
}

.branch-explorer__toolbar .branch-explorer__search {
    width: 220px;
    min-width: 80px;
    flex-shrink: 1;
}

.branch-explorer__toolbar .view__toolbar-label {
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.branch-explorer__graph-pane {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    overflow: hidden;
}

.branch-explorer__overlay {
    position: absolute;
    right: 12px;
    bottom: 12px;
}

.branch-explorer__overlay-button {
    width: 30px;
    height: 30px;
    margin: 2px 0;
    padding: 0;
    align-items: center;
    justify-content: center;
}

/* 버튼 안의 선 아이콘(ActionGlyph: 집·돋보기). 색은 버튼 글자색을 따른다. */
.branch-explorer__overlay-icon {
    width: 18px;
    height: 18px;
}

/* ── branch-dialog: 브랜치 만들기 팝업(Fork 의 Create Branch 와 같은 모양) ─────────── */
/* Git 창 전체를 덮는 막. 뒤를 흐리게 하고 카드를 가운데에 둔다. 포인터를 받아 밑의 목록·버튼이 눌리지 않게 한다. */
.branch-popup {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.branch-dialog {
    width: 560px;
    max-width: 92%;
    padding: 16px 22px 14px 22px;
    border-width: 1px;
    border-radius: 8px;
    border-color: var(--git-border);
    background-color: var(--git-bg);
}

/* 오른쪽 위 닫기(×). */
.branch-dialog .branch-dialog__close {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 24px;
    height: 24px;
    margin: 0;
    padding: 0;
    font-size: 16px;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--git-text-muted);
}

.branch-dialog .branch-dialog__close:hover {
    background-color: var(--git-hover);
    color: var(--git-text);
}

.branch-dialog__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

/* 강조색 원 안의 흰 브랜치 아이콘(Fork 는 앱 아이콘 자리). */
.branch-dialog__badge {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    margin-right: 14px;
    align-items: center;
    justify-content: center;
    background-color: var(--git-accent);
    color: var(--git-accent-text);
}

.branch-dialog__badge-glyph {
    width: 26px;
    height: 26px;
}

.branch-dialog__titles {
    flex-grow: 1;
}

.branch-dialog__title {
    margin: 0;
    padding: 0;
    font-size: 15px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
}

.branch-dialog__hint {
    margin: 2px 0 0 0;
    padding: 0;
    font-size: 12px;
    color: var(--git-text-muted);
}

/* 왼쪽 이름표(오른쪽 맞춤) + 오른쪽 내용. 이름표 폭을 맞춰 입력란들이 한 줄로 선다. */
.branch-dialog__row {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
    margin-bottom: 6px;
}

.branch-dialog__label {
    width: 130px;
    flex-shrink: 0;
    margin: 0 10px 0 0;
    padding: 0;
    -unity-text-align: middle-right;
    font-size: 12px;
    color: var(--git-text);
}

.branch-dialog__start {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
}

.branch-dialog__start-label {
    margin: 0;
    padding: 0;
    font-size: 12px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.branch-dialog__glyph {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    margin-right: 6px;
    color: var(--git-text-muted);
}

/* 이름 입력란: 바깥 상자 하나만 테두리(안쪽 TextField 는 투명), 포커스면 강조색. */
.branch-dialog__field {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    height: 28px;
    padding: 0 6px 0 8px;
    border-width: 1px;
    border-radius: 5px;
    border-color: var(--git-field-border);
    background-color: var(--git-field-bg);
}

.branch-dialog__field--focused {
    border-color: var(--git-accent);
}

.branch-dialog .branch-dialog__input {
    flex-grow: 1;
    margin: 0;
}

.branch-dialog .branch-dialog__input > .unity-base-text-field__input {
    margin: 0;
    padding: 0 2px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 13px;
}

.branch-dialog__problem {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: 11px;
    color: var(--git-danger);
    white-space: normal;
}

.branch-dialog__checkout {
    margin: 0;
}

.branch-dialog__buttons {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 10px;
}

.branch-dialog .branch-dialog__create,
.branch-dialog .branch-dialog__cancel {
    height: 28px;
    min-width: 88px;
    margin: 0 0 0 8px;
    padding: 0 14px;
    font-size: 12px;
    border-width: 1px;
    border-radius: 5px;
}

/* 만들기: 강조색 채움(이름이 맞을 때만 켜진다). */
.branch-dialog .branch-dialog__create {
    background-color: var(--git-accent);
    border-color: var(--git-accent);
    color: var(--git-accent-text);
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
}

.branch-dialog .branch-dialog__create:hover:enabled {
    background-color: var(--git-accent-hover);
}

.branch-dialog .branch-dialog__create:disabled {
    opacity: 0.4;
}

.branch-dialog .branch-dialog__cancel {
    background-color: var(--git-button-bg);
    border-color: var(--git-button-border);
    color: var(--git-text);
}

.branch-dialog .branch-dialog__cancel:hover:enabled {
    background-color: var(--git-button-hover);
}

/* ── confirm-dialog: 확인 팝업(GitConfirmDialog). 막·카드·버튼은 branch-dialog 를 그대로 쓴다 ─────────── */
.confirm-dialog {
    width: 460px;
}

/* 제목 줄은 닫기(×) 자리만큼 오른쪽을 비운다. */
.confirm-dialog__title {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 24px;
    white-space: normal;
}

/* 안내 글: 아이콘 아래 제목 시작선(배지 44 + 간격 14)에 맞춰 들이고 줄바꿈을 그대로 보인다. */
.confirm-dialog__message {
    margin: 0 0 6px 58px;
    padding: 0;
    font-size: 12px;
    white-space: normal;
    color: var(--git-text);
}

/* ── confirm-dialog--alert: Fork(macOS 경고창) 모양. 좁은 둥근 카드에 아이콘·질문·안내를 위아래로 쌓고, 버튼 둘을 같은 폭으로 ─── */
.confirm-dialog.confirm-dialog--alert {
    width: 260px;
    padding: 18px 16px 16px 16px;
    border-radius: 14px;
}

.confirm-dialog--alert .branch-dialog__header {
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 8px;
}

.confirm-dialog--alert .branch-dialog__badge {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    margin: 0 0 14px 0;
}

.confirm-dialog--alert .branch-dialog__badge-glyph {
    width: 30px;
    height: 30px;
}

.confirm-dialog--alert .confirm-dialog__title {
    flex-grow: 0;
    align-self: stretch;
    margin-right: 0;
    font-size: 13px;
}

.confirm-dialog--alert .confirm-dialog__message {
    margin: 0 0 6px 0;
    color: var(--git-text);
}

.confirm-dialog--alert .branch-dialog__buttons {
    justify-content: space-between;
    margin-top: 12px;
}

.confirm-dialog--alert .branch-dialog__create,
.confirm-dialog--alert .branch-dialog__cancel {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 26px;
    margin: 0;
    border-radius: 7px;
}

.confirm-dialog--alert .branch-dialog__cancel {
    margin-right: 8px;
}

.confirm-dialog--alert .branch-dialog__create {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Regular.ttf");
}

/* ── error-dialog: 작업 실패 알림(GitErrorDialog). 막·카드·버튼은 branch-dialog·confirm-dialog 를 쓴다 ─── */
.confirm-dialog.error-dialog {
    width: 580px;
}

.branch-dialog__badge.error-dialog__badge {
    background-color: var(--git-danger);
}

.error-dialog__mark {
    margin: 0;
    padding: 0;
    font-size: 26px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: rgb(255, 255, 255);
}

/* 쉬운 설명 | git 원문 전환. 제목 시작선에 맞춰 들인 두 칸짜리 버튼. */
.error-dialog__modes {
    flex-direction: row;
    align-self: flex-start;
    margin: 0 0 10px 58px;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--git-button-border);
    overflow: hidden;
}

.branch-dialog .error-dialog__mode {
    height: 24px;
    margin: 0;
    padding: 0 12px;
    font-size: 12px;
    border-width: 0;
    border-radius: 0;
    background-color: var(--git-button-bg);
    color: var(--git-text-muted);
}

.branch-dialog .error-dialog__mode:hover {
    background-color: var(--git-button-hover);
}

.branch-dialog .error-dialog__mode--on,
.branch-dialog .error-dialog__mode--on:hover {
    background-color: var(--git-accent);
    color: var(--git-accent-text);
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
}

.error-dialog__body {
    max-height: 320px;
    margin: 0 0 6px 58px;
}

.error-dialog__cause {
    margin: 0 0 4px 0;
    padding: 0;
    font-size: 13px;
    white-space: normal;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
}

.error-dialog__heading {
    margin: 10px 0 4px 0;
    padding: 0;
    font-size: 11px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text-muted);
}

.error-dialog__step {
    margin: 0 0 3px 0;
    padding: 0;
    font-size: 12px;
    white-space: normal;
    color: var(--git-text);
}

.error-dialog__command {
    flex-direction: row;
    align-items: center;
    margin: 0 0 4px 0;
    padding: 4px 4px 4px 10px;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--git-border);
}

.error-dialog__command-text {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    font-size: 12px;
    white-space: normal;
    -unity-font-definition: url("../Fonts/Jetendard-Regular.ttf");
    color: var(--git-text);
}

.branch-dialog .error-dialog__copy {
    height: 22px;
    min-width: 56px;
    margin: 0 0 0 8px;
    padding: 0 8px;
    font-size: 11px;
    border-width: 1px;
    border-radius: 4px;
    border-color: var(--git-button-border);
    background-color: var(--git-button-bg);
    color: var(--git-text);
}

.branch-dialog .error-dialog__copy:hover {
    background-color: var(--git-button-hover);
}

.error-dialog__hint {
    margin: 10px 0 0 0;
    padding: 0;
    font-size: 11px;
    white-space: normal;
    color: var(--git-text-muted);
}

.error-dialog__raw {
    margin: 4px 0 0 0;
    padding: 8px 10px;
    font-size: 12px;
    white-space: normal;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--git-border);
    -unity-font-definition: url("../Fonts/Jetendard-Regular.ttf");
    color: var(--git-text);
}

/* 전체 복사(왼쪽 끝)와 확인(오른쪽) 사이를 벌린다. */
.error-dialog .branch-dialog__buttons .branch-dialog__cancel {
    margin-left: 0;
    margin-right: auto;
}

/* ── account-dialog: 이 저장소의 GitHub 계정 고르기(GitAccountDialog). 막·카드·버튼은 branch-dialog·confirm-dialog 를 쓴다 ─── */
.confirm-dialog.account-dialog {
    width: 540px;
}

.account-dialog__badge--failed {
    background-color: var(--git-danger);
}

.account-dialog__list {
    margin: 6px 0 4px 58px;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--git-border);
}

.account-dialog__row {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    padding: 4px 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.account-dialog__row:last-child {
    border-bottom-width: 0;
}

.account-dialog__names {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.account-dialog__login {
    margin: 0;
    padding: 0;
    font-size: 13px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
}

.account-dialog__source {
    margin: 1px 0 0 0;
    padding: 0;
    font-size: 11px;
    color: var(--git-text-muted);
}

.account-dialog__access {
    margin: 0 10px;
    padding: 0;
    font-size: 12px;
}

.account-dialog__access--yes {
    color: var(--git-success);
}

.account-dialog__access--no {
    color: var(--git-danger);
}

.account-dialog__access--unknown {
    color: var(--git-text-muted);
}

.branch-dialog .account-dialog__use {
    margin: 0;
    min-width: 110px;
}

.account-dialog__empty {
    margin: 0;
    padding: 10px;
    font-size: 12px;
    white-space: normal;
    color: var(--git-text-muted);
}

.account-dialog__status {
    margin: 4px 0 0 58px;
    font-size: 11px;
    white-space: normal;
    color: var(--git-danger);
}
