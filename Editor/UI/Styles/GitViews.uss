/* 탭 블록들: pending-changes, changesets, branches, branch-explorer, commit-detail. */

.view {
    flex-grow: 1;
}

.view__toolbar-label {
    -unity-text-align: middle-left;
    font-size: 10px;
    color: var(--git-text-muted);
    margin: 0 6px;
}

/* 비교·커밋 창(GitCompareWindow) 머리 줄: 창 바탕에 흐린 작은 글씨가 그대로 올라가 대비가 낮았다 — 다른 화면 머리 줄처럼 머리 바탕을 깔고 글씨를 올린다. */
.compare__toolbar {
    align-items: center;
    background-color: var(--git-header-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.compare__summary {
    font-size: 11px;
    color: var(--git-text);
}

.view__split {
    flex-grow: 1;
}

.view__pane {
    flex-grow: 1;
    min-height: 60px;
}

/* ── pending-changes ──────────────────────────────── */
/* 스테이징 구역 머리 줄(.staging__header)과 같은 34px·좌우 8px. 아래 목록과는 얇은 선으로 나눈다. */
.pending-changes__header {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    height: 34px;
    min-height: 34px;
    padding: 0 8px;
    background-color: var(--git-header-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.pending-changes__select-all {
    margin: 0;
}

.pending-changes__summary {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 6px;
    padding: 0;
    font-size: 12px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
}

.pending-changes__tools {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
}

/* 34px 머리 줄에서는 스테이징 맨 위와 같은 큰 전환(.view-mode-switch--large). */
.pending-changes__tools .view-mode-switch__button {
    height: 20px;
    padding: 0 10px;
}

.pending-changes__tools .view-mode-switch__label {
    font-size: 12px;
}

/* 아래 커밋 칸. 높이는 분할이 정하고(경계선 끌기), 남는 높이는 메시지 칸이 갖는다. */
.pending-changes__commit {
    padding: 4px 6px 6px 6px;
    border-top-width: 1px;
    border-top-color: var(--git-border);
}

.pending-changes__commit-title {
    font-size: 10px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text-muted);
    margin-bottom: 2px;
}

/* 메시지가 길어도 칸을 밀어내지 않고 안에서 스크롤한다. */
.pending-changes__message {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin: 0;
}

.pending-changes__message > .unity-text-field__input {
    flex-grow: 1;
    min-height: 54px;
    -unity-text-align: upper-left;
    white-space: normal;
}

.pending-changes__commit-title,
.pending-changes__commit .notice,
.pending-changes__commit-footer {
    flex-shrink: 0;
}

.pending-changes__commit-footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 4px;
}

.pending-changes__commit-button {
    width: 120px;
    height: 24px;
}

/* ── branches ─────────────────────────────────────── */
.branches__new-name {
    width: 180px;
    min-width: 60px;
    flex-shrink: 1;
    margin: 1px 2px;
}

.branches__hint {
    flex-shrink: 0;
    -unity-text-align: middle-center;
    font-size: 10px;
    color: var(--git-text-muted);
    padding: 2px;
}

/* ── commit-detail: 고른 커밋의 메시지와 바뀐 파일 ─── */
.commit-detail {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    border-top-width: 1px;
    border-top-color: var(--git-border);
}

.commit-detail--hidden {
    display: none;
}

.commit-detail__header {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 2px 6px;
}

.commit-detail__title {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 10px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
}

.commit-detail__close {
    width: 20px;
    height: 18px;
    padding: 0;
}

.commit-detail__close--hidden {
    display: none;
}

.commit-detail__body {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    flex-direction: row;
    padding: 0 4px 4px 4px;
}

.commit-detail__message {
    width: 40%;
    margin: 0 4px 0 0;
}

.commit-detail__message > .unity-text-field__input {
    flex-grow: 1;
    -unity-text-align: upper-left;
    white-space: normal;
}

.commit-detail__files {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

/* ── workspace: Gluon 식 워크스페이스 탐색 ─────────── */
/* 위 줄: 넉넉한 높이에 필터·토글·요약을 가운데 맞춤. 클래스를 겹쳐 테마의 .unity-toolbar(26px)보다 세게 한다. */
.workspace .workspace__toolbar {
    height: 36px;
    min-height: 36px;
    padding: 0 10px;
    align-items: center;
}

/* 필터: 사이드바 필터와 같은 상자(26px·13px 글자·16px 돋보기·"Filter" 자리표시). */
.workspace .workspace__filter {
    width: 260px;
    height: 26px;
    min-height: 26px;
    margin: 0 8px 0 0;
    padding: 0 4px;
    border-radius: 5px;
    align-items: center;
}

.workspace .workspace__filter .unity-base-text-field__input {
    font-size: 13px;
    -unity-text-align: middle-left;
}

.workspace .workspace__filter .unity-search-field-base__search-button {
    width: 16px;
    height: 16px;
    margin-left: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Show Ignored·Changes Only: 켜짐·꺼짐이 한눈에 보이는 둥근 토글. 꺼지면 테두리만·흐린 글자, 켜지면 선택색 바탕·강조 테두리. */
.workspace .workspace__toolbar .workspace__toggle {
    height: 26px;
    margin: 0 4px 0 0;
    padding: 0 12px;
    border-width: 1px;
    border-radius: 13px;
    border-color: var(--git-button-border);
    background-color: rgba(0, 0, 0, 0);
    color: var(--git-text-muted);
    font-size: 12px;
}

.workspace .workspace__toolbar .workspace__toggle:hover {
    background-color: var(--git-hover);
    color: var(--git-text);
}

.workspace .workspace__toolbar .workspace__toggle:checked {
    background-color: var(--git-selected);
    border-color: var(--git-accent);
    color: var(--git-selected-text);
}

.workspace .workspace__toolbar .view__toolbar-label {
    margin-left: 8px;
    font-size: 11px;
}

/* 표 머리(Item·Status·Size·Modified): Unity 기본(밝은 회색·큰 글자) 대신 다른 목록 머리와 같은 바탕·구분선·작은 흐린 글자. */
.workspace .workspace__list .unity-multi-column-header,
.workspace .workspace__list .unity-multi-column-header__column-container {
    background-color: var(--git-header-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.workspace .workspace__list .unity-multi-column-header__column {
    height: 26px;
    min-height: 26px;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 1px;
    border-right-color: var(--git-divider);
}

.workspace .workspace__list .unity-multi-column-header__column:hover {
    background-color: var(--git-hover);
}

.workspace .workspace__list .unity-multi-column-header .unity-label {
    padding: 0 8px;
    font-size: 11px;
    color: var(--git-text-muted);
    -unity-text-align: middle-left;
}

.workspace__table {
    flex-direction: column;
}

.workspace__list {
    flex-grow: 1;
}

.workspace__item {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    height: 20px;
}

.workspace__arrow {
    width: 14px;
    flex-shrink: 0;
    padding: 0;
    -unity-text-align: middle-center;
    color: var(--git-text-muted);
    cursor: link;
}

.workspace__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 4px;
}

.workspace__name,
.workspace__cell {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding: 0 4px 0 0;
    -unity-text-align: middle-left;
    color: var(--git-text);
}

/* 상태별 글자색: 변경 = 수정 색, 비공개(새 파일) = 추가 색, 무시 = 흐리게. 제어됨은 기본색. */
.workspace--changed {
    color: var(--git-state-modified);
}

.workspace--untracked {
    color: var(--git-state-added);
}

.workspace--ignored {
    color: var(--git-text-muted);
}

.workspace__side {
    flex-direction: column;
    padding: 8px 10px;
    background-color: var(--git-sidebar-bg);
}

.workspace__info {
    flex-shrink: 0;
}

.workspace__info-name {
    font-size: 14px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
    margin-bottom: 6px;
}

.workspace__info-row {
    flex-direction: row;
    margin-bottom: 2px;
}

.workspace__info-caption {
    width: 80px;
    flex-shrink: 0;
    color: var(--git-text-muted);
}

.workspace__info-value {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    color: var(--git-text);
}

.workspace__history-title {
    flex-shrink: 0;
    margin-top: 12px;
    padding-bottom: 4px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.workspace__history {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

/* ── branch-explorer ──────────────────────────────── */
/* 도구 막대: 테마의 .git-theme--* .unity-toolbar(높이 26px·여백 거의 없음)에서는 컨트롤이 위아래에 붙어 답답하다.
   diff 도구 막대처럼 32px 로 키우고 양옆 8px, 컨트롤은 모두 24px 로 맞춰 위아래 4px 씩 숨 쉴 자리를 둔다. */
.branch-explorer > .unity-toolbar.branch-explorer__toolbar {
    height: 32px;
    padding: 0 8px;
    align-items: center;
}

/* 기간 고르기: 입력란과 같은 테두리 상자. */
.branch-explorer__toolbar .branch-explorer__range {
    width: 120px;
    height: 24px;
    margin: 0;
}

.branch-explorer__toolbar .branch-explorer__range .unity-base-popup-field__input {
    height: 24px;
    margin: 0;
    padding: 0 8px;
    border-width: 1px;
    border-color: var(--git-field-border);
    border-radius: 4px;
    background-color: var(--git-field-bg);
    color: var(--git-text);
}

.branch-explorer__toolbar .branch-explorer__range .unity-base-popup-field__input:hover {
    background-color: var(--git-hover);
}

/* 커밋·줄 수 요약: 기간 상자와 떼어 놓고 한 단계 키운다. */
.branch-explorer__toolbar .view__toolbar-label {
    margin: 0 12px;
    font-size: 11px;
}

.branch-explorer__toolbar .branch-explorer__search {
    width: 220px;
    min-width: 80px;
    height: 24px;
    margin: 0;
    /* 돋보기·지우기(x)가 테두리에서 8px — 다른 검색창(필터 등)과 같은 안쪽 여백. */
    padding: 0 4px;
    flex-shrink: 1;
    align-items: center;
}

/* 돋보기: Unity 기본 그림(18px 상자용으로 작다)을 지우고 ExplorerView 가 넣은 선 아이콘(ActionGlyph Search)을 보인다. */
.branch-explorer__toolbar .branch-explorer__search .unity-search-field-base__search-button,
.branch-explorer__toolbar .branch-explorer__search .unity-search-field-base__search-button:hover {
    width: 16px;
    height: 16px;
    margin-left: 3px;
    background-image: none;
}

/* 검색 옆 "다음" 과 모양 고르기(그래프 · 커밋 목록): 검색창과 같은 높이·테두리의 상자 버튼으로 맞춘다.
   클래스를 겹쳐 적어 테마의 도구 막대 버튼 규칙(평평한 버튼·회색 칸)보다 이긴다. */
.branch-explorer__toolbar .unity-toolbar-button.branch-explorer__next,
.branch-explorer__toolbar .unity-toolbar-menu.branch-explorer__style-menu {
    height: 24px;
    margin: 0 0 0 6px;
    padding: 0 8px;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-color: var(--git-field-border);
    border-radius: 4px;
    background-color: var(--git-field-bg);
    color: var(--git-text);
}

.branch-explorer__toolbar .unity-toolbar-button.branch-explorer__next:hover:enabled,
.branch-explorer__toolbar .unity-toolbar-menu.branch-explorer__style-menu:hover {
    background-color: var(--git-hover);
}

.branch-explorer__toolbar .unity-toolbar-button.branch-explorer__next:active:enabled,
.branch-explorer__toolbar .unity-toolbar-menu.branch-explorer__style-menu:active {
    background-color: var(--git-pressed);
}

/* 검색어가 없을 때 "다음" 은 흐리게만(테두리는 남겨 자리가 흔들리지 않게). */
.branch-explorer__toolbar .unity-toolbar-button.branch-explorer__next:disabled {
    color: var(--git-text-muted);
}

.branch-explorer__style-menu .unity-toolbar-menu__arrow {
    display: none;
}

.branch-explorer__style-menu .unity-toolbar-menu__text {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.branch-explorer__style-icon {
    width: 14px;
    height: 14px;
    margin-right: 5px;
    color: var(--git-text-muted);
}

.branch-explorer__style-caret {
    width: 12px;
    height: 12px;
    margin-left: 4px;
    color: var(--git-text-muted);
}

.branch-explorer__toolbar .view__toolbar-label {
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.branch-explorer__graph-pane {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    overflow: hidden;
}

.branch-explorer__overlay {
    position: absolute;
    right: 12px;
    bottom: 12px;
}

.branch-explorer__overlay-button {
    width: 30px;
    height: 30px;
    margin: 2px 0;
    padding: 0;
    align-items: center;
    justify-content: center;
}

/* 버튼 안의 선 아이콘(ActionGlyph: 집·돋보기). 색은 버튼 글자색을 따른다. */
.branch-explorer__overlay-icon {
    width: 18px;
    height: 18px;
}

/* ── branch-dialog: 브랜치 만들기 팝업(Fork 의 Create Branch 와 같은 모양) ─────────── */
/* Git 창 전체를 덮는 막. 뒤를 흐리게 하고 카드를 가운데에 둔다. 포인터를 받아 밑의 목록·버튼이 눌리지 않게 한다. */
.branch-popup {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.branch-dialog {
    width: 560px;
    max-width: 92%;
    padding: 16px 22px 14px 22px;
    border-width: 1px;
    border-radius: 8px;
    border-color: var(--git-border);
    background-color: var(--git-bg);
}

/* 오른쪽 위 닫기(×). */
.branch-dialog .branch-dialog__close {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 24px;
    height: 24px;
    margin: 0;
    padding: 0;
    font-size: 16px;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--git-text-muted);
}

.branch-dialog .branch-dialog__close:hover {
    background-color: var(--git-hover);
    color: var(--git-text);
}

.branch-dialog__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

/* 강조색 원 안의 흰 브랜치 아이콘(Fork 는 앱 아이콘 자리). */
.branch-dialog__badge {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    margin-right: 14px;
    align-items: center;
    justify-content: center;
    background-color: var(--git-accent);
    color: var(--git-accent-text);
}

.branch-dialog__badge-glyph {
    width: 26px;
    height: 26px;
}

.branch-dialog__titles {
    flex-grow: 1;
}

.branch-dialog__title {
    margin: 0;
    padding: 0;
    font-size: 15px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
}

.branch-dialog__hint {
    margin: 2px 0 0 0;
    padding: 0;
    font-size: 12px;
    color: var(--git-text-muted);
}

/* 왼쪽 이름표(오른쪽 맞춤) + 오른쪽 내용. 이름표 폭을 맞춰 입력란들이 한 줄로 선다. */
.branch-dialog__row {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
    margin-bottom: 6px;
}

.branch-dialog__label {
    width: 130px;
    flex-shrink: 0;
    margin: 0 10px 0 0;
    padding: 0;
    -unity-text-align: middle-right;
    font-size: 12px;
    color: var(--git-text);
}

.branch-dialog__start {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
}

.branch-dialog__start-label {
    margin: 0;
    padding: 0;
    font-size: 12px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.branch-dialog__glyph {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    margin-right: 6px;
    color: var(--git-text-muted);
}

/* 이름 입력란: 바깥 상자 하나만 테두리(안쪽 TextField 는 투명), 포커스면 강조색. */
.branch-dialog__field {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    height: 28px;
    padding: 0 6px 0 8px;
    border-width: 1px;
    border-radius: 5px;
    border-color: var(--git-field-border);
    background-color: var(--git-field-bg);
}

.branch-dialog__field--focused {
    border-color: var(--git-accent);
}

.branch-dialog .branch-dialog__input {
    flex-grow: 1;
    margin: 0;
}

.branch-dialog .branch-dialog__input > .unity-base-text-field__input {
    margin: 0;
    padding: 0 2px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 13px;
}

/* 여러 개 중 하나를 고르는 팝업(GitPickDialog). */
.pick-dialog__list {
    margin-top: 10px;
    border-width: 1px;
    border-radius: 5px;
    border-color: var(--git-border);
    overflow: hidden;
}

.branch-dialog .pick-dialog__option {
    margin: 0;
    height: 30px;
    padding: 0 12px;
    border-width: 0;
    border-radius: 0;
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
    color: var(--git-text);
}

.branch-dialog .pick-dialog__option:hover {
    background-color: var(--git-hover);
}

.branch-dialog .pick-dialog__option--selected {
    background-color: var(--git-selected);
    color: var(--git-selected-text);
}

/* 글 하나를 받는 팝업(GitPromptDialog). 여러 줄이면 입력란을 키운다. */
.prompt-dialog {
    width: 440px;
}

.prompt-dialog--multiline {
    width: 520px;
}

.prompt-dialog .prompt-dialog__field {
    flex-grow: 0;
    margin-top: 10px;
}

.prompt-dialog--multiline .prompt-dialog__field {
    height: 160px;
    align-items: stretch;
    padding: 6px 8px;
}

.prompt-dialog--multiline .prompt-dialog__input > .unity-base-text-field__input {
    -unity-text-align: upper-left;
    white-space: normal;
}

.prompt-dialog__problem {
    min-height: 16px;
    margin-top: 4px;
}

.branch-dialog__problem {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: 11px;
    color: var(--git-danger);
    white-space: normal;
}

.branch-dialog__checkout {
    margin: 0;
}

.branch-dialog__buttons {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 10px;
}

.branch-dialog .branch-dialog__create,
.branch-dialog .branch-dialog__cancel {
    height: 28px;
    min-width: 88px;
    margin: 0 0 0 8px;
    padding: 0 14px;
    font-size: 12px;
    border-width: 1px;
    border-radius: 5px;
}

/* 만들기: 강조색 채움(이름이 맞을 때만 켜진다). */
/* 대화 상자의 주 버튼(만들기·확인…): 우리 버튼 규칙대로 평소엔 옅은 강조색 바탕 + 강조색 테두리, 마우스를 올리면 강조색으로 꽉 채우고 글자는 흰색. */
.branch-dialog .branch-dialog__create {
    background-color: var(--git-accent-soft);
    border-color: var(--git-accent);
    color: var(--git-text);
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
}

.branch-dialog .branch-dialog__create:hover:enabled {
    background-color: var(--git-accent);
    color: var(--git-accent-text);
    border-color: var(--git-accent);
}

.branch-dialog .branch-dialog__create:active:enabled {
    background-color: var(--git-accent-hover);
    color: var(--git-accent-text);
    border-color: var(--git-accent-hover);
}

.branch-dialog .branch-dialog__create:disabled {
    opacity: 0.4;
}

.branch-dialog .branch-dialog__cancel {
    background-color: var(--git-button-bg);
    border-color: var(--git-button-border);
    color: var(--git-text);
}

.branch-dialog .branch-dialog__cancel:hover:enabled {
    background-color: var(--git-button-hover);
}

/* ── confirm-dialog: 확인 팝업(GitConfirmDialog). 막·카드·버튼은 branch-dialog 를 그대로 쓴다 ─────────── */
.confirm-dialog {
    width: 460px;
}

/* 제목 줄은 닫기(×) 자리만큼 오른쪽을 비운다. */
.confirm-dialog__title {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 24px;
    white-space: normal;
}

/* 되돌릴 수 없는 확인(버리기·덮어쓰기)은 강조색 대신 빨강 채움. 세 갈래에서 버리기가 다른 쪽이면 무채색 버튼에 빨강 테두리. */
/* 위험한 주 버튼(삭제·버리기…): 평소엔 옅은 위험색 바탕 + 위험색 테두리, 마우스를 올리면 위험색으로 꽉 채운다. */
.branch-dialog .branch-dialog__create.confirm-dialog__button--danger {
    background-color: var(--git-danger-soft);
    border-color: var(--git-danger);
    color: var(--git-text);
}

.branch-dialog .branch-dialog__create.confirm-dialog__button--danger:hover:enabled {
    background-color: var(--git-danger-strong);
    color: var(--git-on-strong);
    border-color: var(--git-danger-strong);
}

.branch-dialog .branch-dialog__create.confirm-dialog__button--danger:active:enabled {
    background-color: var(--git-danger-strong-pressed);
    color: var(--git-on-strong);
    border-color: var(--git-danger-strong-pressed);
}

.branch-dialog .branch-dialog__cancel.confirm-dialog__button--danger-outline {
    border-color: var(--git-danger);
}

/* 안내 글: 아이콘 아래 제목 시작선(배지 44 + 간격 14)에 맞춰 들이고 줄바꿈을 그대로 보인다. */
.confirm-dialog__message {
    margin: 0 0 6px 58px;
    padding: 0;
    font-size: 12px;
    white-space: normal;
    color: var(--git-text);
}

/* ── confirm-dialog--alert: Fork(macOS 경고창) 모양. 좁은 둥근 카드에 아이콘·질문·안내를 위아래로 쌓고, 버튼 둘을 같은 폭으로 ─── */
.confirm-dialog.confirm-dialog--alert {
    width: 260px;
    padding: 18px 16px 16px 16px;
    border-radius: 14px;
}

.confirm-dialog--alert .branch-dialog__header {
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 8px;
}

.confirm-dialog--alert .branch-dialog__badge {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    margin: 0 0 14px 0;
}

.confirm-dialog--alert .branch-dialog__badge-glyph {
    width: 30px;
    height: 30px;
}

.confirm-dialog--alert .confirm-dialog__title {
    flex-grow: 0;
    align-self: stretch;
    margin-right: 0;
    font-size: 13px;
}

.confirm-dialog--alert .confirm-dialog__message {
    margin: 0 0 6px 0;
    color: var(--git-text);
}

.confirm-dialog--alert .branch-dialog__buttons {
    justify-content: space-between;
    margin-top: 12px;
}

.confirm-dialog--alert .branch-dialog__create,
.confirm-dialog--alert .branch-dialog__cancel {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 26px;
    margin: 0;
    border-radius: 7px;
}

.confirm-dialog--alert .branch-dialog__cancel {
    margin-right: 8px;
}

.confirm-dialog--alert .branch-dialog__create {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Regular.ttf");
}

/* ── error-dialog: 작업 실패 알림(GitErrorDialog). 막·카드·버튼은 branch-dialog·confirm-dialog 를 쓴다 ─── */
.confirm-dialog.error-dialog {
    width: 520px;
}

.branch-dialog__badge.error-dialog__badge {
    background-color: var(--git-danger);
}

.error-dialog__mark {
    margin: 0;
    padding: 0;
    font-size: 26px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: rgb(255, 255, 255);
}

/* 설명 | git 원문 전환. 제목 시작선에 맞춰 들인 두 칸짜리 버튼. */
.error-dialog__modes {
    flex-direction: row;
    align-self: flex-start;
    margin: 0 0 10px 58px;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--git-button-border);
    overflow: hidden;
}

.branch-dialog .error-dialog__mode {
    height: 24px;
    margin: 0;
    padding: 0 12px;
    font-size: 12px;
    border-width: 0;
    border-radius: 0;
    background-color: var(--git-button-bg);
    color: var(--git-text-muted);
}

.branch-dialog .error-dialog__mode:hover {
    background-color: var(--git-button-hover);
}

.branch-dialog .error-dialog__mode--on,
.branch-dialog .error-dialog__mode--on:hover {
    background-color: var(--git-accent);
    color: var(--git-accent-text);
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    border-color: var(--git-accent);
}

.error-dialog__body {
    max-height: 320px;
    margin: 0 0 6px 58px;
}

/* 설명·git 원문을 겹쳐 두는 칸. 높이는 높은 쪽에 맞춘다(GitErrorDialog.FitStack). */
.error-dialog__stack {
    position: relative;
}

/* 숨긴 보기는 흐름에서 빼고 같은 폭으로 겹쳐 둔다(높이를 잴 수 있게). */
.error-dialog__view--hidden {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    visibility: hidden;
}

.error-dialog__cause {
    margin: 0;
    padding: 0;
    font-size: 13px;
    white-space: normal;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
}

.error-dialog__fix {
    margin: 6px 0 0 0;
    padding: 0;
    font-size: 12px;
    white-space: normal;
    color: var(--git-text-muted);
}

.error-dialog__raw {
    margin: 4px 0 0 0;
    padding: 8px 10px;
    font-size: 12px;
    white-space: normal;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--git-border);
    -unity-font-definition: url("../Fonts/Jetendard-Regular.ttf");
    color: var(--git-text);
}

/* 전체 복사(왼쪽 끝)와 확인(오른쪽) 사이를 벌린다. */
.error-dialog .branch-dialog__buttons .branch-dialog__cancel {
    margin-left: 0;
    margin-right: auto;
}

/* ── account-dialog: 이 저장소의 GitHub 계정 고르기(GitAccountDialog). 막·카드·버튼은 branch-dialog·confirm-dialog 를 쓴다 ─── */
.confirm-dialog.account-dialog {
    width: 540px;
}

.account-dialog__badge--failed {
    background-color: var(--git-danger);
}

.account-dialog__list {
    margin: 6px 0 4px 58px;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--git-border);
}

.account-dialog__row {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    padding: 4px 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.account-dialog__row--last {
    border-bottom-width: 0;
}

.account-dialog__names {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.account-dialog__login {
    margin: 0;
    padding: 0;
    font-size: 13px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
}

.account-dialog__source {
    margin: 1px 0 0 0;
    padding: 0;
    font-size: 11px;
    color: var(--git-text-muted);
}

.account-dialog__access {
    margin: 0 10px;
    padding: 0;
    font-size: 12px;
}

.account-dialog__access--yes {
    color: var(--git-success);
}

.account-dialog__access--no {
    color: var(--git-danger);
}

.account-dialog__access--unknown {
    color: var(--git-text-muted);
}

.branch-dialog .account-dialog__use {
    margin: 0;
    min-width: 110px;
}

.account-dialog__empty {
    margin: 0;
    padding: 10px;
    font-size: 12px;
    white-space: normal;
    color: var(--git-text-muted);
}

.account-dialog__status {
    margin: 4px 0 0 58px;
    font-size: 11px;
    white-space: normal;
    color: var(--git-danger);
}

/* ── commit-history: Fork 형태 브랜치 탐색기(CommitHistoryView). 위 커밋 목록, 아래 Commit · Changes · File Tree 칸 ── */
.commit-history__list {
    flex-grow: 1;
    min-height: 120px;
}

.commit-history__detail {
    min-height: 160px;
    flex-direction: column;
    border-top-width: 1px;
    border-top-color: var(--git-border);
    background-color: var(--git-sidebar-bg);
}

.commit-history__tabs {
    flex-direction: row;
    flex-shrink: 0;
    padding: 6px 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.commit-history__tab {
    margin: 0 4px 0 0;
    padding: 3px 12px;
    border-width: 0;
    border-radius: var(--git-radius);
    background-color: rgba(0, 0, 0, 0);
    color: var(--git-text-muted);
    font-size: 13px;
    cursor: link;
}

.commit-history__tab:hover {
    background-color: var(--git-hover);
    color: var(--git-text);
}

.commit-history__tab--selected,
.commit-history__tab--selected:hover {
    background-color: var(--git-selected);
    color: var(--git-selected-text);
}

.commit-history__page {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
}

/* Commit 칸: Fork 처럼 정보 · 메시지 · 파일 목록이 한 스크롤. */
.commit-history__info {
    flex-grow: 1;
    padding: 10px 16px 10px 16px;
}

.commit-history__people {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.commit-history__person {
    min-width: 260px;
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 16px 6px 0;
}

.commit-history__person-caption {
    font-size: 11px;
    color: var(--git-text-muted);
    margin: 0 0 4px 0;
    padding: 0;
}

.commit-history__person-row {
    flex-direction: row;
    align-items: center;
}

.commit-history__avatar {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 6px;
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: scale-and-crop;
    margin-right: 10px;
}

.commit-history__avatar--small {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    margin-right: 8px;
}

.commit-history__initials {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    font-size: 12px;
    color: #ffffff;
    padding: 0;
    margin: 0;
}

.commit-history__avatar--small .commit-history__initials {
    font-size: 9px;
}

.commit-history__person-text {
    flex-shrink: 1;
    min-width: 0;
}

.commit-history__person-name-line {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.commit-history__person-name {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    font-size: 14px;
    color: var(--git-text);
    margin: 0 8px 0 0;
    padding: 0;
}

.commit-history__person-email,
.commit-history__person-date {
    font-size: 12px;
    color: var(--git-text-muted);
    margin: 0;
    padding: 0;
}

.commit-history__field {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
}

.commit-history__field-label {
    width: 72px;
    flex-shrink: 0;
    font-size: 11px;
    color: var(--git-text-muted);
    -unity-text-align: middle-right;
    margin: 0 10px 0 0;
    padding: 0;
}

.commit-history__field-value {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
}

.commit-history__field-value .graph-detail__parent-link {
    margin-right: 8px;
    -unity-font-definition: url("../Fonts/Jetendard-Regular.ttf");
}

.commit-history__sha {
    -unity-font-definition: url("../Fonts/Jetendard-Regular.ttf");
    font-size: 12px;
    color: var(--git-text);
    margin: 0;
    padding: 0;
    cursor: link;
}

.commit-history__ref {
    font-size: 11px;
    color: var(--git-graph-pill-text);
    background-color: var(--git-graph-pill-bg);
    border-radius: 4px;
    padding: 1px 6px;
    margin: 1px 6px 1px 0;
}

.commit-history__ref--current {
    background-color: var(--git-graph-pill-head);
}

.commit-history__ref--tag {
    background-color: var(--git-graph-pill-tag);
}

.commit-history__message {
    margin-top: 10px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: var(--git-border);
}

.commit-history__subject {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    font-size: 15px;
    color: var(--git-text);
    white-space: normal;
    margin: 0 0 6px 0;
    padding: 0;
}

.commit-history__body {
    -unity-font-definition: url("../Fonts/Jetendard-Regular.ttf");
    font-size: 12px;
    color: var(--git-text);
    white-space: normal;
    margin: 0;
    padding: 0;
}

/* Changes · File Tree 칸 위 한 줄: 아바타, 작성자, 해시, 날짜, 제목(Fork 와 같다). */
.commit-history__header-line {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 30px;
    padding: 0 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.commit-history__header-line > Label {
    margin: 0 10px 0 0;
    padding: 0;
    flex-shrink: 0;
    font-size: 12px;
}

.commit-history__header-author {
    color: var(--git-text);
}

.commit-history__header-hash {
    -unity-font-definition: url("../Fonts/Jetendard-Regular.ttf");
    color: var(--git-text-muted);
}

.commit-history__header-date {
    color: var(--git-text-muted);
}

.commit-history__header-line > .commit-history__header-subject {
    flex-shrink: 1;
    min-width: 0;
    color: var(--git-text);
}

/* 왼쪽 파일 칸(Changes · File Tree)과 오른쪽 diff · 내용. 왼쪽 폭은 SplitPaneClamp 가 이 한도 안에서 끈다. */
.commit-history__side {
    min-width: 180px;
    max-width: 640px;
    flex-direction: column;
    border-right-width: 1px;
    border-right-color: var(--git-border);
}

.commit-history__side .file-browser,
.commit-history__tree {
    flex-grow: 1;
}

.commit-history__viewer {
    flex-direction: column;
    min-width: 0;
    background-color: var(--git-diff-bg);
}

.commit-history__tree-row {
    flex-direction: row;
    align-items: center;
    height: 22px;
}

.commit-history__tree-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 6px;
}

.commit-history__tree-label {
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    color: var(--git-text);
}

.commit-history__content-path {
    flex-shrink: 0;
    padding: 4px 12px;
    margin: 0;
    color: var(--git-text-muted);
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.commit-history__content {
    flex-grow: 1;
}

.commit-history__line {
    flex-direction: row;
    height: 18px;
    align-items: center;
}

.commit-history__line-number {
    width: 52px;
    flex-shrink: 0;
    padding: 0 10px 0 0;
    margin: 0;
    -unity-text-align: middle-right;
    -unity-font-definition: url("../Fonts/Jetendard-Regular.ttf");
    font-size: 12px;
    color: var(--git-diff-number);
    background-color: var(--git-diff-gutter);
}

.commit-history__line-text {
    padding: 0 0 0 10px;
    margin: 0;
    white-space: pre;
    -unity-font-definition: url("../Fonts/Jetendard-Regular.ttf");
    font-size: 12px;
    color: var(--git-diff-text);
}

/* Fork 처럼 파일 칸 안쪽에 여백을 둬서 줄이 칸 가장자리에 붙지 않게 하고, 고른 줄·마우스 줄은 둥글게. */
/* 목록 자체의 margin 은 공통 규칙이 덮어쓰므로 감싸는 칸에 padding 을 준다. */
.commit-history__side {
    padding: 6px 8px 6px 8px;
}

.commit-history__side .list,
.commit-history__tree {
    background-color: rgba(0, 0, 0, 0);
}

.commit-history__side .unity-collection-view__item,
.commit-history__tree .unity-collection-view__item {
    border-radius: 5px;
}

.commit-history__tree-row {
    padding-right: 6px;
}



/* Commit 칸 바뀐 파일: Fork 처럼 [상태][아이콘][경로] 의 평평한 목록. 링크 모양 — 마우스를 올리면 경로가 파란 글씨, 손가락 커서, 뒤에 →.
   cursor 는 자식에게 물려주지 않으므로 줄 안 모든 요소에 건다. */
.commit-history__file-list {
    margin-top: 10px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: var(--git-border);
}

.commit-history__file {
    flex-direction: row;
    align-items: center;
    height: 24px;
    padding: 0 6px;
    border-radius: 5px;
}

.commit-history__file,
.commit-history__file * {
    cursor: link;
}

.commit-history__file:hover {
    background-color: var(--git-hover);
}

.commit-history__file-badge {
    flex-shrink: 0;
    margin-right: 8px;
}

.commit-history__file-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 8px;
}

.commit-history__file-path {
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    color: var(--git-text);
}

.commit-history__file:hover .commit-history__file-path {
    color: var(--git-accent-fg);
}

.commit-history__file-arrow {
    display: none;
    flex-shrink: 0;
    margin: 0 0 0 8px;
    padding: 0;
    color: var(--git-text-muted);
}

.commit-history__file:hover .commit-history__file-arrow {
    display: flex;
}

.commit-history__file-more {
    margin: 6px 0 0 6px;
    padding: 0;
    color: var(--git-accent-fg);
    cursor: link;
}
