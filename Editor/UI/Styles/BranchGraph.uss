/*
 * branch-graph: Branch Explorer 캔버스. 선·원은 C# 의 Painter2D 로 그리고,
 * 글자(머리글자·메시지·이름표·날짜)는 아래 클래스를 단 Label 을 절대 위치로 올린다.
 */

.branch-graph {
    flex-grow: 1;
    overflow: hidden;
    background-color: var(--git-graph-bg);
    /* Painter2D 로 그리는 색(BranchGraphElement.OnCustomStyleResolved). 테마 변수는 물려받기만 해서 C# 에서 바로 읽히지 않으므로 옮겨 적는다. */
    --graph-selection: var(--git-graph-selection);
    --graph-search: var(--git-graph-search);
    --graph-head: var(--git-graph-head);
    --graph-date-band: var(--git-graph-date-band);
    --graph-truncated: var(--git-graph-truncated);
    --graph-shadow: var(--git-graph-shadow);
}

.branch-graph__label {
    position: absolute;
    padding: 0;
    margin: 0;
}

.branch-graph__initials {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    -unity-text-align: middle-center;
    color: var(--git-graph-pill-text);
}

/* 작성자 아바타(둥근 모서리 반지름은 크기에 맞춰 코드가 정한다). */
.branch-graph--node-hover {
    cursor: link;
}

.branch-graph__avatar {
    position: absolute;
    -unity-background-scale-mode: scale-and-crop;
}

.branch-graph__subject {
    -unity-text-align: upper-center;
    color: var(--git-graph-subject);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.branch-graph__pill {
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 9px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-graph-pill-text);
    background-color: var(--git-graph-pill-bg);
}

.branch-graph__pill--head {
    background-color: var(--git-graph-pill-head);
}

.branch-graph__pill--tag {
    background-color: var(--git-graph-pill-tag);
}

.branch-graph__lane {
    padding: 3px 8px 4px 8px;
    border-radius: 4px;
    border-bottom-width: 2px;
    background-color: var(--git-graph-lane-bg);
    color: var(--git-graph-lane-text);
    -unity-text-align: middle-center;
}

.branch-graph__lane--anonymous {
    opacity: 0.6;
    -unity-font-style: italic;
}

.branch-graph__header {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 24px;
    background-color: var(--git-graph-header-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--git-graph-header-border);
}

/* 날짜 띠 머리의 날짜(Unity VCS Branch Explorer 처럼 또렷하게). */
/* 날짜 띠가 좁으면 두 줄로 넘어가 머리 줄 밖으로 깨지므로, 한 줄로 두고 넘치면 "2026-10…" 처럼 자른다. 양옆 4px 는 띠 경계에 붙지 않게. */
.branch-graph__date {
    height: 24px;
    padding: 0 4px;
    font-size: 12px;
    color: var(--git-graph-date);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.branch-graph__tooltip {
    padding: 6px 8px;
    background-color: var(--git-graph-tooltip-bg);
    color: var(--git-graph-tooltip-text);
    border-width: 1px;
    border-color: var(--git-border);
    border-radius: 3px;
    white-space: normal;
}

.branch-graph__empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 40%;
    -unity-text-align: middle-center;
    color: var(--git-graph-empty);
}

.branch-graph--hidden-text .branch-graph__initials,
.branch-graph--hidden-text .branch-graph__subject,
.branch-graph--hidden-text .branch-graph__pill {
    display: none;
}
