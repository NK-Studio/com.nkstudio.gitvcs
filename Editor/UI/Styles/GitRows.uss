/* 목록 한 줄 블록들: file-row(파일), commit-row(커밋), branch-row(브랜치). */

.file-row,
.commit-row,
.branch-row {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0 4px;
}

/* ── file-row ─────────────────────────────────────── */
.file-row__toggle {
    margin: 0;
}

.file-row__toggle--hidden {
    display: none;
}

.file-row__toggle-column--hidden {
    display: none;
}

/* 트리에서는 펼침 화살표가 이미 왼쪽 여백 역할을 하므로 줄 안쪽 여백을 2px 만 두고, 화살표 칸의 바깥 여백도 없앤다.
   단계 들여쓰기는 Unity 6.0 이 화살표 칸 너비로 정한다(ReusableTreeViewItem) — 화살표를 줄이지 않는 한 더 좁힐 수 없다. */
.unity-tree-view__item-content > .file-row {
    padding-left: 2px;
}

.file-row__badge {
    margin-right: 3px;
    flex-shrink: 0;
}

.file-row__badge--hidden {
    display: none;
}

.file-row--folder .file-row__path {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.asset");
}

.file-row__icon {
    width: 16px;
    height: 16px;
    min-width: 16px;
    margin-right: 3px;
    flex-shrink: 0;
}

.list .unity-tree-view__item-toggle {
    margin-left: 0;
    margin-right: 0;
}

.file-row__path {
    flex-grow: 1;
    flex-shrink: 1;
    color: var(--git-text);
}

.file-row__original {
    flex-shrink: 2;
    margin-left: 8px;
    color: var(--git-text-muted);
    font-size: 10px;
}

.file-row__note {
    padding-left: 8px;
    color: var(--git-warning);
    font-size: 10px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.asset");
}

/* 폴더 이름 옆 파일 수. */
.file-row__note--count {
    color: var(--git-text-muted);
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Regular.asset");
}

/* ── commit-row ───────────────────────────────────── */
.commit-row__hash,
.commit-row__date {
    font-size: 10px;
    color: var(--git-text-muted);
}

.commit-row__message {
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.commit-row__refs {
    flex-shrink: 0;
    max-width: 60%;
    margin-right: 6px;
    font-size: 10px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.asset");
    color: var(--git-refs);
}

.commit-row__refs--hidden {
    display: none;
}

.commit-row__subject {
    flex-shrink: 1;
    color: var(--git-text);
}

.commit-row__author {
    color: var(--git-text);
}

/* ── branch-row ───────────────────────────────────── */
.branch-row__name {
    padding-left: 12px;
    color: var(--git-text);
}

.branch-row__track,
.branch-row__date {
    font-size: 10px;
    color: var(--git-text-muted);
}

.branch-row__commit {
    color: var(--git-text);
}

.branch-row--current .branch-row__name {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.asset");
}

/* 구역 제목 줄("로컬", "원격"): 이름 칸만 굵게 보이고 나머지 칸은 숨긴다. */
.branch-row--section .branch-row__name {
    padding-left: 2px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.asset");
}

.branch-row--section .branch-row__track,
.branch-row--section .branch-row__commit,
.branch-row--section .branch-row__date {
    display: none;
}
