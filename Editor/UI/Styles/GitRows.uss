/* 목록 한 줄 블록들: file-row(파일), commit-row(커밋). */

.file-row,
.commit-row {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0 4px;
}

/* 오른쪽 끝 숫자(폴더 안 개수)·버튼이 창 끝에 붙지 않게. */
.file-row {
    padding-right: 8px;
}

/* ── file-row ─────────────────────────────────────── */
.file-row__toggle {
    margin: 0;
}

.file-row__toggle--hidden {
    display: none;
}

.file-row__toggle-column--hidden {
    display: none;
}

/* 트리에서는 펼침 화살표가 이미 왼쪽 여백 역할을 하므로 줄 안쪽 여백을 2px 만 두고, 화살표 칸의 바깥 여백도 없앤다.
   단계 들여쓰기는 Unity 6.0 이 화살표 칸 너비로 정한다(ReusableTreeViewItem) — 화살표를 줄이지 않는 한 더 좁힐 수 없다. */
.unity-tree-view__item-content > .file-row {
    padding-left: 2px;
}

.file-row__badge {
    margin-right: 3px;
    flex-shrink: 0;
}

.file-row__badge--hidden {
    display: none;
}

.file-row--folder .file-row__path {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
}

.file-row__icon {
    width: 16px;
    height: 16px;
    min-width: 16px;
    margin-right: 3px;
    flex-shrink: 0;
}

.list .unity-tree-view__item-toggle {
    margin-left: 0;
    margin-right: 0;
}

.file-row__path {
    flex-grow: 1;
    flex-shrink: 1;
    color: var(--git-text);
}

.file-row__original {
    flex-shrink: 2;
    margin-left: 8px;
    color: var(--git-text-muted);
    font-size: 10px;
}

.file-row__note {
    padding-left: 8px;
    color: var(--git-warning);
    font-size: 10px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
}

/* 폴더 이름 옆 파일 수. */
.file-row__note--count {
    color: var(--git-text-muted);
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Regular.ttf");
}

/* 줄에 마우스를 올리면 오른쪽에 나오는 버튼(GitKraken 의 Stage File·Unstage File). 쓰는 쪽이 모양 클래스(--stage·--unstage)를
   붙인 파일 줄에서만, 그 줄 위에 마우스가 있을 때만 보인다. 버튼 위에 올리면 색을 채워 강조한다. */
.file-row__action {
    display: none;
    flex-shrink: 0;
    height: 18px;
    margin: 0 2px 0 6px;
    padding: 0 8px;
    font-size: 11px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    border-width: 1px;
    border-radius: 3px;
    color: var(--git-text);
}

.file-row:hover .file-row__action--stage,
.file-row:hover .file-row__action--unstage {
    display: flex;
}

.file-row .file-row__action--stage {
    border-color: var(--git-success);
    background-color: var(--git-success-soft);
}

.file-row .file-row__action--stage:hover:enabled {
    background-color: var(--git-success-strong);
    color: var(--git-on-strong);
}

.file-row .file-row__action--stage:active:enabled {
    background-color: var(--git-success-strong-pressed);
}

.file-row .file-row__action--unstage {
    border-color: var(--git-danger);
    background-color: var(--git-danger-soft);
}

.file-row .file-row__action--unstage:hover:enabled {
    background-color: var(--git-danger-strong);
    color: var(--git-on-strong);
}

.file-row .file-row__action--unstage:active:enabled {
    background-color: var(--git-danger-strong-pressed);
}

/* git 작업 결과가 보이기 전에는 줄 버튼을 끈다(StagingLists 가 SetRowActionEnabled). 꺼진 게 보이게 흐리게. */
.file-row .file-row__action:disabled {
    opacity: 0.4;
}

/* ── commit-row ───────────────────────────────────── */
.commit-row__hash,
.commit-row__date {
    font-size: 10px;
    color: var(--git-text-muted);
}

.commit-row__message {
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.commit-row__refs {
    flex-shrink: 0;
    max-width: 60%;
    margin-right: 6px;
    font-size: 10px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-refs);
}

.commit-row__refs--hidden {
    display: none;
}

.commit-row__subject {
    flex-shrink: 1;
    color: var(--git-text);
}

.commit-row__author {
    color: var(--git-text);
}
