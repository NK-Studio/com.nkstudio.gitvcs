/* 목록 한 줄 블록들: file-row(파일), commit-row(커밋). */

.file-row,
.commit-row {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0 4px;
}

/* 오른쪽 끝 숫자(폴더 안 개수)·버튼이 창 끝에 붙지 않게. */
.file-row {
    padding-right: 8px;
}

/* ── file-row ─────────────────────────────────────── */
.file-row__toggle {
    margin: 0;
}

.file-row__toggle--hidden {
    display: none;
}

.file-row__toggle-column--hidden {
    display: none;
}

/* 트리에서는 펼침 화살표가 이미 왼쪽 여백 역할을 하므로 줄 안쪽 여백을 2px 만 두고, 화살표 칸의 바깥 여백도 없앤다.
   단계 들여쓰기는 Unity 6.0 이 화살표 칸 너비로 정한다(ReusableTreeViewItem) — 화살표를 줄이지 않는 한 더 좁힐 수 없다. */
.unity-tree-view__item-content > .file-row {
    padding-left: 2px;
}

.file-row__badge {
    margin-right: 3px;
    flex-shrink: 0;
}

.file-row__badge--hidden {
    display: none;
}

/* 폴더 이름은 글자 길이만큼만 차지해서, 뒤의 파일 수·상태별 수(✏ 1 + 1 − 1)가 이름 바로 옆에 붙는다(GitKraken 과 같다). 좁으면 이름이 줄어 … 으로 잘린다. */
.file-row--folder .file-row__path {
    flex-grow: 0;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
}

.file-row__icon {
    width: 16px;
    height: 16px;
    min-width: 16px;
    margin-right: 3px;
    flex-shrink: 0;
}

.list .unity-tree-view__item-toggle {
    margin-left: 0;
    margin-right: 0;
}

.file-row__path {
    flex-grow: 1;
    flex-shrink: 1;
    color: var(--git-text);
}

.file-row__original {
    flex-shrink: 2;
    margin-left: 8px;
    color: var(--git-text-muted);
    font-size: 10px;
}

.file-row__note {
    padding-left: 8px;
    color: var(--git-warning);
    font-size: 10px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
}

/* 접힌 폴더 이름 옆 상태별 수(GitKraken 처럼 ✏ 1 + 1 − 1). 배지 모양·색은 GitCommon.uss 의 .state-badge 를 그대로 쓴다.
   이름과 10px 띄우고, 아이콘(12px)과 수 사이 4px, 묶음 사이 10px. 수는 흰 글자(밝은 테마는 검정)·중간 굵기. */
.file-row__summary {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    height: 100%;
    padding-left: 10px;
}

/* .state-badge--glyph-* 의 좌우 1px 여백보다 세게. */
.file-row__summary > .file-row__summary-badge {
    margin: 0 4px 0 0;
}

.file-row__summary-count {
    margin: 0 10px 0 0;
    padding: 0;
    color: var(--git-text-strong);
    font-size: 12px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Medium.ttf");
    -unity-text-align: middle-left;
}

/* 줄에 마우스를 올리면 오른쪽에 나오는 버튼(GitKraken 의 Stage File·Unstage File). 쓰는 쪽이 모양 클래스(--stage·--unstage)를
   붙인 파일 줄에서만, 그 줄 위에 마우스가 있을 때만 보인다. 평소엔 옅은 바탕 + 테두리, 버튼 위에 올리면 꽉 채운다. */
.file-row__action {
    display: none;
    flex-shrink: 0;
    height: 18px;
    margin: 0 2px 0 6px;
    padding: 0 8px;
    font-size: 11px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    border-width: 1px;
    border-radius: 3px;
    color: var(--git-text);
}

.file-row:hover .file-row__action--stage,
.file-row:hover .file-row__action--unstage,
.file-row:hover .file-row__action--resolve {
    display: flex;
}

/* 충돌 파일 줄의 "해결됨으로 표시"(GitKraken 의 Mark resolved): [모두 해결됨으로 표시] 와 같은 경고색. */
.file-row .file-row__action--resolve {
    border-color: var(--git-warning);
    background-color: var(--git-warning-soft);
    color: var(--git-text);
}

.file-row .file-row__action--resolve:hover:enabled {
    background-color: var(--git-warning-strong);
    color: var(--git-on-strong);
    border-color: var(--git-warning-strong);
}

.file-row .file-row__action--resolve:active:enabled {
    background-color: var(--git-warning-strong-pressed);
    border-color: var(--git-warning-strong-pressed);
}

.file-row .file-row__action--stage {
    border-color: var(--git-success);
    background-color: var(--git-success-soft);
    color: var(--git-text);
}

.file-row .file-row__action--stage:hover:enabled {
    background-color: var(--git-success-strong);
    color: var(--git-on-strong);
    border-color: var(--git-success-strong);
}

.file-row .file-row__action--stage:active:enabled {
    background-color: var(--git-success-strong-pressed);
    border-color: var(--git-success-strong-pressed);
}

.file-row .file-row__action--unstage {
    border-color: var(--git-danger);
    background-color: var(--git-danger-soft);
    color: var(--git-text);
}

.file-row .file-row__action--unstage:hover:enabled {
    background-color: var(--git-danger-strong);
    color: var(--git-on-strong);
    border-color: var(--git-danger-strong);
}

.file-row .file-row__action--unstage:active:enabled {
    background-color: var(--git-danger-strong-pressed);
    border-color: var(--git-danger-strong-pressed);
}

/* git 작업 결과가 보이기 전에는 줄 버튼을 끈다(StagingLists 가 SetRowActionEnabled). 꺼진 게 보이게 흐리게. */
.file-row .file-row__action:disabled {
    opacity: 0.4;
}

/* ── commit-row ───────────────────────────────────── */
.commit-row__hash,
.commit-row__date {
    font-size: 10px;
    color: var(--git-text-muted);
}

.commit-row__message {
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.commit-row__refs {
    flex-shrink: 0;
    max-width: 60%;
    margin-right: 6px;
    font-size: 10px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-refs);
}

.commit-row__refs--hidden {
    display: none;
}

.commit-row__subject {
    flex-shrink: 1;
    color: var(--git-text);
}

.commit-row__author {
    color: var(--git-text);
}
