/*
 * 테마별 모양. 색은 Themes/*.tss 토큰이 정하고, 여기는 Unity 기본 컨트롤(도구 막대·목록 선택·입력란·버튼)이 그 토큰을 따르게 한다.
 * 창 루트에 GitTheme 이 붙이는 클래스: git-themed·git-theme--jetbrains(항상), git-theme--dark | git-theme--light.
 *
 * 선택자에 클래스를 여러 개 붙인 이유: Unity 기본 스킨의 목록 선택 규칙(.unity-collection-view:focus ... --selected)보다
 * 구체적이어야 덮어쓸 수 있다.
 */

/* ── 공통: 목록 줄무늬·마우스 올림·선택 ───────────────── */
/*
 * 순서와 구체성이 중요하다: 줄무늬 < 마우스 올림 < 선택. 선택 규칙은 :hover 를 붙인 판까지 두어 가장 구체적으로 만든다 —
 * 그러지 않으면 클릭한 직후(마우스가 아직 그 줄 위에 있을 때) 마우스 올림 색이 이기고, 짝수 줄은 줄무늬 색이 선택 색을 덮는다.
 */
.git-themed .unity-collection-view .unity-collection-view__item.unity-collection-view__item--alternative-background {
    background-color: var(--git-row-alt);
}

.git-themed .unity-collection-view .unity-collection-view__item:hover:enabled {
    background-color: var(--git-hover);
}

.git-themed .unity-collection-view .unity-collection-view__item.unity-collection-view__item--selected,
.git-themed .unity-collection-view .unity-collection-view__item.unity-collection-view__item--selected.unity-collection-view__item--alternative-background,
.git-themed .unity-collection-view .unity-collection-view__item.unity-collection-view__item--selected:hover:enabled,
.git-themed .unity-collection-view:focus .unity-collection-view__item.unity-collection-view__item--selected,
.git-themed .unity-collection-view:focus .unity-collection-view__item.unity-collection-view__item--selected:hover:enabled {
    background-color: var(--git-selected);
}

.git-themed .unity-collection-view .unity-collection-view__item--selected .unity-label {
    color: var(--git-selected-text);
}

/* ── 공통: 스크롤바 ─────────────────────────────── */
/*
 * Unity 기본 스크롤바(위아래 화살표·테두리 있는 바탕·각진 막대)를 둥근 막대 하나로 바꾼다. 바탕은 비우고 막대만 반투명 회색으로,
 * 마우스를 올리거나 끌 때 진해진다. 막대 색은 테마 토큰(--git-scroll-thumb…)을 따른다.
 */
.git-themed .unity-scroller {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.git-themed .unity-scroller--vertical {
    width: 10px;
    min-width: 10px;
}

.git-themed .unity-scroller--horizontal {
    height: 10px;
    min-height: 10px;
}

.git-themed .unity-scroller .unity-scroller__low-button,
.git-themed .unity-scroller .unity-scroller__high-button {
    display: none;
}

.git-themed .unity-scroller .unity-scroller__slider {
    margin: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.git-themed .unity-scroller--vertical > .unity-scroller__slider {
    margin: 2px 0;
}

.git-themed .unity-scroller--horizontal > .unity-scroller__slider {
    margin: 0 2px;
}

.git-themed .unity-scroller .unity-base-slider__tracker {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.git-themed .unity-scroller .unity-base-slider__dragger-border {
    display: none;
}

.git-themed .unity-scroller .unity-base-slider__dragger {
    border-width: 0;
    border-radius: 3px;
    background-color: var(--git-scroll-thumb);
}

.git-themed .unity-scroller--vertical .unity-base-slider__dragger {
    width: 6px;
    left: 2px;
    min-height: 24px;
}

.git-themed .unity-scroller--horizontal .unity-base-slider__dragger {
    height: 6px;
    top: 2px;
    min-width: 24px;
}

.git-themed .unity-scroller:hover .unity-base-slider__dragger {
    background-color: var(--git-scroll-thumb-hover);
}

.git-themed .unity-scroller .unity-base-slider__dragger:active {
    background-color: var(--git-scroll-thumb-active);
}

/* ── 공통: 도구 막대 ───────────────────────────────── */
.git-themed .unity-toolbar {
    background-color: var(--git-toolbar-bg);
    border-bottom-color: var(--git-border);
}

/* ── 공통: 떠 있는 UI 그림자(GitShadow) ─────────────────── */
/* 테마 변수는 물려받기만 해서 C# 이 사용자 정의 스타일로 읽을 수 없으므로, 그림자를 다는 요소에 이름을 옮겨 적는다. */
.git-shadow--large {
    --shadow-color: var(--git-shadow-large);
}

.git-shadow--small {
    --shadow-color: var(--git-shadow-small);
}

/* ── 공통: 체크박스 ─────────────────────────────── */
/* Unity 기본 체크박스는 에디터 스킨 그림이라 창 밝기를 바꾸면 흰 상자가 어두운 바탕에 떠 보인다. 테마 토큰으로 직접 그린다:
   빈 상자는 입력란 바탕·테두리, 체크·혼합(일부만 고름)은 강조색 바탕에 흰 ✓·−. 기본 스킨의 마우스 올림·포커스 규칙보다 세게 하려고 클래스를 겹쳐 적는다. */
.git-themed .unity-toggle.unity-base-field .unity-toggle__input .unity-toggle__checkmark,
.git-themed .unity-toggle.unity-base-field:hover .unity-toggle__input .unity-toggle__checkmark,
.git-themed .unity-toggle.unity-base-field:focus .unity-toggle__input .unity-toggle__checkmark,
.git-themed .unity-toggle.unity-base-field:active .unity-toggle__input .unity-toggle__checkmark,
.git-themed .unity-toggle.unity-base-field:checked .unity-toggle__input .unity-toggle__checkmark,
.git-themed .unity-toggle.unity-base-field:checked:hover .unity-toggle__input .unity-toggle__checkmark,
.git-themed .unity-toggle.unity-base-field:checked:focus .unity-toggle__input .unity-toggle__checkmark,
.git-themed .unity-toggle.unity-base-field:checked:active .unity-toggle__input .unity-toggle__checkmark {
    width: 14px;
    height: 14px;
    background-image: none;
    background-color: var(--git-field-bg);
    border-width: 1px;
    border-color: var(--git-field-border);
    border-radius: 3px;
    -unity-slice-left: 0;
    -unity-slice-top: 0;
    -unity-slice-right: 0;
    -unity-slice-bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--git-accent-text);
}

.git-themed .unity-toggle.unity-base-field:hover .unity-toggle__input .unity-toggle__checkmark {
    border-color: var(--git-accent);
}

.git-themed .unity-toggle.unity-base-field:checked .unity-toggle__input .unity-toggle__checkmark,
.git-themed .unity-toggle.unity-base-field:checked:hover .unity-toggle__input .unity-toggle__checkmark,
.git-themed .unity-toggle.unity-base-field:checked:focus .unity-toggle__input .unity-toggle__checkmark,
.git-themed .unity-toggle.unity-base-field:checked:active .unity-toggle__input .unity-toggle__checkmark {
    background-image: url("../Icons/Checkmark.png");
    background-color: var(--git-accent);
    border-color: var(--git-accent);
}

.git-themed .unity-toggle.unity-base-field .unity-toggle__input .unity-toggle__checkmark.unity-toggle__mixed-values,
.git-themed .unity-toggle.unity-base-field:hover .unity-toggle__input .unity-toggle__checkmark.unity-toggle__mixed-values,
.git-themed .unity-toggle.unity-base-field:focus .unity-toggle__input .unity-toggle__checkmark.unity-toggle__mixed-values,
.git-themed .unity-toggle.unity-base-field:active .unity-toggle__input .unity-toggle__checkmark.unity-toggle__mixed-values,
.git-themed .unity-toggle.unity-base-field:checked .unity-toggle__input .unity-toggle__checkmark.unity-toggle__mixed-values,
.git-themed .unity-toggle.unity-base-field:checked:hover .unity-toggle__input .unity-toggle__checkmark.unity-toggle__mixed-values,
.git-themed .unity-toggle.unity-base-field:checked:focus .unity-toggle__input .unity-toggle__checkmark.unity-toggle__mixed-values,
.git-themed .unity-toggle.unity-base-field:checked:active .unity-toggle__input .unity-toggle__checkmark.unity-toggle__mixed-values {
    background-image: url("../Icons/CheckMixed.png");
    background-color: var(--git-accent);
    border-color: var(--git-accent);
}

/* ── 공통: 트리 펼침 화살표 ───────────────────────────── */
/* Unity 기본 삼각형은 에디터 스킨 색이라 창 밝기를 바꾸면 바탕에 묻힌다. Material Symbols "chevron_right"(흰색 PNG)를
   글자색으로 물들이고, 펼치면 90° 돌린다. 기본 스킨의 마우스 올림·선택·포커스 규칙보다 세게 하려고 클래스를 겹쳐 적는다. */
.git-themed .unity-tree-view.unity-collection-view .unity-tree-view__item.unity-collection-view__item .unity-tree-view__item-toggle .unity-toggle__input .unity-toggle__checkmark,
.git-themed .unity-tree-view.unity-collection-view .unity-tree-view__item.unity-collection-view__item .unity-tree-view__item-toggle:hover .unity-toggle__input .unity-toggle__checkmark,
.git-themed .unity-tree-view.unity-collection-view .unity-tree-view__item.unity-collection-view__item .unity-tree-view__item-toggle:focus .unity-toggle__input .unity-toggle__checkmark,
.git-themed .unity-tree-view.unity-collection-view .unity-tree-view__item.unity-collection-view__item .unity-tree-view__item-toggle:checked .unity-toggle__input .unity-toggle__checkmark,
.git-themed .unity-tree-view.unity-collection-view .unity-tree-view__item.unity-collection-view__item .unity-tree-view__item-toggle:checked:hover .unity-toggle__input .unity-toggle__checkmark,
.git-themed .unity-tree-view.unity-collection-view .unity-tree-view__item.unity-collection-view__item .unity-tree-view__item-toggle:checked:focus .unity-toggle__input .unity-toggle__checkmark {
    width: 16px;
    height: 16px;
    background-image: url("../Icons/ChevronRight.png");
    /* 펼침 화살표도 Toggle 이라 위 체크박스 상자(바탕·테두리)를 지운다. */
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--git-text-muted);
    /* 기본 삼각형 규칙의 9-slice(13px)가 남으면 64px 그림이 점처럼 찌그러진다. */
    -unity-slice-left: 0;
    -unity-slice-top: 0;
    -unity-slice-right: 0;
    -unity-slice-bottom: 0;
    transition-property: rotate;
    transition-duration: 0.12s;
}

.git-themed .unity-tree-view.unity-collection-view .unity-tree-view__item.unity-collection-view__item .unity-tree-view__item-toggle:checked .unity-toggle__input .unity-toggle__checkmark,
.git-themed .unity-tree-view.unity-collection-view .unity-tree-view__item.unity-collection-view__item .unity-tree-view__item-toggle:checked:hover .unity-toggle__input .unity-toggle__checkmark,
.git-themed .unity-tree-view.unity-collection-view .unity-tree-view__item.unity-collection-view__item .unity-tree-view__item-toggle:checked:focus .unity-toggle__input .unity-toggle__checkmark {
    rotate: 90deg;
}

.git-themed .unity-tree-view.unity-collection-view .unity-tree-view__item.unity-collection-view__item .unity-tree-view__item-toggle:hover .unity-toggle__input .unity-toggle__checkmark {
    -unity-background-image-tint-color: var(--git-text);
}

/* ── JetBrains: 평평한 도구 막대 버튼, 둥근 선택 ─────────── */
.git-theme--jetbrains .unity-toolbar {
    height: 26px;
    padding: 0 4px;
    align-items: center;
}

.git-theme--jetbrains .unity-toolbar-button,
.git-theme--jetbrains .unity-toolbar-toggle {
    height: 22px;
    margin: 0 1px;
    padding: 0 6px;
    border-width: 0;
    border-radius: var(--git-radius);
    background-color: rgba(0, 0, 0, 0);
    color: var(--git-text);
}

.git-theme--jetbrains .unity-toolbar-button:hover,
.git-theme--jetbrains .unity-toolbar-toggle:hover {
    background-color: var(--git-hover);
}

.git-theme--jetbrains .unity-toolbar-button:active,
.git-theme--jetbrains .unity-toolbar-toggle:checked {
    background-color: var(--git-pressed);
}

/* 토글은 꺼져 있어도 테두리로 "누를 수 있는 켜고 끄는 것" 임을 보이고, 켜지면 강조색으로 채운다(라벨과 헷갈리지 않게). */
.git-theme--jetbrains .unity-toolbar-toggle {
    border-width: 1px;
    border-color: var(--git-button-border);
}

.git-theme--jetbrains .unity-toolbar-toggle:checked {
    border-color: var(--git-accent);
    background-color: var(--git-accent);
    color: var(--git-accent-fg);
}

/* 입력란·드롭다운: 얇은 테두리와 둥근 모서리. */
.git-theme--jetbrains .unity-base-text-field__input,
.git-theme--jetbrains .unity-base-popup-field__input,
.git-theme--jetbrains .unity-search-field-base {
    background-color: var(--git-field-bg);
    border-color: var(--git-field-border);
    border-width: 1px;
    border-radius: 4px;
    color: var(--git-text);
}

.git-theme--jetbrains .unity-base-text-field__input {
    padding: 4px 6px;
}

/* 비어 있을 때 보이는 안내 글자("Select…" 등)는 입력한 글자와 구분되게 흐린 색. 위 입력란 글자색 규칙보다 세게 클래스를 겹친다. */
.git-theme--jetbrains .unity-base-text-field__input.unity-base-text-field__input--placeholder {
    color: var(--git-text-muted);
}

.git-theme--jetbrains .unity-toolbar .unity-base-text-field__input,
.git-theme--jetbrains .unity-search-field-base .unity-base-text-field__input {
    padding: 0 4px;
}

.git-theme--jetbrains .unity-base-text-field__input:focus,
.git-theme--jetbrains .unity-base-text-field:focus .unity-base-text-field__input {
    border-color: var(--git-accent);
}

/* 검색창은 바깥 상자 하나만 테두리를 갖는다(안쪽 입력칸까지 칠하면 상자가 두 겹으로 보인다).
   포커스 표시도 바깥 상자에 한다 — USS 는 "안쪽에 포커스가 있는 부모" 를 고를 수 없어서 코드가 클래스를 붙인다(BranchExplorerView). */
.git-theme--jetbrains .unity-search-field-base .unity-base-text-field__input {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* 검색창 지우기(x): 바깥 테두리에서 8px(테두리 1 + 상자 안쪽 여백 4 + 3) — 왼쪽 돋보기와 같은 거리. 기본은 오른쪽 끝에 바짝 붙는다. */
.git-theme--jetbrains .unity-search-field-base .unity-search-field-base__cancel-button {
    margin-right: 3px;
}

.git-theme--jetbrains .unity-search-field-base.git-search--focused {
    border-color: var(--git-accent);
}

/* 일반 버튼(작업 막대·목록 전환처럼 자기 모양이 있는 버튼은 제외하고 이름으로 고른다). */
.git-theme--jetbrains .notice__action,
.git-theme--jetbrains .commit-detail__close,
.git-theme--jetbrains .branch-explorer__overlay-button {
    background-color: var(--git-button-bg);
    border-color: var(--git-button-border);
    border-width: 1px;
    border-radius: var(--git-radius);
    color: var(--git-text);
}

.git-theme--jetbrains .notice__action:hover,
.git-theme--jetbrains .commit-detail__close:hover,
.git-theme--jetbrains .branch-explorer__overlay-button:hover {
    background-color: var(--git-button-hover);
}

/* 커밋 버튼은 JetBrains 의 기본(파란) 버튼. */
/* 커밋 버튼(세 배치 공통): 우리 버튼 규칙대로 평소엔 강조색 테두리, 마우스를 올리면 강조색으로 채우고 글자는 흰색. */
.git-theme--jetbrains .pending-changes__commit-button {
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--git-accent);
    border-width: 1px;
    border-radius: var(--git-radius);
    color: var(--git-text);
}

.git-theme--jetbrains .pending-changes__commit-button:hover:enabled {
    background-color: var(--git-accent);
    color: var(--git-accent-text);
}

.git-theme--jetbrains .pending-changes__commit-button:active:enabled {
    background-color: var(--git-accent-hover);
    color: var(--git-accent-text);
}

.git-theme--jetbrains .pending-changes__commit-button:disabled {
    background-color: var(--git-button-bg);
    border-color: var(--git-button-border);
    color: var(--git-text-muted);
    opacity: 1;
}

/* 왼쪽 탭: 양옆 여백을 두고 둥글게 칠한 선택(IntelliJ 도구 창 목록). */
.git-theme--jetbrains .git-sidebar__tab {
    height: 26px;
    margin: 1px 6px;
    padding: 0 8px;
    border-radius: var(--git-radius);
}

.git-theme--jetbrains .git-sidebar {
    padding-top: 6px;
}

/* 머리 줄은 굵은 구분선 대신 얇은 선. */
.git-theme--jetbrains .list-header {
    height: 24px;
    min-height: 24px;
}

.git-theme--jetbrains .notice {
    border-left-width: 0;
    border-width: 1px;
    border-color: var(--git-border);
}

.git-theme--jetbrains .notice--warning {
    border-color: var(--git-warning);
}

.git-theme--jetbrains .notice--error {
    border-color: var(--git-danger);
}
