/*
 * 테마별 모양. 색은 Themes/*.uss 토큰이 정하고, 여기는 Unity 기본 컨트롤(도구 막대·목록 선택·입력란·버튼)이 그 토큰을 따르게 한다.
 * 창 루트에 GitTheme 이 붙이는 클래스: git-themed(항상), git-theme--unity | git-theme--jetbrains, git-theme--dark | git-theme--light.
 *
 * 선택자에 클래스를 여러 개 붙인 이유: Unity 기본 스킨의 목록 선택 규칙(.unity-collection-view:focus ... --selected)보다
 * 구체적이어야 덮어쓸 수 있다.
 */

/* ── 공통: 목록 줄무늬·마우스 올림·선택 ───────────────── */
/*
 * 순서와 구체성이 중요하다: 줄무늬 < 마우스 올림 < 선택. 선택 규칙은 :hover 를 붙인 판까지 두어 가장 구체적으로 만든다 —
 * 그러지 않으면 클릭한 직후(마우스가 아직 그 줄 위에 있을 때) 마우스 올림 색이 이기고, 짝수 줄은 줄무늬 색이 선택 색을 덮는다.
 */
.git-themed .unity-collection-view .unity-collection-view__item.unity-collection-view__item--alternative-background {
    background-color: var(--git-row-alt);
}

.git-themed .unity-collection-view .unity-collection-view__item:hover:enabled {
    background-color: var(--git-hover);
}

.git-themed .unity-collection-view .unity-collection-view__item.unity-collection-view__item--selected,
.git-themed .unity-collection-view .unity-collection-view__item.unity-collection-view__item--selected.unity-collection-view__item--alternative-background,
.git-themed .unity-collection-view .unity-collection-view__item.unity-collection-view__item--selected:hover:enabled,
.git-themed .unity-collection-view:focus .unity-collection-view__item.unity-collection-view__item--selected,
.git-themed .unity-collection-view:focus .unity-collection-view__item.unity-collection-view__item--selected:hover:enabled {
    background-color: var(--git-selected);
}

.git-themed .unity-collection-view .unity-collection-view__item--selected .unity-label {
    color: var(--git-selected-text);
}

/* ── 공통: 도구 막대 ───────────────────────────────── */
.git-themed .unity-toolbar {
    background-color: var(--git-toolbar-bg);
    border-bottom-color: var(--git-border);
}

/* ── JetBrains: 평평한 도구 막대 버튼, 둥근 선택 ─────────── */
.git-theme--jetbrains .unity-toolbar {
    height: 26px;
    padding: 0 4px;
    align-items: center;
}

.git-theme--jetbrains .unity-toolbar-button,
.git-theme--jetbrains .unity-toolbar-toggle {
    height: 22px;
    margin: 0 1px;
    padding: 0 6px;
    border-width: 0;
    border-radius: var(--git-radius);
    background-color: rgba(0, 0, 0, 0);
    color: var(--git-text);
}

.git-theme--jetbrains .unity-toolbar-button:hover,
.git-theme--jetbrains .unity-toolbar-toggle:hover {
    background-color: var(--git-hover);
}

.git-theme--jetbrains .unity-toolbar-button:active,
.git-theme--jetbrains .unity-toolbar-toggle:checked {
    background-color: var(--git-pressed);
}

.git-theme--jetbrains .unity-toolbar-toggle:checked {
    color: var(--git-text);
}

/* 입력란·드롭다운: 얇은 테두리와 둥근 모서리. */
.git-theme--jetbrains .unity-base-text-field__input,
.git-theme--jetbrains .unity-base-popup-field__input,
.git-theme--jetbrains .unity-search-field-base {
    background-color: var(--git-field-bg);
    border-color: var(--git-field-border);
    border-width: 1px;
    border-radius: 4px;
    color: var(--git-text);
}

.git-theme--jetbrains .unity-base-text-field__input {
    padding: 4px 6px;
}

.git-theme--jetbrains .unity-toolbar .unity-base-text-field__input,
.git-theme--jetbrains .unity-search-field-base .unity-base-text-field__input {
    padding: 0 4px;
}

.git-theme--jetbrains .unity-base-text-field__input:focus,
.git-theme--jetbrains .unity-base-text-field:focus .unity-base-text-field__input {
    border-color: var(--git-accent);
}

/* 검색창은 바깥 상자 하나만 테두리를 갖는다(안쪽 입력칸까지 칠하면 상자가 두 겹으로 보인다).
   포커스 표시도 바깥 상자에 한다 — USS 는 "안쪽에 포커스가 있는 부모" 를 고를 수 없어서 코드가 클래스를 붙인다(BranchExplorerView). */
.git-theme--jetbrains .unity-search-field-base .unity-base-text-field__input {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.git-theme--jetbrains .unity-search-field-base.git-search--focused {
    border-color: var(--git-accent);
}

/* 일반 버튼(작업 막대·목록 전환처럼 자기 모양이 있는 버튼은 제외하고 이름으로 고른다). */
.git-theme--jetbrains .notice__action,
.git-theme--jetbrains .commit-detail__close,
.git-theme--jetbrains .branch-explorer__overlay-button,
.git-theme--jetbrains .git-diff__nav {
    background-color: var(--git-button-bg);
    border-color: var(--git-button-border);
    border-width: 1px;
    border-radius: var(--git-radius);
    color: var(--git-text);
}

.git-theme--jetbrains .notice__action:hover,
.git-theme--jetbrains .commit-detail__close:hover,
.git-theme--jetbrains .branch-explorer__overlay-button:hover,
.git-theme--jetbrains .git-diff__nav:hover {
    background-color: var(--git-button-hover);
}

/* 커밋 버튼은 JetBrains 의 기본(파란) 버튼. */
.git-theme--jetbrains .pending-changes__commit-button {
    background-color: var(--git-accent);
    border-color: var(--git-accent);
    border-width: 1px;
    border-radius: var(--git-radius);
    color: var(--git-accent-text);
}

.git-theme--jetbrains .pending-changes__commit-button:hover {
    background-color: var(--git-accent-hover);
}

.git-theme--jetbrains .pending-changes__commit-button:disabled {
    background-color: var(--git-button-bg);
    border-color: var(--git-button-border);
    color: var(--git-text-muted);
    opacity: 1;
}

/* 왼쪽 탭: 양옆 여백을 두고 둥글게 칠한 선택(IntelliJ 도구 창 목록). */
.git-theme--jetbrains .git-sidebar__tab {
    height: 26px;
    margin: 1px 6px;
    padding: 0 8px;
    border-radius: var(--git-radius);
}

.git-theme--jetbrains .git-sidebar {
    padding-top: 6px;
}

/* 머리 줄은 굵은 구분선 대신 얇은 선. */
.git-theme--jetbrains .list-header {
    height: 24px;
    min-height: 24px;
}

.git-theme--jetbrains .notice {
    border-left-width: 0;
    border-width: 1px;
    border-color: var(--git-border);
}

.git-theme--jetbrains .notice--warning {
    border-color: var(--git-warning);
}

.git-theme--jetbrains .notice--error {
    border-color: var(--git-danger);
}

/* ── Unity: GitKraken 식 색 버튼 대신 Unity 에디터 기본 버튼 모양 ─────────── */
/* Stage All·Unstage All·줄 hover 의 Stage File·Unstage File·모든 변경 버리기(휴지통)는 기본 모양(GitStaging.uss·GitRows.uss)이
   GitKraken 처럼 초록·빨강 테두리라 Unity 에디터 안에서는 겉돈다. Unity 테마에서는 에디터 버튼처럼 회색 바탕·어두운 테두리·작은 모서리로 그리고,
   마우스를 올리면 한 단계 밝게, 누르면 선택 색. 기본 규칙(:hover:enabled 까지)보다 세게 하려고 클래스를 겹쳐 적는다. */
.git-theme--unity .staging .staging__button--stage,
.git-theme--unity .staging .staging__button--unstage,
.git-theme--unity .file-row .file-row__action--stage,
.git-theme--unity .file-row .file-row__action--unstage,
.git-theme--unity .graph-workspace__panel-header .graph-workspace__discard-all {
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--git-button-border);
    background-color: var(--git-button-bg);
    color: var(--git-text);
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Regular.ttf");
    opacity: 1;
}

.git-theme--unity .staging .staging__button--stage:hover:enabled,
.git-theme--unity .staging .staging__button--unstage:hover:enabled,
.git-theme--unity .file-row .file-row__action--stage:hover:enabled,
.git-theme--unity .file-row .file-row__action--unstage:hover:enabled,
.git-theme--unity .graph-workspace__panel-header .graph-workspace__discard-all:hover:enabled {
    border-color: var(--git-button-border);
    background-color: var(--git-button-hover);
    color: var(--git-text);
}

.git-theme--unity .staging .staging__button--stage:active:enabled,
.git-theme--unity .staging .staging__button--unstage:active:enabled,
.git-theme--unity .file-row .file-row__action--stage:active:enabled,
.git-theme--unity .file-row .file-row__action--unstage:active:enabled,
.git-theme--unity .graph-workspace__panel-header .graph-workspace__discard-all:active:enabled {
    background-color: var(--git-selected);
    color: var(--git-selected-text);
}

.git-theme--unity .staging .staging__button--stage:disabled,
.git-theme--unity .staging .staging__button--unstage:disabled,
.git-theme--unity .file-row .file-row__action:disabled,
.git-theme--unity .graph-workspace__panel-header .graph-workspace__discard-all:disabled {
    border-color: var(--git-button-border);
    background-color: var(--git-button-bg);
    color: var(--git-text-muted);
    opacity: 0.5;
}

/* 살짝의 기교: 무엇을 하는 버튼인지 바탕에 옅게 섞은 의미 색으로 알린다(밑줄 같은 한쪽 테두리 강조는 쓰지 않는다).
   글자는 바탕과 대비가 충분한 밝은 버튼 글자색(--git-action-text) 그대로라 읽기 쉽다. 색은 Unity 테마 토큰(Themes/Unity*.uss):
   - Stage: 회색 버튼에 차분한 초록을 섞은 바탕(--git-stage-*), Unstage·버리기: 차분한 빨강을 섞은 바탕(--git-unstage-*).
   - 마우스를 올리면 섞은 색이 한 단계 진해지고, 누르면 의미 색이 또렷한 바탕. 테두리는 Unity 버튼 테두리 그대로. */
.git-theme--unity .staging .staging__button--stage,
.git-theme--unity .file-row .file-row__action--stage {
    background-color: var(--git-stage-bg);
    color: var(--git-action-text);
}

.git-theme--unity .staging .staging__button--unstage,
.git-theme--unity .file-row .file-row__action--unstage {
    background-color: var(--git-unstage-bg);
    color: var(--git-action-text);
}

.git-theme--unity .staging .staging__button--stage:hover:enabled,
.git-theme--unity .file-row .file-row__action--stage:hover:enabled {
    background-color: var(--git-stage-hover);
    color: var(--git-action-text);
}

.git-theme--unity .staging .staging__button--unstage:hover:enabled,
.git-theme--unity .file-row .file-row__action--unstage:hover:enabled,
.git-theme--unity .graph-workspace__panel-header .graph-workspace__discard-all:hover:enabled {
    background-color: var(--git-unstage-hover);
    color: var(--git-action-text);
}

.git-theme--unity .staging .staging__button--stage:active:enabled,
.git-theme--unity .file-row .file-row__action--stage:active:enabled {
    background-color: var(--git-stage-pressed);
    color: #ffffff;
}

.git-theme--unity .staging .staging__button--unstage:active:enabled,
.git-theme--unity .file-row .file-row__action--unstage:active:enabled,
.git-theme--unity .graph-workspace__panel-header .graph-workspace__discard-all:active:enabled {
    background-color: var(--git-unstage-pressed);
    color: #ffffff;
}

/* 휴지통: 평소에는 회색 버튼에 밝은 아이콘, 마우스를 올리면 버리기 색(위 :hover). 누르면 흰 아이콘. */
.git-theme--unity .graph-workspace__discard-all .graph-workspace__discard-all-icon {
    -unity-background-image-tint-color: var(--git-action-text);
}

.git-theme--unity .graph-workspace__discard-all:active:enabled .graph-workspace__discard-all-icon {
    -unity-background-image-tint-color: #ffffff;
}

.git-theme--unity .graph-workspace__discard-all:disabled .graph-workspace__discard-all-icon {
    -unity-background-image-tint-color: var(--git-text-muted);
}
