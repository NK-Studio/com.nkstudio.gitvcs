/*
 * Fork·GitKraken 레이아웃 블록: staging(Unstaged·Staged 목록), commit-box(커밋 입력란),
 * fork-changes(Fork 탭), graph-workspace(GitKraken 탭), commit-graph(세로 커밋 그래프).
 * 색은 Themes/*.uss 의 --git-* 토큰.
 */

/* ── staging ─────────────────────────────────────── */
.staging {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

/* 경로/트리 전환을 가운데 두는 맨 위 줄(GitKraken). */
.staging__toolbar {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    height: 32px;
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.staging__header {
    height: 26px;
    min-height: 26px;
}

.staging__title {
    font-size: 11px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
}

.staging__button {
    height: 20px;
    margin: 0 0 0 6px;
    padding: 0 10px;
    font-size: 11px;
    border-radius: var(--git-radius);
}

/* ── commit-box ──────────────────────────────────── */
.commit-box {
    flex-shrink: 0;
    padding: 6px;
    border-top-width: 1px;
    border-top-color: var(--git-border);
    background-color: var(--git-header-bg);
}

.commit-box__subject {
    margin: 0 0 4px 0;
}

.commit-box__description {
    margin: 0;
}

.commit-box__description > .unity-text-field__input {
    min-height: 64px;
    max-height: 160px;
    -unity-text-align: upper-left;
    white-space: normal;
}

.commit-box__footer {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.commit-box__amend {
    margin: 0;
}

.commit-box__button {
    height: 26px;
    min-width: 96px;
    margin: 0 0 0 6px;
}

.commit-box__button--secondary {
    border-radius: var(--git-radius);
}

/* ── fork-changes ────────────────────────────────── */
.fork-changes__lists {
    border-right-width: 1px;
    border-right-color: var(--git-border);
}

.fork-changes__right {
    flex-direction: column;
}

.fork-changes__diff {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 80px;
}

.fork-changes__commit {
    flex-shrink: 0;
}

/* ── graph-workspace ─────────────────────────────── */
.graph-workspace__center {
    flex-direction: column;
}

.graph-workspace__fill {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.graph-workspace__side {
    flex-direction: column;
    border-left-width: 1px;
    border-left-color: var(--git-border);
    background-color: var(--git-sidebar-bg);
}

.graph-workspace__panel-title {
    flex-shrink: 0;
    height: 28px;
    padding: 0 10px;
    -unity-text-align: middle-left;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.graph-workspace__commit {
    flex-shrink: 0;
}

/* ── graph-detail: GitKraken 형태 커밋 상세 ──────── */
.graph-detail {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.graph-detail__header {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    height: 28px;
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.graph-detail__header-label {
    color: var(--git-text-muted);
    margin-right: 4px;
}

.graph-detail__hash {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
    cursor: link;
}

.graph-detail__hash:hover {
    color: var(--git-accent);
}

.graph-detail__body {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    padding: 8px 10px 4px 10px;
}

/* 메시지 카드: 테두리 있는 상자에 제목을 크게, 본문은 그 아래. 길면 카드 안에서 스크롤한다. */
.graph-detail__card {
    flex-shrink: 0;
    max-height: 40%;
    min-height: 56px;
    padding: 8px 10px;
    border-width: 1px;
    border-color: var(--git-border);
    border-radius: var(--git-radius);
    background-color: var(--git-field-bg);
}

.graph-detail__subject {
    font-size: 15px;
    white-space: normal;
    color: var(--git-text);
    margin-bottom: 6px;
}

.graph-detail__message {
    white-space: normal;
    color: var(--git-text);
}

.graph-detail__meta {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.graph-detail__avatar {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 18px;
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: scale-and-crop;
    margin-right: 8px;
}

.graph-detail__initials {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    -unity-text-align: middle-center;
    color: #ffffff;
    padding: 0;
    margin: 0;
}

.graph-detail__author-block {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.graph-detail__author {
    font-size: 13px;
    color: var(--git-text);
}

.graph-detail__authored {
    color: var(--git-text-muted);
}

.graph-detail__parents {
    flex-direction: row;
    flex-shrink: 0;
    align-self: flex-start;
    margin-left: 8px;
}

.graph-detail__parent-label {
    color: var(--git-text-muted);
    margin-right: 2px;
}

.graph-detail__parent-link {
    color: var(--git-text);
    cursor: link;
}

.graph-detail__parent-link:hover {
    color: var(--git-accent);
}

.graph-detail__coauthors {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 8px;
}

.graph-detail__coauthors-label {
    color: var(--git-text-muted);
    margin-right: 6px;
}

.graph-detail__coauthor-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.graph-detail__coauthor {
    flex-direction: row;
    align-items: center;
    margin-right: 8px;
}

.graph-detail__coauthor-avatar {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: scale-and-crop;
    margin-right: 4px;
}

.graph-detail__coauthor-initials {
    font-size: 9px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    -unity-text-align: middle-center;
    color: #ffffff;
    padding: 0;
    margin: 0;
}

.graph-detail__coauthor-name {
    color: var(--git-text);
}

.graph-detail__files-header {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.graph-detail__summary {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
}

.graph-detail__count {
    margin-right: 10px;
    color: var(--git-text);
}

.graph-detail__count--modified {
    color: var(--git-state-modified);
}

.graph-detail__count--added {
    color: var(--git-state-added);
}

.graph-detail__count--deleted {
    color: var(--git-state-deleted);
}

.graph-detail__count--renamed {
    color: var(--git-state-renamed);
}

.graph-detail__files {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

/* ── commit-graph ────────────────────────────────── */
.commit-graph {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.commit-graph__header-graph {
    flex-shrink: 0;
}

.commit-graph__header-refs {
    width: 170px;
    min-width: 170px;
    flex-shrink: 0;
}

.commit-graph__body {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.commit-graph__list {
    flex-grow: 1;
}

/* 선·원을 그리는 층. 목록 위 왼쪽 그래프 칸에 겹친다. */
.commit-graph__overlay {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

/* 세로 그래프의 아바타 원과, 그림이 없을 때의 머리글자(작성자 색 바탕은 그래프 층이 그린다). */
.commit-graph__avatar {
    position: absolute;
    -unity-background-scale-mode: scale-and-crop;
}

.commit-graph__initials {
    position: absolute;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: #ffffff;
}

.commit-graph-row {
    flex-direction: row;
    align-items: center;
    height: 34px;
    padding: 0 4px 0 0;
}

/* 왼쪽 브랜치/태그 칸: 이름표 하나 + "+n". 폭은 CommitGraphList.RefsColumnWidth 와 같아야 그래프 열 위치가 맞는다. */
.commit-graph-row__refs {
    width: 170px;
    min-width: 170px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 6px 0 8px;
}

.commit-graph-ref {
    flex-shrink: 1;
    height: 22px;
    margin: 0;
    padding: 0 8px;
    border-width: 1px;
    border-radius: 4px;
    font-size: 12px;
    -unity-text-align: middle-left;
    color: var(--git-text);
}

/* 현재 브랜치: 강조색 바탕(GitKraken 의 체크 표시 이름표). */
.commit-graph-ref--current {
    background-color: var(--git-accent);
    border-color: var(--git-accent);
    color: var(--git-accent-text);
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
}

/* 원격: 바탕 없이 테두리만(로컬과 구분). */
.commit-graph-ref--remote {
    color: var(--git-text-muted);
}

.commit-graph-ref--tag {
    background-color: rgba(229, 192, 123, 0.25);
    border-color: rgb(229, 192, 123);
}

.commit-graph-ref__more {
    flex-shrink: 0;
    margin-left: 4px;
    padding: 0;
    font-size: 11px;
    color: var(--git-text-muted);
}

.commit-graph-row__graph {
    flex-shrink: 0;
    height: 100%;
}

/* 메시지 앞의 가지 색 막대(색은 코드가 줄마다 칠한다). */
.commit-graph-row__message {
    flex-direction: row;
    align-items: center;
    overflow: hidden;
    height: 100%;
    padding-left: 10px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
}

.commit-graph-row .commit-row__subject {
    font-size: 13px;
}


.commit-graph-row--wip .commit-row__subject {
    color: var(--git-text-muted);
}

/* ── blame-row: 파일 Blame 창의 한 줄 ─────────────────── */
.blame-row {
    flex-direction: row;
    align-items: center;
    height: 18px;
}

/* 같은 커밋 묶음마다 배경을 번갈아 칠해 경계를 보인다. */
.blame-row--odd {
    background-color: var(--git-header-bg);
}

.blame-row--start {
    border-top-width: 1px;
    border-top-color: var(--git-border);
}

.blame-row__hash,
.blame-row__author,
.blame-row__date {
    flex-shrink: 0;
    padding: 0 6px;
    margin: 0;
    font-size: 11px;
    color: var(--git-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.blame-row__hash {
    width: 80px;
    color: var(--git-refs);
}

.blame-row__author {
    width: 120px;
}

.blame-row__date {
    width: 110px;
}

.blame-row__number {
    width: 44px;
    flex-shrink: 0;
    padding: 0 6px 0 0;
    margin: 0;
    font-size: 11px;
    -unity-text-align: middle-right;
    color: var(--git-diff-number);
    background-color: var(--git-diff-gutter);
}

.blame-row__code {
    flex-grow: 1;
    padding: 0 0 0 8px;
    margin: 0;
    white-space: pre;
    color: var(--git-diff-text);
}

.blame-row--uncommitted .blame-row__hash {
    color: var(--git-warning);
}
