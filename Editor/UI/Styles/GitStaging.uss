/*
 * Fork·GitKraken 레이아웃 블록: staging(Unstaged·Staged 목록), commit-box(커밋 입력란),
 * fork-changes(Fork 탭), graph-workspace(GitKraken 탭), commit-graph(세로 커밋 그래프).
 * 색은 Themes/*.uss 의 --git-* 토큰.
 */

/* ── staging ─────────────────────────────────────── */
.staging {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

/* 경로/트리 전환을 가운데 두는 맨 위 줄(GitKraken). */
.staging__toolbar {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    height: 32px;
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

/* Unstaged·Staged 구역 머리 줄: 버튼 위아래에 여유를 둔다(GitKraken 처럼 구역 제목이 한 단계 크다).
   테마의 .git-theme--jetbrains .list-header(24px)가 덮지 않게 클래스를 셋 겹쳐 적는다. */
.staging .list-header.staging__header {
    height: 34px;
    min-height: 34px;
    padding: 0 8px 0 8px;
}

.staging__title {
    font-size: 12px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
}

/* diff 의 버튼(GitDiff.uss 의 버튼 한 벌)과 같은 22px. */
.staging__button {
    height: 22px;
    margin: 0 0 0 6px;
    padding: 0 12px;
    font-size: 12px;
    border-radius: var(--git-radius);
}

/* Stage(초록)·Unstage(빨강): GitKraken 처럼 테두리는 테마의 성공·위험 색, 바탕은 같은 색을 옅게 깐다.
   바탕 rgba 는 테마마다 비슷한 초록·빨강이라 하나로 둔다. 기본 버튼의 :hover:enabled 보다 세게 하려고 같은 꼴로 적는다. */
.staging__button--stage,
.staging__button--unstage {
    border-width: 1px;
    color: var(--git-text);
}

.staging__button--stage {
    border-color: var(--git-success);
    background-color: rgba(95, 184, 101, 0.18);
}

.staging__button--stage:hover:enabled {
    background-color: rgba(95, 184, 101, 0.32);
}

.staging__button--stage:active:enabled {
    background-color: rgba(95, 184, 101, 0.45);
}

.staging__button--unstage {
    border-color: var(--git-danger);
    background-color: rgba(219, 92, 92, 0.18);
}

.staging__button--unstage:hover:enabled {
    background-color: rgba(219, 92, 92, 0.32);
}

.staging__button--unstage:active:enabled {
    background-color: rgba(219, 92, 92, 0.45);
}

/* Fork 모드(--fork, StagingLists.ShiftForAll): 초록·빨강 없이 무채색. 위 규칙보다 세게 하려고 같은 꼴에 클래스를 하나 더 얹는다.
   켜짐·꺼짐이 한눈에 갈리게: 켜지면 한 단계 진한 바탕(--git-pressed — 어느 테마에서나 사이드바보다 한 단계 짙다)·또렷한 테두리·굵은 글자,
   꺼지면 바탕 없이 흐린 테두리·흐린 글자. 마우스를 올리면 테두리가 밝아지고, 누르면 바탕이 한 단계 옅어진다. */
.staging--fork .staging__button--stage,
.staging--fork .staging__button--unstage {
    border-color: var(--git-button-border);
    background-color: var(--git-pressed);
    color: var(--git-text);
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
}

.staging--fork .staging__button--stage:hover:enabled,
.staging--fork .staging__button--unstage:hover:enabled {
    border-color: var(--git-text-muted);
}

.staging--fork .staging__button--stage:active:enabled,
.staging--fork .staging__button--unstage:active:enabled {
    background-color: var(--git-hover);
}

.staging--fork .staging__button--stage:disabled,
.staging--fork .staging__button--unstage:disabled {
    border-color: var(--git-divider);
    background-color: rgba(0, 0, 0, 0);
    color: var(--git-text-muted);
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Regular.ttf");
    opacity: 0.7;
}

/* ── commit-box ──────────────────────────────────── */
.commit-box {
    flex-shrink: 0;
    padding: 6px;
    border-top-width: 1px;
    border-top-color: var(--git-border);
    background-color: var(--git-header-bg);
}

.commit-box__subject {
    margin: 0 0 4px 0;
}

.commit-box__description {
    margin: 0;
}

.commit-box__description > .unity-text-field__input {
    min-height: 64px;
    max-height: 160px;
    -unity-text-align: upper-left;
    white-space: normal;
}

.commit-box__footer {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.commit-box__amend {
    margin: 0;
}

.commit-box__button {
    height: 26px;
    min-width: 96px;
    margin: 0 0 0 6px;
}

.commit-box__button--secondary {
    border-radius: var(--git-radius);
}

/* ── fork-changes ────────────────────────────────── */
.fork-changes__lists {
    border-right-width: 1px;
    border-right-color: var(--git-border);
}

.fork-changes__right {
    flex-direction: column;
}

.fork-changes__diff {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 80px;
}

.fork-changes__commit {
    flex-shrink: 0;
}

/* ── graph-workspace ─────────────────────────────── */
.graph-workspace__center {
    flex-direction: column;
}

.graph-workspace__fill {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.graph-workspace__side {
    flex-direction: column;
    border-left-width: 1px;
    border-left-color: var(--git-border);
    background-color: var(--git-sidebar-bg);
}

/* 작업 패널 머리 줄: 왼쪽 휴지통(모든 변경 버리기) + 제목. */
.graph-workspace__panel-header {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    height: 32px;
    padding: 0 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

/* 제목은 머리 줄 전체의 가운데에 둔다(GitKraken 과 같다). 왼쪽 휴지통(24px)만큼 오른쪽도 비워서 남은 칸이 아니라 줄 가운데에 맞춘다. */
.graph-workspace__panel-title {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 24px 0 0;
    padding: 0 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-center;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
}

/* 휴지통: 되돌릴 수 없는 작업이라 위험 색 테두리로 구분한다(GitKraken 과 같다). 그림은 흰 Material "delete" 를 글자색으로 물들인다. */
.graph-workspace__discard-all {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    margin: 0;
    padding: 0;
    justify-content: center;
    align-items: center;
    border-width: 1px;
    border-radius: var(--git-radius);
    border-color: var(--git-danger);
    background-color: rgba(219, 92, 92, 0.18);
}

.graph-workspace__discard-all:hover {
    background-color: rgba(219, 92, 92, 0.32);
}

.graph-workspace__discard-all:active {
    background-color: rgba(219, 92, 92, 0.45);
}

.graph-workspace__discard-all:disabled {
    border-color: var(--git-border);
    opacity: 0.5;
}

.graph-workspace__discard-all-icon {
    width: 16px;
    height: 16px;
    background-image: url("../Icons/Delete.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--git-text);
}

.graph-workspace__commit {
    flex-shrink: 0;
}

/* ── graph-detail: GitKraken 형태 커밋 상세 ──────── */
.graph-detail {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.graph-detail__header {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    height: 28px;
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.graph-detail__header-label {
    color: var(--git-text-muted);
    margin-right: 4px;
}

.graph-detail__hash {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
    cursor: link;
}

.graph-detail__hash:hover {
    color: var(--git-accent-fg);
}

.graph-detail__body {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    padding: 8px 10px 4px 10px;
}

/* 메시지 카드: 테두리 있는 상자에 제목을 크게, 본문은 그 아래. 길면 카드 안에서 스크롤한다. */
.graph-detail__card {
    flex-shrink: 0;
    max-height: 40%;
    min-height: 56px;
    padding: 8px 10px;
    border-width: 1px;
    border-color: var(--git-border);
    border-radius: var(--git-radius);
    background-color: var(--git-field-bg);
}

.graph-detail__subject {
    font-size: 15px;
    white-space: normal;
    color: var(--git-text);
    margin-bottom: 6px;
}

.graph-detail__message {
    white-space: normal;
    color: var(--git-text);
}

.graph-detail__meta {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.graph-detail__avatar {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 18px;
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: scale-and-crop;
    margin-right: 8px;
}

.graph-detail__initials {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    -unity-text-align: middle-center;
    color: #ffffff;
    padding: 0;
    margin: 0;
}

.graph-detail__author-block {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.graph-detail__author {
    font-size: 13px;
    color: var(--git-text);
}

.graph-detail__authored {
    color: var(--git-text-muted);
}

.graph-detail__parents {
    flex-direction: row;
    flex-shrink: 0;
    align-self: flex-start;
    margin-left: 8px;
}

.graph-detail__parent-label {
    color: var(--git-text-muted);
    margin-right: 2px;
}

.graph-detail__parent-link {
    color: var(--git-text);
    cursor: link;
}

.graph-detail__parent-link:hover {
    color: var(--git-accent-fg);
}

.graph-detail__coauthors {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 8px;
}

.graph-detail__coauthors-label {
    color: var(--git-text-muted);
    margin-right: 6px;
}

.graph-detail__coauthor-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.graph-detail__coauthor {
    flex-direction: row;
    align-items: center;
    margin-right: 8px;
}

.graph-detail__coauthor-avatar {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: scale-and-crop;
    margin-right: 4px;
}

.graph-detail__coauthor-initials {
    font-size: 9px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    -unity-text-align: middle-center;
    color: #ffffff;
    padding: 0;
    margin: 0;
}

.graph-detail__coauthor-name {
    color: var(--git-text);
}

.graph-detail__files-header {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.graph-detail__summary {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
}

.graph-detail__count {
    margin-right: 10px;
    color: var(--git-text);
}

.graph-detail__count--modified {
    color: var(--git-state-modified);
}

.graph-detail__count--added {
    color: var(--git-state-added);
}

.graph-detail__count--deleted {
    color: var(--git-state-deleted);
}

.graph-detail__count--renamed {
    color: var(--git-state-renamed);
}

.graph-detail__files {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

/* ── commit-graph ────────────────────────────────── */
.commit-graph {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

/* 머리 줄 열 경계를 줄의 칸 경계에 맞춘다(목록 줄은 왼쪽 여백이 없다). */
.commit-graph__header {
    padding-left: 0;
}

/* 칸 폭·순서는 코드가 넣는다(경계를 끌어 폭, 머리를 끌어 순서를 바꾼다). */
.commit-graph__header-cell {
    align-self: stretch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* ── column-reorder: 머리 칸을 끌어 순서 바꾸기 ─────────── */
.column-reorder__cell {
    cursor: pan;
}

.column-reorder__cell--source {
    opacity: 0.35;
}

/* 끄는 동안에는 어디 위에 있든 손 모양 커서. */
.column-reorder--dragging,
.column-reorder--dragging * {
    cursor: pan;
}

/* 포인터를 따라다니는 칸 이름. left·top·width·height 는 ColumnReorderer 가 넣는다. */
.column-reorder__ghost {
    position: absolute;
    background-color: var(--git-header-bg);
    border-width: 1px;
    border-color: var(--git-border);
    opacity: 0.85;
}

/* 놓일 자리 세로선. left·top 은 ColumnReorderer 가 넣는다. */
.column-reorder__indicator {
    position: absolute;
    bottom: 0;
    width: 2px;
    background-color: var(--git-accent);
}

/* 열 경계 손잡이: 왼쪽 칸 끝 8px 를 덮고, 경계에 세로선을 둔다. 자리를 차지하지 않게 왼쪽 여백을 당긴다. */
.column-resizer {
    flex-shrink: 0;
    align-self: stretch;
    align-items: flex-end;
    width: 8px;
    margin-left: -8px;
    cursor: resize-horizontal;
}

.column-resizer__line {
    flex-grow: 1;
    width: 1px;
    background-color: var(--git-border);
}

.column-resizer:hover > .column-resizer__line,
.column-resizer--dragging > .column-resizer__line {
    width: 2px;
    background-color: var(--git-accent);
}

.commit-graph__body {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    overflow: hidden;
}

/* GitKraken 의 브랜치 만들기: 그 커밋 줄 브랜치/태그 칸 안에 띄우는 이름 입력란(커밋까지는 가지 색 선으로 잇는다).
   top·left·width·height 는 CommitGraphList 가 넣는다. */
.commit-graph__branch-input {
    position: absolute;
    left: 6px;
    margin: 0;
}

.commit-graph .commit-graph__branch-input > .unity-base-text-field__input {
    font-size: 12px;
    padding-left: 8px;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--git-accent);
    background-color: var(--git-field-bg);
}

.commit-graph__list {
    flex-grow: 1;
}

/* 선·원 층이 Painter2D 로 그릴 때 읽는 테마 색(CommitGraphList.OnCustomStyleResolved).
   테마 변수는 물려받기만 해서 C# 에서 바로 읽히지 않으므로 이 요소의 사용자 정의 속성으로 옮겨 적는다. */
.commit-graph__overlay {
    --graph-head: var(--git-graph-head);
    --graph-outline: var(--git-list-bg);
    --graph-muted: var(--git-text-muted);
}

/* 선·원을 그리는 층. 목록 위 왼쪽 그래프 칸에 겹친다. */
.commit-graph__overlay {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

/* 세로 그래프의 아바타 원과, 그림이 없을 때의 머리글자(작성자 색 바탕은 그래프 층이 그린다). */
.commit-graph__avatar {
    position: absolute;
    -unity-background-scale-mode: scale-and-crop;
}

.commit-graph__initials {
    position: absolute;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: #ffffff;
}

.commit-graph-row {
    flex-direction: row;
    align-items: center;
    height: 34px;
    padding: 0 4px 0 0;
}

/* 왼쪽 브랜치/태그 칸: 이름표 하나 + "+n". 폭은 CommitGraphList 가 넣는다(선·원 층의 그래프 열 위치와 같아야 한다). */
.commit-graph-row__refs {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 6px 0 8px;
    overflow: hidden;
}

/* 이름표: [체크 표시][이름]. 글자 속성은 안쪽 이름 Label 이 물려받는다. */
.commit-graph-ref {
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    min-width: 0;
    height: 22px;
    margin: 0;
    padding: 0 8px;
    border-width: 1px;
    border-radius: 4px;
    overflow: hidden;
    font-size: 12px;
    -unity-text-align: middle-left;
    color: var(--git-text);
}

/* 두 번 누르면 그 브랜치로 전환하므로 누를 수 있는 것처럼 손가락 커서(안쪽 요소는 포인터를 받지 않는다 — CreateRefPill). */
.commit-graph-ref,
.commit-graph-ref__more {
    cursor: link;
}

.commit-graph-ref__name {
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
}

/* 현재 브랜치: 강조색 바탕(GitKraken 의 체크 표시 이름표). */
.commit-graph-ref--current {
    background-color: var(--git-accent);
    border-color: var(--git-accent);
    color: var(--git-accent-text);
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    padding-left: 3px;
}

/* 현재 브랜치 이름 앞의 체크 표시(Painter2D). 색은 이름표 글자색을 따른다. */
.commit-graph-ref__check {
    display: none;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
}

.commit-graph-ref--current > .commit-graph-ref__check {
    display: flex;
}

/* 로컬 브랜치 이름 뒤의 노트북 표시. 흰 그림(Material Symbols "laptop_mac")을 이름표 글자색으로 물들인다. */
.commit-graph-ref__local {
    display: none;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-left: 5px;
    background-image: url("../Icons/LaptopMac.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--git-text);
}

.commit-graph-ref--current > .commit-graph-ref__local,
.commit-graph-ref--local > .commit-graph-ref__local {
    display: flex;
}

.commit-graph-ref--current > .commit-graph-ref__local {
    -unity-background-image-tint-color: var(--git-accent-text);
}

/* 원격·태그 이름 뒤의 종류 아이콘(구름·태그). 노트북과 같은 자리·크기이고 색은 이름표 글자색을 따른다. */
.commit-graph-ref__remote-icon,
.commit-graph-ref__tag-icon {
    display: none;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-left: 5px;
}

.commit-graph-ref--remote > .commit-graph-ref__remote-icon,
.commit-graph-ref--tag > .commit-graph-ref__tag-icon {
    display: flex;
}

/* 원격: 바탕 없이 테두리만(로컬과 구분). */
.commit-graph-ref--remote {
    color: var(--git-text-muted);
}

.commit-graph-ref--tag {
    background-color: rgba(229, 192, 123, 0.25);
    border-color: rgb(229, 192, 123);
}

/* "+n": 이름표와 같은 높이의 옅은 가지 색 상자(바탕은 CommitGraphList 가 넣는다). 앞 틈(6)에는 커밋까지 잇는 선이 지나간다(GitKraken 과 같다).
   여백·간격을 바꾸면 CommitGraphList.MoreGap·MorePadding 도 같이 맞춘다. */
.commit-graph-ref__more {
    flex-shrink: 0;
    height: 22px;
    margin: 0 0 0 6px;
    padding: 0 5px;
    border-radius: 4px;
    font-size: 12px;
    -unity-text-align: middle-center;
    color: var(--git-text);
}

.commit-graph-ref__more--hidden {
    display: none;
}

/* ── 좁은 브랜치/태그 칸(GitKraken 과 같다) ──────────
   이름이 말줄임으로 줄다가 첫 글자와 "…" 만 남으면 이름을 빼고 아이콘만 남긴다(CommitGraphList.FitRefs 가 줄마다 고른다).
   더 좁으면 이름표 모양은 그대로이고 칸 경계(.commit-graph-row__refs 의 overflow: hidden)가 오른쪽부터 가린다.
   여백·아이콘 폭을 바꾸면 CommitGraphList 의 폭 상수도 같이 맞춘다. */
.commit-graph-ref--no-name {
    flex-shrink: 0;
}

.commit-graph-ref--no-name > .commit-graph-ref__name {
    display: none;
}

/* 이름이 없으면 맨 앞 아이콘이 되므로 이름과의 간격을 뺀다(현재 브랜치는 체크 뒤라 그대로 둔다). */
.commit-graph-ref--no-name > .commit-graph-ref__local,
.commit-graph-ref--no-name > .commit-graph-ref__remote-icon,
.commit-graph-ref--no-name > .commit-graph-ref__tag-icon {
    margin-left: 0;
}

.commit-graph-ref--current.commit-graph-ref--no-name > .commit-graph-ref__local {
    margin-left: 5px;
}

/* 맨 왼쪽 칸의 내용 들여쓰기(GitKraken 과 같다): 이름표는 12px, 메시지는 머리 글자와 같은 20px. 그래프는 가지 배치가 이미 띄운다.
   이름표 칸 여백을 바꾸면 CommitGraphList.RefsCellPadding 도 같이 맞춘다. 아래 --refs-centered 가 더 뒤라 좁을 때는 그쪽이 이긴다. */
.commit-graph--refs-first .commit-graph-row__refs {
    padding-left: 12px;
}

.commit-graph--message-first .commit-graph-row__message {
    padding-left: 20px;
}

/* ── 맨 왼쪽 브랜치/태그 칸이 머리가 아이콘이 될 만큼 좁을 때(CommitGraphList 가 --refs-centered 를 붙인다) ──
   이름표를 상태 아이콘 하나(현재 = 체크, 로컬 = 노트북, 원격 = 구름, 태그 = 태그)로 줄인다. "+n" 은 숨기고 마우스를 올리면 펼치는 목록으로 본다.
   머리 아이콘·이름표는 왼쪽 들여쓰기 자리(20px·12px)에서 움직이지 않는다. 대신 칸을 끝까지 줄인 폭이
   들여쓰기 + 아이콘 + 같은 여백(20+14+20 = 12+30+12 = 54, CommitGraphList.MinRefsFirstWidth)이라 그때 가운데 맞춘 것처럼 보인다.
   위 --no-name 규칙보다 뒤에 둬서 이긴다. */
.commit-graph--refs-centered .commit-graph-row__refs {
    padding-right: 0;
}

.commit-graph--refs-centered .commit-graph-ref {
    flex-shrink: 0;
    width: 30px;
    padding: 0;
    justify-content: center;
}

.commit-graph--refs-centered .commit-graph-ref__name,
.commit-graph--refs-centered .commit-graph-ref__more,
.commit-graph--refs-centered .commit-graph-ref--current > .commit-graph-ref__local {
    display: none;
}

.commit-graph--refs-centered .commit-graph-ref > .commit-graph-ref__local,
.commit-graph--refs-centered .commit-graph-ref > .commit-graph-ref__remote-icon,
.commit-graph--refs-centered .commit-graph-ref > .commit-graph-ref__tag-icon {
    margin-left: 0;
}

/* ── 이름표 칸에 마우스를 올렸을 때 펼치는 참조 목록(GitKraken 과 같다, CommitGraphList.ShowRefsPopup) ──
   줄 이름표 바로 위에 겹쳐 참조를 모두 세로로 늘어놓는다. 이름은 자르지 않고 가장 긴 이름에 폭을 맞춘다(옆 칸 위로 넘친다).
   이름표 바탕이 반투명한 가지 색이라 아래 줄이 비치지 않게 목록에 불투명한 바탕을 깐다.
   좁은 칸 규칙(--no-name·--refs-centered)이 목록 안 이름표에는 먹지 않게 클래스를 하나 더 붙여 세게 적는다. */
.commit-graph-refs-popup {
    position: absolute;
    flex-direction: column;
    align-items: stretch;
    border-radius: 4px;
    background-color: var(--git-list-bg);
}

/* 첫 이름표는 줄 이름표와 같은 상자(높이 22·테두리 1)라 펼쳐도 아이콘이 위아래로 움직이지 않는다.
   다음 이름표부터는 위 테두리를 빼서(앞 이름표의 아래 테두리 한 줄만 남긴다) 높이도 1 줄인다 — 안쪽 높이 20 이 모두 같다. */
.commit-graph-refs-popup > .commit-graph-ref,
.commit-graph--refs-centered .commit-graph-refs-popup > .commit-graph-ref {
    flex-shrink: 0;
    width: auto;
    height: 21px;
    padding: 0 8px;
    justify-content: flex-start;
    border-top-width: 0;
    border-radius: 0;
}

.commit-graph-refs-popup > .commit-graph-ref--stack-first,
.commit-graph--refs-centered .commit-graph-refs-popup > .commit-graph-ref--stack-first {
    height: 22px;
    border-top-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

.commit-graph-refs-popup > .commit-graph-ref--stack-last,
.commit-graph--refs-centered .commit-graph-refs-popup > .commit-graph-ref--stack-last {
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.commit-graph-refs-popup > .commit-graph-ref--current,
.commit-graph--refs-centered .commit-graph-refs-popup > .commit-graph-ref--current {
    padding-left: 3px;
}

.commit-graph-refs-popup .commit-graph-ref__name,
.commit-graph--refs-centered .commit-graph-refs-popup .commit-graph-ref__name {
    display: flex;
    flex-shrink: 0;
}

.commit-graph--refs-centered .commit-graph-refs-popup > .commit-graph-ref--current > .commit-graph-ref__local {
    display: flex;
}

.commit-graph--refs-centered .commit-graph-refs-popup > .commit-graph-ref > .commit-graph-ref__local,
.commit-graph--refs-centered .commit-graph-refs-popup > .commit-graph-ref > .commit-graph-ref__remote-icon,
.commit-graph--refs-centered .commit-graph-refs-popup > .commit-graph-ref > .commit-graph-ref__tag-icon {
    margin-left: 5px;
}

/* 마우스가 올라간 참조를 밝게. 이름표 바탕은 인라인 가지 색이라 위에 흰 막을 얇게 덮는다. */
.commit-graph-ref__veil {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.12);
}

.commit-graph-refs-popup > .commit-graph-ref:hover > .commit-graph-ref__veil {
    display: flex;
}

/* 좁은 머리 칸: 글자 대신 아이콘(브랜치/태그 = 브랜치, 그래프 = 계층도). 원래 이름은 툴팁. */
/* 아이콘은 글자가 시작하던 자리(칸 왼쪽 여백)에 그대로 놓는다 — 글자가 그 자리에서 아이콘으로 바뀌어 보이게.
   가운데에 두면 바뀌는 순간 자리가 달라지고, 칸을 더 줄일 때 따라 움직여 밀려 들어오는 것처럼 보인다(GitKraken 도 글자 자리). */
.commit-graph__header-glyph {
    display: none;
    width: 14px;
    height: 14px;
    align-self: flex-start;
}

/* 머리 글자 여백: 칸마다 6px, 맨 왼쪽 칸은 목록 왼쪽 끝에 붙지 않게 20px(GitKraken 과 같다). 아이콘도 같은 자리.
   공용 .list-header__cell(4px)보다 세게 하려고 클래스 둘로 적는다. */
.commit-graph__header .commit-graph__header-cell {
    padding: 0 6px;
}

.commit-graph__header .commit-graph__header-cell--first {
    padding-left: 20px;
}

/* 아이콘으로 바뀐 머리 칸: 위아래 가운데(칸 방향이 세로라 justify 가 세로). 가로 자리는 글자와 같은 왼쪽 여백. */
.commit-graph__header-cell--icon {
    justify-content: center;
}

.commit-graph__header-cell--icon > .commit-graph__header-glyph {
    display: flex;
}

.commit-graph-row__graph {
    flex-shrink: 0;
    height: 100%;
}

/* 가지 색 띠와 오른쪽 끝 막대(색·시작점은 코드가 줄마다 넣는다). 커밋 원 가운데에서 칸 오른쪽 끝까지 깔고,
   위아래를 조금 띄워 줄마다 떨어져 보이게 한다. 칸 순서를 바꿔도 그래프 칸에 붙는다(GitKraken 과 같다).
   막대 폭을 바꾸면 CommitGraphList.LaneBarWidth 도 같이 맞춘다. */
.commit-graph-row__band {
    position: absolute;
    top: 3px;
    bottom: 3px;
    right: 0;
    border-right-width: 3px;
    border-right-color: rgba(0, 0, 0, 0);
}

/* 고른 줄·마우스가 올라간 줄 표시(GitKraken 과 같다). 줄 전체를 칠하지 않는다(ListView 바탕은 코드가 끈다 — CommitGraphList.MakeRow).
   - 메시지 칸: 띠와 같은 높이로 바탕을 깐다(마우스는 옅은 회색, 고른 줄은 옅은 파랑).
   - 그래프 칸: 고른 줄이면 가지 색 띠를 진하게 덮는다(색은 코드가 넣는다).
   - 브랜치/태그 칸: 칠하지 않는다. */
.commit-graph-row__highlight {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 3px;
    bottom: 3px;
}

.commit-graph__list .unity-collection-view__item:hover .commit-graph-row__highlight {
    display: flex;
    background-color: var(--git-hover);
}

.commit-graph__list .unity-collection-view__item--selected .commit-graph-row__highlight {
    display: flex;
    background-color: rgba(59, 130, 196, 0.3);
}

.commit-graph-row__band-glow {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.commit-graph__list .unity-collection-view__item--selected .commit-graph-row__band-glow {
    display: flex;
}

/* 고른 줄 글자는 바탕이 옅으므로 테마의 고른 줄 글자색(모든 글자 흰색) 대신 평소 색을 그대로 쓴다.
   테마 규칙(.git-themed .unity-collection-view .unity-collection-view__item--selected .unity-label)보다 세게 클래스를 더 적는다. */
.git-themed .commit-graph .unity-collection-view .unity-collection-view__item--selected .commit-row__subject,
.git-themed .commit-graph .unity-collection-view .unity-collection-view__item--selected .commit-graph-ref__name,
.git-themed .commit-graph .unity-collection-view .unity-collection-view__item--selected .commit-graph-ref__more,
.git-themed .commit-graph .unity-collection-view .unity-collection-view__item--selected .commit-graph-wip__count-number {
    color: var(--git-text);
}

.git-themed .commit-graph .unity-collection-view .unity-collection-view__item--selected .commit-graph-ref--remote > .commit-graph-ref__name {
    color: var(--git-text-muted);
}

.git-themed .commit-graph .unity-collection-view .unity-collection-view__item--selected .commit-graph-ref--current > .commit-graph-ref__name {
    color: var(--git-accent-text);
}

/* 그래프가 맨 오른쪽 칸이면 가를 다음 칸이 없어 막대를 빼고 띠만 칸 끝까지 깐다(GitKraken 과 같다). */
.commit-graph--graph-last .commit-graph-row__band {
    border-right-width: 0;
}

.commit-graph-row__message {
    flex-direction: row;
    align-items: center;
    overflow: hidden;
    height: 100%;
    padding-left: 10px;
}

.commit-graph-row .commit-row__subject {
    font-size: 13px;
}


/* 작업 중 줄의 변경 개수: [연필]28 [+]314 [−]3(GitKraken 과 같다). 칸이 좁아져도 줄이지 않고 칸 경계가 가린다.
   아이콘: 고침은 그림 원래 색(주황 연필), 추가·지움은 흰 그림을 테마의 추가·지움 색으로 물들인다. 숫자는 기본 글자색. */
.commit-graph-wip__counts {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.commit-graph-wip__count {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 12px;
}

.commit-graph-wip__count-icon {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.commit-graph-wip__count-icon--modified {
    background-image: url("../Icons/Modified.png");
}

.commit-graph-wip__count-icon--added {
    background-image: url("../Icons/Added.png");
    -unity-background-image-tint-color: var(--git-count-added);
}

.commit-graph-wip__count-icon--deleted {
    background-image: url("../Icons/Deleted.png");
    -unity-background-image-tint-color: var(--git-count-deleted);
}

.commit-graph-wip__count-number {
    margin: 0;
    padding: 0;
    font-size: 13px;
    color: var(--git-text);
}

/* 작업 중 줄의 제목 입력란(GitKraken 과 같다). 커밋 입력란의 제목과 같은 글이고, 비어 있으면 "// 작업 중" 자리표시.
   글 길이만큼 늘어나되 max-width 까지만이고, 칸이 좁아져도 줄어들지 않는다 — 뒤의 개수와 함께 칸 경계(.commit-graph-row__message 의
   overflow: hidden)가 오른쪽부터 가린다. 쓰는 중이면(--editing, 코드가 붙인다) 테두리를 강조하고 연필을 보인다. */
.commit-graph-wip {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 10px;
}

.commit-graph-wip__input {
    flex-shrink: 0;
    min-width: 80px;
    max-width: 260px;
    margin: 0;
}

/* 쓰는 중(--wip-editing, 코드가 줄에 붙인다): 입력란을 칸 안에 맞춰 줄여 글이 입력란 안에서 스크롤되게 한다 —
   방금 쓴 글자가 칸 오른쪽 끝에 보인다(GitKraken 과 같다). 줄일 때는 뒤의 개수가 먼저 0 까지 줄어든다(flex-shrink 를 크게). */
.commit-graph-row--wip-editing .commit-graph-wip,
.commit-graph-row--wip-editing .commit-graph-wip__input {
    flex-shrink: 1;
    min-width: 0;
}

.commit-graph-row--wip-editing .commit-graph-wip {
    margin-right: 0;
}

.commit-graph-row--wip-editing .commit-graph-wip__counts {
    flex-shrink: 1000;
    min-width: 0;
    overflow: hidden;
}

/* 칸이 아주 좁으면 연필도 개수처럼 먼저 비켜서 글 쓸 자리를 입력란에 넘긴다. */
.commit-graph-row--wip-editing .commit-graph-wip__pencil {
    flex-shrink: 1000;
    min-width: 0;
    overflow: hidden;
}

/* 쓰는 중에는 입력란 안쪽 여백을 줄여 좁은 칸에서도 글이 몇 자 보이게 한다. */
.commit-graph .commit-graph-row--wip-editing .commit-graph-wip__input > .unity-base-text-field__input {
    padding: 0 4px;
}

.commit-graph .commit-graph-wip__input > .unity-base-text-field__input {
    height: 24px;
    padding: 0 8px;
    font-size: 13px;
    border-width: 1px;
    border-radius: 4px;
    border-color: var(--git-border);
    background-color: rgba(0, 0, 0, 0);
}

.commit-graph .commit-graph-wip__input > .unity-base-text-field__input:hover {
    border-color: var(--git-field-border);
    background-color: var(--git-field-bg);
}

.commit-graph .commit-graph-wip--editing > .commit-graph-wip__input > .unity-base-text-field__input {
    border-color: var(--git-accent);
    background-color: var(--git-field-bg);
}

.commit-graph-wip__pencil {
    display: none;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-left: 6px;
    color: var(--git-text-muted);
}

.commit-graph-wip--editing > .commit-graph-wip__pencil {
    display: flex;
}

/* ── blame-row: 파일 Blame 창의 한 줄 ─────────────────── */
.blame-row {
    flex-direction: row;
    align-items: center;
    height: 18px;
}

/* 같은 커밋 묶음마다 배경을 번갈아 칠해 경계를 보인다. */
.blame-row--odd {
    background-color: var(--git-header-bg);
}

.blame-row--start {
    border-top-width: 1px;
    border-top-color: var(--git-border);
}

.blame-row__hash,
.blame-row__author,
.blame-row__date {
    flex-shrink: 0;
    padding: 0 6px;
    margin: 0;
    font-size: 11px;
    color: var(--git-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.blame-row__hash {
    width: 80px;
    color: var(--git-refs);
}

.blame-row__author {
    width: 120px;
}

.blame-row__date {
    width: 110px;
}

.blame-row__number {
    width: 44px;
    flex-shrink: 0;
    padding: 0 6px 0 0;
    margin: 0;
    font-size: 11px;
    -unity-text-align: middle-right;
    color: var(--git-diff-number);
    background-color: var(--git-diff-gutter);
}

.blame-row__code {
    flex-grow: 1;
    padding: 0 0 0 8px;
    margin: 0;
    white-space: pre;
    color: var(--git-diff-text);
}

.blame-row--uncommitted .blame-row__hash {
    color: var(--git-warning);
}

/* ── 파일 히스토리(GitKraken 의 File History): Graph 탭 가운데를 통째로 덮는다(FileHistoryPanel) ─────
   위: "파일 히스토리: 경로" 와 ×. 왼쪽: 커밋 카드([아바타] 제목 / "2시간 전 · 작성자"  짧은 해시). 오른쪽: 고른 커밋의 diff. */
.file-history {
    flex-grow: 1;
    background-color: var(--git-bg);
}

.file-history__header {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    height: 32px;
    padding: 0 6px 0 12px;
    background-color: var(--git-header-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.file-history__title {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    font-size: 13px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    -unity-text-align: middle-left;
    color: var(--git-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.file-history__close {
    width: 24px;
    height: 24px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: var(--git-radius);
    background-color: rgba(0, 0, 0, 0);
    font-size: 18px;
    color: var(--git-text-muted);
}

.file-history__close:hover {
    background-color: var(--git-hover);
    color: var(--git-text);
}

.file-history__split {
    flex-grow: 1;
}

.file-history__commits {
    background-color: var(--git-list-bg);
    border-right-width: 1px;
    border-right-color: var(--git-border);
}

.file-history__list {
    flex-grow: 1;
    flex-basis: 0;
}

.file-history__list .unity-list-view__empty-label {
    display: none;
}

.file-history__row {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding: 0 10px 0 8px;
}

.file-history__avatar {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin-right: 10px;
    border-radius: 6px;
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: scale-and-crop;
}

.file-history__initials {
    margin: 0;
    padding: 0;
    font-size: 11px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    -unity-text-align: middle-center;
    color: #ffffff;
}

.file-history__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    justify-content: center;
}

.file-history__subject {
    margin: 0;
    padding: 0;
    font-size: 13px;
    color: var(--git-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.file-history__meta {
    margin: 2px 0 0 0;
    padding: 0;
    font-size: 11px;
    color: var(--git-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.file-history__hash {
    flex-shrink: 0;
    align-self: flex-start;
    margin: 6px 0 0 8px;
    padding: 0;
    font-size: 11px;
    -unity-font-definition: url("../Fonts/Jetendard-Regular.ttf");
    color: var(--git-text-muted);
}

.unity-collection-view__item--selected .file-history__hash,
.unity-collection-view__item--selected .file-history__meta {
    color: var(--git-selected-text);
}

.file-history__footer {
    flex-shrink: 0;
    margin: 0;
    padding: 8px 0 10px 0;
    font-size: 11px;
    -unity-text-align: middle-center;
    color: var(--git-text-muted);
    border-top-width: 1px;
    border-top-color: var(--git-border);
}

.file-history__notice {
    margin: 16px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--git-text-muted);
}
