/*
 * Git 창 공용 스타일. 클래스 이름은 BEM(block__element--modifier)을 따른다.
 * 색·모서리는 모두 Themes/*.uss 의 --git-* 토큰을 쓴다(창 루트에 테마 시트 하나가 붙는다, GitTheme).
 */

/* 글꼴: IBM Plex Sans KR, 한글 글꼴에 없는 글자는 JP → SC → TC 순서로 대체(글꼴 에셋의 대체 표). 모두 SIL OFL 1.1(Fonts/IBMPlexSansKR-OFL.txt).
   굵은 글자는 -unity-font-style: bold 대신 Bold 에셋을 직접 쓴다 — bold 로 두면 Regular 를 억지로 두껍게 그려 글자가 뭉개진다.
   글꼴 에셋은 동적이라 그릴 때마다 바뀌지만 GitFontAssetSaveGuard 가 저장을 막는다. 코드(diff·blame)는 코드에서 고정폭 글꼴을 따로 지정한다. */
.git-window {
    color: var(--git-text);
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Regular.asset");
}

/* 누를 수 있는 것에는 손가락 커서. */
.git-window .unity-button,
.git-window .unity-toolbar-button,
.git-window .unity-toolbar-toggle,
.git-window .unity-toolbar-menu,
.git-window .unity-base-popup-field__input,
.git-window .unity-toggle__input,
.git-window .git-sidebar__tab {
    cursor: link;
}

/* 남는 공간을 채우는 빈 요소(도구 막대에서 버튼을 오른쪽으로 민다). */
.spacer {
    flex-grow: 1;
}

/* ── notice: 안내·경고 상자 ───────────────────────── */
.notice {
    flex-direction: row;
    align-items: center;
    margin: 4px;
    padding: 6px 8px;
    border-radius: var(--git-radius);
    border-left-width: 3px;
    background-color: var(--git-header-bg);
    border-left-color: var(--git-accent);
}

.notice--warning {
    border-left-color: var(--git-warning);
}

.notice--error {
    border-left-color: var(--git-danger);
}

.notice__text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    color: var(--git-text);
}

.notice__action {
    margin-left: 8px;
}

/* ── state-badge: 파일 상태 글자 상자(M, A, D, R, ?, !) ─ */
.state-badge {
    width: 14px;
    height: 14px;
    min-width: 14px;
    border-radius: 3px;
    font-size: 9px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.asset");
    -unity-text-align: middle-center;
    color: var(--git-state-text);
    padding: 0;
    margin: 0;
}

/* UVCS 패키지의 상태 아이콘을 배경 그림으로 쓸 때. 그림 둘레가 투명해서 글자 배지보다 조금 크게 잡는다. */
.state-badge--icon {
    width: 16px;
    height: 16px;
    min-width: 16px;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.state-badge--modified { background-color: var(--git-state-modified); }
.state-badge--added { background-color: var(--git-state-added); }
.state-badge--deleted { background-color: var(--git-state-deleted); }
.state-badge--renamed { background-color: var(--git-state-renamed); }
.state-badge--untracked { background-color: var(--git-state-untracked); }
.state-badge--conflicted { background-color: var(--git-state-conflicted); }

/* ── list-header: 목록 위 열 이름 줄 ─────────────────── */
.list-header {
    flex-direction: row;
    height: 20px;
    min-height: 20px;
    align-items: center;
    padding: 0 4px;
    background-color: var(--git-header-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.list-header__cell {
    font-size: 10px;
    color: var(--git-text-muted);
    padding: 0 4px;
    -unity-text-align: middle-left;
}

.list-header__cell--grow {
    flex-grow: 1;
}

/* 머리 줄 오른쪽 끝의 도구(목록/트리 전환 등). */
.list-header__tools {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
}

/* ── view-mode-switch: 경로/트리 전환(GitKraken 형태의 두 칸 묶음) ─── */
.view-mode-switch {
    flex-direction: row;
    flex-shrink: 0;
    border-width: 1px;
    border-color: var(--git-field-border);
    border-radius: var(--git-radius);
    overflow: hidden;
    margin-left: 4px;
}

.view-mode-switch__button {
    flex-direction: row;
    align-items: center;
    height: 18px;
    margin: 0;
    padding: 0 8px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--git-text-muted);
}

.view-mode-switch__button--last {
    border-left-width: 1px;
    border-left-color: var(--git-field-border);
}

.view-mode-switch__button:hover {
    background-color: var(--git-hover);
}

.view-mode-switch__button--selected,
.view-mode-switch__button--selected:hover {
    background-color: var(--git-selected);
    color: var(--git-selected-text);
}

.view-mode-switch__icon {
    width: 13px;
    height: 13px;
    margin-right: 5px;
    color: var(--git-text-muted);
}

.view-mode-switch__button--selected .view-mode-switch__icon {
    color: var(--git-selected-text);
}

.view-mode-switch__label {
    font-size: 11px;
    padding: 0;
    margin: 0;
    color: var(--git-text-muted);
}

.view-mode-switch__button--selected .view-mode-switch__label {
    color: var(--git-selected-text);
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.asset");
}

/* 큰 칸(스테이징 패널 맨 위)에 둘 때. */
.view-mode-switch--large .view-mode-switch__button {
    height: 26px;
    padding: 0 14px;
}

.view-mode-switch--large .view-mode-switch__label {
    font-size: 12px;
}

.view-mode-switch--large .view-mode-switch__icon {
    width: 15px;
    height: 15px;
}

/* ── file-browser: 목록·트리를 겹쳐 두고 하나만 보인다 ── */
.file-browser > .list {
    flex-grow: 1;
}

/* ── list: ListView 공용 ───────────────────────────── */
.list {
    flex-grow: 1;
    background-color: var(--git-list-bg);
}

/*
 * 세로 배치의 공통 규칙: 목록(ListView)·분할 영역만 늘고 줄어든다.
 * ListView 의 기본 flex-basis 는 매우 커서(4000px) 그대로 두면 목록이 공간을 다 차지하고, 대신 위아래 고정 영역(머리 줄·커밋 칸)이
 * 찌그러져 보이지 않게 된다. 그래서 늘어나는 쪽은 basis 0 에서 남는 공간만 받고, 고정 영역은 줄어들지 않게 한다.
 */
.list,
.view,
.view__split,
.view__pane {
    flex-basis: 0;
    flex-shrink: 1;
    min-height: 0;
}

/*
 * 단, 분할(TwoPaneSplitView) 안의 칸은 예외다. 분할은 고정 칸 크기를 height(가로 분할이면 width)로 주는데,
 * basis 가 0 이면 height 를 무시해 고정 칸이 min-height 로 찌그러진다(커밋 상세가 바닥에 붙어 잘리던 원인).
 * 늘어나는 칸은 분할이 인라인으로 basis 0 을 직접 넣으므로 auto 로 되돌려도 그대로다.
 */
.view__split .view__pane {
    flex-basis: auto;
}

.list-header,
.notice,
.unity-toolbar {
    flex-shrink: 0;
}

.list__empty {
    -unity-text-align: middle-center;
    color: var(--git-text-muted);
    margin-top: 12px;
}

/* 고정 폭 열. 목록 줄과 머리 줄이 같은 클래스를 써서 열이 맞는다. */
.column--toggle { width: 22px; min-width: 22px; }
.column--hash { width: 70px; min-width: 70px; }
.column--author { width: 130px; min-width: 130px; }
.column--date { width: 112px; min-width: 112px; }
.column--track { width: 170px; min-width: 170px; }
.column--local { width: 130px; min-width: 130px; }
/* 늘어나는 열은 basis 0 에서 나눈다. auto 면 글자 길이만큼 먼저 차지해 머리 줄과 목록 줄의 열 경계가 어긋난다. */
.column--grow { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 60px; }
.column--grow-2 { flex-grow: 2; flex-shrink: 1; flex-basis: 0; min-width: 60px; }
.column--grow-3 { flex-grow: 3; flex-shrink: 1; flex-basis: 0; min-width: 80px; }

/* 한 줄 글자는 넘치면 …으로 줄인다. */
.ellipsis {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
