/* git-window: 창 전체 배치. git-actionbar: 위쪽 작업 막대. git-sidebar: 왼쪽 탭. */

.git-window {
    flex-grow: 1;
    background-color: var(--git-bg);
}

.git-window__body {
    flex-grow: 1;
    flex-direction: row;
}

.git-window__split {
    flex-grow: 1;
    min-width: 0;
}

.git-window__content {
    flex-grow: 1;
    min-width: 200px;
    /* 원격 추가 서랍이 닫혀 왼쪽 밖으로 밀려나 있을 때 보이지 않게 자른다. */
    overflow: hidden;
}

.git-window__notice {
    margin: 8px;
}

.git-window--not-ready .git-window__body {
    display: none;
}

/* ── github-connect: GitHub 에 로그인하지 않았을 때 본체 대신 보이는 연결 화면 ───────── */
.github-connect {
    align-items: center;
    justify-content: center;
}

.github-connect__card {
    width: 420px;
    max-width: 90%;
    padding: 24px;
    border-width: 1px;
    border-color: var(--git-border);
    border-radius: 8px;
    background-color: var(--git-toolbar-bg);
}

.github-connect__title {
    font-size: 18px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
    margin: 0 0 8px 0;
    padding: 0;
}

.github-connect__text {
    white-space: normal;
    color: var(--git-text-muted);
    margin: 0 0 12px 0;
    padding: 0;
}

.github-connect__step {
    margin-top: 4px;
}

.github-connect__primary {
    height: 32px;
    margin: 0;
    font-size: 13px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-accent-text);
    background-color: var(--git-accent);
    border-width: 0;
    border-radius: 6px;
}

.github-connect__code {
    font-size: 28px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    color: var(--git-text);
    margin: 4px 0 12px 0;
}

.github-connect__row {
    flex-direction: row;
    justify-content: center;
}

.github-connect__secondary {
    height: 24px;
    margin: 0 3px;
}

.github-connect__next {
    margin-top: 12px;
}

.github-connect__error {
    white-space: normal;
    color: var(--git-warning);
    margin: 12px 0 0 0;
}

.github-connect__link {
    align-self: center;
    margin-top: 16px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--git-text-muted);
    font-size: 11px;
}

.github-connect__link:hover {
    color: var(--git-text);
}

/* ── git-actionbar: 위쪽 작업 막대(GitKraken·Fork 형태) ───────── */
.git-actionbar {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    height: 48px;
    padding: 0 6px;
    background-color: var(--git-toolbar-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
    overflow: hidden;
}

/* 왼쪽 "저장소 / 브랜치": 작은 제목 아래 큰 이름. */
.git-actionbar__context {
    flex-shrink: 1;
    min-width: 40px;
    max-width: 200px;
    margin-right: 12px;
}

.git-actionbar__context--branch {
    max-width: 260px;
}

.git-actionbar__caption {
    font-size: 9px;
    color: var(--git-text-muted);
    padding: 0 2px;
    margin: 0;
}

.git-actionbar__value {
    font-size: 13px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
    padding: 0 2px;
    margin: 0;
}

.git-actionbar__branch {
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: var(--git-radius);
}

.git-actionbar__branch:hover {
    background-color: var(--git-hover);
}

/* 브랜치 이름 + ▾(누르면 펼친다는 표시). GitToolbar 가 버튼을 이 줄로 감싼다. 마우스를 올리면 줄 전체를 밝게(버튼만이 아니라 ▾ 까지).
   펼쳐 있으면 ▾ 를 ▴ 로 뒤집는다. */
.git-actionbar__branch-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
    border-radius: var(--git-radius);
}

.git-actionbar__branch-row:hover {
    background-color: var(--git-hover);
}

.git-actionbar__branch-row > .git-actionbar__branch {
    flex-shrink: 1;
    min-width: 0;
}

.git-actionbar__branch-row > .git-actionbar__branch:hover {
    background-color: rgba(0, 0, 0, 0);
}

.git-actionbar__caret {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    margin: 0 4px 0 2px;
    color: var(--git-text-muted);
    cursor: link;
}

.git-actionbar__branch-row--open > .git-actionbar__caret {
    rotate: 180deg;
}

/* ── branch-picker: 작업 막대 브랜치 이름 아래에 펼치는 브랜치 고르기(GitBranchPicker, GitKraken 과 같다) ──
   창 전체를 덮는 투명한 막 위에 목록 상자를 띄운다. 막을 누르면 닫는다. left·top·width 는 GitBranchPicker 가 넣는다. */
.branch-picker-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.branch-picker {
    position: absolute;
    padding: 8px 0 6px 0;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--git-menu-border);
    background-color: var(--git-menu-bg);
}

/* 검색창: 바깥 상자 하나만 테두리(안쪽 TextField 는 투명), 포커스면 강조색. */
.branch-picker__field {
    flex-direction: row;
    align-items: center;
    height: 30px;
    margin: 0 8px 6px 8px;
    padding: 0 6px 0 8px;
    border-width: 1px;
    border-radius: 5px;
    border-color: var(--git-field-border);
    background-color: var(--git-field-bg);
}

.branch-picker__field--focused {
    border-color: var(--git-accent);
}

.branch-picker__search-glyph {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 6px;
    color: var(--git-text-muted);
}

.branch-picker .branch-picker__search {
    flex-grow: 1;
    margin: 0;
}

.branch-picker .branch-picker__search > .unity-base-text-field__input {
    margin: 0;
    padding: 0 2px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 13px;
}

/* 줄 12개 높이까지만 펼치고 나머지는 스크롤. 높이는 GitBranchPicker 가 줄 수에 맞춰 넣는다. */
.branch-picker__list {
    flex-grow: 0;
    max-height: 336px;
}

/* 읽는 중·걸린 것 없음은 아래 안내 글(.branch-picker__message)이 말하므로 ListView 기본 "List is empty" 는 띄우지 않는다. */
.branch-picker__list .unity-list-view__empty-label {
    display: none;
}

.branch-picker__row {
    flex-direction: row;
    align-items: center;
    height: 28px;
    padding: 0 12px 0 14px;
    cursor: link;
}

/* 마우스·↑↓ 로 고른 줄. */
.branch-picker__row--highlight {
    background-color: var(--git-menu-hover);
    color: var(--git-menu-hover-text);
}

/* 지금 체크아웃한 브랜치(GitKraken 처럼 초록 바탕). 고른 줄이어도 초록을 지킨다. */
.branch-picker__row--current,
.branch-picker__row--current.branch-picker__row--highlight {
    background-color: rgba(51, 191, 89, 0.28);
    color: var(--git-text);
}

.branch-picker__glyph {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    margin-right: 8px;
}

.branch-picker__glyph--remote,
.branch-picker__row--remote > .branch-picker__glyph--local {
    display: none;
}

.branch-picker__row--remote > .branch-picker__glyph--remote {
    display: flex;
}

.branch-picker__name {
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    font-size: 13px;
}

.branch-picker__message {
    margin: 4px 14px 2px 14px;
    padding: 0;
    font-size: 12px;
    white-space: normal;
    color: var(--git-text-muted);
}

/* ── repo-picker: 작업 막대 저장소 이름 아래에 펼치는 저장소 고르기(GitRepositoryPicker). 막·상자·줄은 branch-picker 를 쓴다 ── */
.branch-picker.repo-picker {
    padding: 6px 0;
}

/* 이름 뒤에 흐린 글씨로 프로젝트 저장소 / 서브모듈 경로. */
.repo-picker__detail {
    flex-shrink: 1;
    min-width: 0;
    margin: 0 0 0 10px;
    padding: 0;
    font-size: 11px;
    color: var(--git-text-muted);
}

/* 받지 않은 서브모듈: 흐리게, 고를 수 없음. */
.repo-picker__row--disabled {
    opacity: 0.45;
    cursor: arrow;
}

/* 프로젝트 저장소와 서브모듈 사이 구분선. */
.repo-picker__divider {
    height: 1px;
    margin: 4px 10px;
    background-color: var(--git-divider);
}

/* 버튼 묶음 사이 세로 구분선. */
.git-actionbar__group {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    padding: 0 4px;
    border-left-width: 1px;
    border-left-color: var(--git-divider);
}

.git-actionbar__group--first {
    border-left-width: 0;
}

.git-actionbar__side {
    flex-direction: row;
    flex-shrink: 1;
    align-items: center;
    min-width: 24px;
}

.git-actionbar__status {
    flex-shrink: 1;
    max-width: 220px;
    font-size: 10px;
    color: var(--git-text-muted);
    -unity-text-align: middle-right;
    margin-right: 4px;
}

/* ── git-action: 아이콘 위·글자 아래 버튼 ── */
.git-action {
    flex-direction: column;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 42px;
    margin: 0 1px;
    padding: 2px 0 1px 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: var(--git-radius);
    color: var(--git-text);
}

.git-action:hover {
    background-color: var(--git-hover);
}

.git-action:active {
    background-color: var(--git-pressed);
}

.git-action:disabled {
    opacity: 0.35;
}

.git-action__icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--git-text);
}

/* 그림 아이콘(실행 취소·다시 실행): 흰 Material Symbols 그림을 글자색으로 물들인다. 꺼지면 .git-action:disabled 가 흐리게 한다. */
.git-action__icon--undo,
.git-action__icon--redo {
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--git-text);
}

.git-action__icon--undo {
    background-image: url("../Icons/Undo.png");
}

.git-action__icon--redo {
    background-image: url("../Icons/Redo.png");
}

.git-action__caption {
    font-size: 10px;
    color: var(--git-text-muted);
    padding: 0;
    margin: 1px 0 0 0;
    -unity-text-align: middle-center;
}

/* 받을·올릴 커밋 수, stash 수. 아이콘 오른쪽 위에 겹친다. */
.git-action__badge {
    position: absolute;
    top: 1px;
    right: 6px;
    min-width: 14px;
    height: 13px;
    padding: 0 3px;
    border-radius: 7px;
    font-size: 9px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    -unity-text-align: middle-center;
    color: var(--git-accent-text);
    background-color: var(--git-accent);
}

.git-action__badge--hidden {
    display: none;
}

/* 계정 문제로 자동 fetch 가 실패했다는 경고(Fetch 버튼). */
.git-action__badge--warning {
    color: #ffffff;
    background-color: var(--git-danger);
}

/* 창이 좁으면 글자를 빼고 아이콘만 남긴다(GitToolbar 가 폭을 보고 붙인다). */
.git-actionbar--compact .git-action {
    width: 30px;
}

.git-actionbar--compact .git-action__caption,
.git-actionbar--compact .git-actionbar__status {
    display: none;
}

.git-actionbar--compact .git-action__badge {
    right: 0;
}

.git-toolbar__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    align-self: center;
}

.unity-toolbar-button.git-toolbar__icon-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-top: 0;
    padding-bottom: 0;
}

.git-sidebar {
    min-width: 160px;
    flex-direction: column;
    background-color: var(--git-sidebar-bg);
    border-right-width: 1px;
    border-right-color: var(--git-border);
}

/* ── git-rail: 사이드바를 접었을 때 남는 아이콘 줄 ─────────────── */
.git-rail {
    flex-shrink: 0;
    width: 36px;
    padding: 6px 0;
    flex-direction: column;
    align-items: stretch;
    background-color: var(--git-sidebar-bg);
    border-right-width: 1px;
    border-right-color: var(--git-border);
}

.git-rail__group {
    padding: 4px 0;
    border-top-width: 1px;
    border-top-color: var(--git-border);
}

.git-rail__item {
    flex-direction: column;
    align-items: center;
    padding: 5px 0;
    margin: 1px 4px;
    border-radius: 4px;
    color: var(--git-text-muted);
}

/* 커서는 물려받지 않아 아이콘·숫자에도 준다. */
.git-rail__item,
.git-rail__item * {
    cursor: link;
}

.git-rail__item:hover {
    background-color: var(--git-hover);
    color: var(--git-text);
}

.git-rail__item--selected,
.git-rail__item--selected:hover {
    background-color: var(--git-selected);
    color: var(--git-selected-text);
}

.git-rail__item--expand {
    margin-bottom: 4px;
}

.git-rail__icon {
    width: 18px;
    height: 18px;
}

.git-rail__icon > .action-glyph {
    flex-grow: 1;
}

.git-rail__badge {
    font-size: 10px;
    margin: 1px 0 0 0;
    padding: 0;
    -unity-text-align: middle-center;
    color: var(--git-section-count);
}

.git-rail__badge--hidden {
    display: none;
}

.git-sidebar__views {
    flex-shrink: 0;
    padding: 4px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.git-sidebar__refs {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

/* ── ref-tree: 사이드바 참조 트리 ─────────────────── */
.ref-tree {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

/* 사이드바 필터(Fork 처럼 한 줄 높이의 넉넉한 상자, 비어 있으면 "Filter"). 툴바 검색창 기본(18px)은 너무 작다.
   클래스를 겹쳐 적어 테마의 .unity-search-field-base 규칙보다 이긴다. */
.ref-tree .ref-tree__filter {
    flex-shrink: 0;
    width: auto;
    height: 26px;
    min-height: 26px;
    margin: 8px 8px 6px 8px;
    padding: 0 4px;
    border-radius: 5px;
    align-items: center;
}

.ref-tree .ref-tree__filter .unity-base-text-field__input {
    font-size: 13px;
    -unity-text-align: middle-left;
}

/* 돋보기도 글자에 맞춰 키운다. */
.ref-tree .ref-tree__filter .unity-search-field-base__search-button {
    width: 16px;
    height: 16px;
    margin-left: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.ref-tree__error {
    flex-shrink: 0;
    white-space: normal;
    font-size: 10px;
    margin: 0 8px 4px 8px;
    color: var(--git-danger);
}

.ref-tree__tree {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    background-color: var(--git-sidebar-bg);
}

/* 구역 머리 줄(로컬·리모트…)만 줄 전체(펼침 화살표 포함)에 손가락 커서. 그 아래 항목은 기본 커서.
   커서는 물려받지 않아 포인터를 받는 안쪽 요소(글자·아이콘·화살표)에도 준다. */
.ref-tree__item--section,
.ref-tree__item--section * {
    cursor: link;
}

/* 왼쪽 끝에 붙지 않게 필터 상자와 같은 8px 를 띄운다. 선택 배경은 항목 전체 너비 그대로다. */
.ref-tree__tree .unity-tree-view__item {
    padding-left: 8px;
}

/* 폴더·원격(늘 펼침)의 화살표. 들여쓰기를 맞추려 자리는 남기고 보이지만 않게 한다.
   visibility 는 TreeView 가 직접 정하므로 opacity 로 감춘다. */
.ref-tree__item--fixed .unity-tree-view__item-toggle {
    opacity: 0;
}

.ref-tree__row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    height: 20px;
    padding-right: 6px;
}

.ref-tree__icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-right: 5px;
    color: var(--git-text-muted);
}

.ref-tree__icon > .action-glyph {
    width: 14px;
    height: 14px;
}

.ref-tree__label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: var(--git-text);
}

.ref-tree__badge {
    flex-shrink: 0;
    font-size: 10px;
    margin-left: 4px;
    color: var(--git-text-muted);
}

/* 구역 머리 줄(로컬·리모트…): GitKraken 처럼 굵은 대문자 느낌. */
.ref-tree__row--section .ref-tree__label {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text-muted);
}

/* 구역 개수: 10px 는 흐려 보여 한 단계 키운다. 색은 테마 토큰(--git-section-count — JetBrains 는 강조색, Unity 는 흐린 글자색). */
.ref-tree__row--section .ref-tree__badge {
    font-size: 11px;
    color: var(--git-section-count);
}

/* PR 묶음·안내 줄: 아이콘 없이 글자만. 안내는 흐리게. */
.ref-tree__row--plain .ref-tree__icon {
    display: none;
}

.ref-tree__row--info .ref-tree__label {
    color: var(--git-text-muted);
}

/* 현재 브랜치·워크트리: 굵게, 아이콘은 강조색. */
.ref-tree__row--current .ref-tree__label {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
}

.ref-tree__row--current .ref-tree__icon {
    color: var(--git-accent-fg);
}

/* 리모트·워크트리·서브모듈 머리 줄의 + (GitKraken 처럼 줄에 마우스를 올리면 개수 대신 바로 나온다 — 전환 없이 딱 바뀐다). */
.ref-tree__add {
    display: none;
    flex-shrink: 0;
    width: 22px;
    height: 18px;
    margin: 0 0 0 4px;
    padding: 0;
    border-width: 1px;
    border-radius: var(--git-radius);
    border-color: var(--git-success);
    background-color: rgba(63, 184, 92, 0.18);
    color: var(--git-text);
    font-size: 14px;
    -unity-text-align: middle-center;
    cursor: link;
}

.ref-tree__add:hover {
    background-color: rgba(63, 184, 92, 0.32);
}

.unity-tree-view__item:hover .ref-tree__row--addable .ref-tree__add {
    display: flex;
}

.unity-tree-view__item:hover .ref-tree__row--addable .ref-tree__badge {
    display: none;
}

/* ── side-drawer: 본문 왼쪽에서 밀려 나오는 서랍(원격 추가 · 워크트리 · 서브모듈 · Pull Request) ── */
.side-drawer {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 480px;
    max-width: 100%;
    padding: 14px 0 0 0;
    background-color: var(--git-bg);
    border-right-width: 1px;
    border-right-color: var(--git-border);
    translate: -100% 0;
    transition-property: translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-cubic;
}

.side-drawer--open {
    translate: 0 0;
}

.side-drawer--hidden {
    visibility: hidden;
}

.side-drawer__header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: 0 18px 10px 18px;
}

.side-drawer__header-glyph {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    color: var(--git-text-muted);
}

.side-drawer__title {
    flex-grow: 1;
    font-size: 16px;
    color: var(--git-text);
}

.side-drawer__close {
    width: 24px;
    height: 24px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--git-text-muted);
    font-size: 14px;
}

.side-drawer__close:hover {
    background-color: var(--git-hover);
    color: var(--git-text);
}

.side-drawer__body {
    flex-grow: 1;
}

.side-drawer__content {
    padding: 0 18px 18px 18px;
}

.side-drawer__tabs {
    flex-direction: row;
    flex-shrink: 0;
    margin: 0 -18px 6px -18px;
    padding: 0 18px;
    border-bottom-width: 1px;
    border-bottom-color: var(--git-divider);
}

.side-drawer__tab {
    flex-direction: column;
    align-items: center;
    width: 72px;
    margin: 0 4px 0 0;
    padding: 4px 0 6px 0;
    border-width: 0 0 2px 0;
    border-radius: 0;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: var(--git-text-muted);
}

.side-drawer__tab:hover {
    color: var(--git-text);
    background-color: rgba(0, 0, 0, 0);
}

.side-drawer__tab--selected {
    color: var(--git-text);
    border-color: var(--git-text);
}

.side-drawer__tab-glyph {
    width: 24px;
    height: 24px;
    margin-bottom: 3px;
}

.side-drawer__tab-label {
    font-size: 12px;
}

.side-drawer__section {
    flex-shrink: 0;
}

.side-drawer__caption {
    margin: 10px 0 4px 0;
    color: var(--git-text);
}

.side-drawer__input {
    margin: 0;
    height: 26px;
}

.side-drawer__input .unity-base-text-field__input {
    padding: 0 6px;
}

.side-drawer__input--multiline {
    height: 110px;
}

.side-drawer__input--multiline .unity-base-text-field__input {
    padding: 4px 6px;
    -unity-text-align: upper-left;
    white-space: normal;
}

.side-drawer__row {
    flex-direction: row;
    align-items: center;
}

.side-drawer__grow {
    flex-grow: 1;
    flex-basis: 0;
}

.side-drawer__row > .side-drawer__browse {
    height: 26px;
    margin: 0 0 0 6px;
    align-self: auto;
}

.side-drawer__columns {
    flex-direction: row;
    align-items: flex-start;
}

.side-drawer__column {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

.side-drawer__arrow {
    width: 28px;
    margin-top: 58px;
    font-size: 16px;
    -unity-text-align: middle-center;
    color: var(--git-text-muted);
}

.side-drawer__toggle {
    margin: 10px 0 0 0;
}

.side-drawer__note,
.side-drawer__message {
    margin-top: 6px;
    white-space: normal;
    color: var(--git-text-muted);
}

.side-drawer__problem {
    margin-top: 6px;
    white-space: normal;
    font-size: 11px;
    color: var(--git-danger);
}

.side-drawer__primary {
    height: 30px;
    margin: 16px 0 0 0;
    border-width: 1px;
    border-radius: var(--git-radius);
    border-color: var(--git-success);
    background-color: rgba(63, 184, 92, 0.18);
    color: var(--git-text);
}

.side-drawer__primary:hover {
    background-color: rgba(63, 184, 92, 0.32);
}

.side-drawer__primary:disabled {
    opacity: 0.5;
}

.side-drawer__secondary {
    height: 26px;
    margin: 10px 0 0 0;
    align-self: flex-start;
}

.side-drawer__buttons > .side-drawer__secondary {
    height: 30px;
    margin: 16px 8px 0 0;
    align-self: auto;
}

/* ── search-select: 서랍의 검색 되는 고르기 칸 ── */
.search-select {
    flex-shrink: 0;
}

.search-select__box {
    flex-direction: row;
    align-items: center;
}

.search-select__search {
    flex-grow: 1;
    margin: 0;
    height: 26px;
}

.search-select__search .unity-base-text-field__input {
    padding: 0 24px 0 6px;
}

.search-select__caret {
    position: absolute;
    right: 6px;
    width: 14px;
    height: 14px;
    color: var(--git-text-muted);
}

.search-select__list {
    margin-top: 2px;
    background-color: var(--git-field-bg);
    border-width: 1px;
    border-color: var(--git-field-border);
    border-radius: var(--git-radius);
}

.search-select__item {
    flex-direction: row;
    align-items: center;
    height: 24px;
    padding: 0 8px;
}

.search-select__item:hover,
.search-select__item--highlight {
    background-color: var(--git-selected);
}

.search-select__item-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: var(--git-text);
}

.search-select__item-badge {
    flex-shrink: 0;
    margin-left: 6px;
    font-size: 10px;
    color: var(--git-text-muted);
}

.git-sidebar__tab {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding: 0 10px;
}

.git-sidebar__tab:hover {
    background-color: var(--git-hover);
}

.git-sidebar__tab--selected,
.git-sidebar__tab--selected:hover {
    background-color: var(--git-selected);
}

.git-sidebar__tab-title {
    flex-grow: 1;
    color: var(--git-text);
}

.git-sidebar__tab--selected .git-sidebar__tab-title {
    color: var(--git-selected-text);
}

.git-sidebar__tab-badge {
    font-size: 10px;
    padding: 0 5px;
    border-radius: 8px;
    background-color: var(--git-badge-bg);
    color: var(--git-text);
}

.git-sidebar__tab-badge--hidden {
    display: none;
}
