/* git-window: 창 전체 배치. git-actionbar: 위쪽 작업 막대. git-sidebar: 왼쪽 탭. */

.git-window {
    flex-grow: 1;
    background-color: var(--git-bg);
}

.git-window__body {
    flex-grow: 1;
}

.git-window__content {
    flex-grow: 1;
    min-width: 200px;
}

.git-window__notice {
    margin: 8px;
}

.git-window--not-ready .git-window__body {
    display: none;
}

/* ── github-connect: GitHub 에 로그인하지 않았을 때 본체 대신 보이는 연결 화면 ───────── */
.github-connect {
    align-items: center;
    justify-content: center;
}

.github-connect__card {
    width: 420px;
    max-width: 90%;
    padding: 24px;
    border-width: 1px;
    border-color: var(--git-border);
    border-radius: 8px;
    background-color: var(--git-toolbar-bg);
}

.github-connect__title {
    font-size: 18px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
    margin: 0 0 8px 0;
    padding: 0;
}

.github-connect__text {
    white-space: normal;
    color: var(--git-text-muted);
    margin: 0 0 12px 0;
    padding: 0;
}

.github-connect__step {
    margin-top: 4px;
}

.github-connect__primary {
    height: 32px;
    margin: 0;
    font-size: 13px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-accent-text);
    background-color: var(--git-accent);
    border-width: 0;
    border-radius: 6px;
}

.github-connect__code {
    font-size: 28px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    color: var(--git-text);
    margin: 4px 0 12px 0;
}

.github-connect__row {
    flex-direction: row;
    justify-content: center;
}

.github-connect__secondary {
    height: 24px;
    margin: 0 3px;
}

.github-connect__next {
    margin-top: 12px;
}

.github-connect__error {
    white-space: normal;
    color: var(--git-warning);
    margin: 12px 0 0 0;
}

.github-connect__link {
    align-self: center;
    margin-top: 16px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--git-text-muted);
    font-size: 11px;
}

.github-connect__link:hover {
    color: var(--git-text);
}

/* ── git-actionbar: 위쪽 작업 막대(GitKraken·Fork 형태) ───────── */
.git-actionbar {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    height: 48px;
    padding: 0 6px;
    background-color: var(--git-toolbar-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
    overflow: hidden;
}

/* 왼쪽 "저장소 / 브랜치": 작은 제목 아래 큰 이름. */
.git-actionbar__context {
    flex-shrink: 1;
    min-width: 40px;
    max-width: 200px;
    margin-right: 12px;
}

.git-actionbar__context--branch {
    max-width: 260px;
}

.git-actionbar__caption {
    font-size: 9px;
    color: var(--git-text-muted);
    padding: 0 2px;
    margin: 0;
}

.git-actionbar__value {
    font-size: 13px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text);
    padding: 0 2px;
    margin: 0;
}

.git-actionbar__branch {
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: var(--git-radius);
}

.git-actionbar__branch:hover {
    background-color: var(--git-hover);
}

/* 버튼 묶음 사이 세로 구분선. */
.git-actionbar__group {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    padding: 0 4px;
    border-left-width: 1px;
    border-left-color: var(--git-divider);
}

.git-actionbar__group--first {
    border-left-width: 0;
}

.git-actionbar__side {
    flex-direction: row;
    flex-shrink: 1;
    align-items: center;
    min-width: 24px;
}

.git-actionbar__status {
    flex-shrink: 1;
    max-width: 220px;
    font-size: 10px;
    color: var(--git-text-muted);
    -unity-text-align: middle-right;
    margin-right: 4px;
}

/* ── git-action: 아이콘 위·글자 아래 버튼 ── */
.git-action {
    flex-direction: column;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 42px;
    margin: 0 1px;
    padding: 2px 0 1px 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: var(--git-radius);
    color: var(--git-text);
}

.git-action:hover {
    background-color: var(--git-hover);
}

.git-action:active {
    background-color: var(--git-pressed);
}

.git-action:disabled {
    opacity: 0.35;
}

.git-action__icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--git-text);
}

.git-action__caption {
    font-size: 10px;
    color: var(--git-text-muted);
    padding: 0;
    margin: 1px 0 0 0;
    -unity-text-align: middle-center;
}

/* 받을·올릴 커밋 수, stash 수. 아이콘 오른쪽 위에 겹친다. */
.git-action__badge {
    position: absolute;
    top: 1px;
    right: 6px;
    min-width: 14px;
    height: 13px;
    padding: 0 3px;
    border-radius: 7px;
    font-size: 9px;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    -unity-text-align: middle-center;
    color: var(--git-accent-text);
    background-color: var(--git-accent);
}

.git-action__badge--hidden {
    display: none;
}

/* 창이 좁으면 글자를 빼고 아이콘만 남긴다(GitToolbar 가 폭을 보고 붙인다). */
.git-actionbar--compact .git-action {
    width: 30px;
}

.git-actionbar--compact .git-action__caption,
.git-actionbar--compact .git-actionbar__status {
    display: none;
}

.git-actionbar--compact .git-action__badge {
    right: 0;
}

.git-toolbar__icon {
    width: 16px;
    height: 16px;
}

.git-sidebar {
    min-width: 160px;
    flex-direction: column;
    background-color: var(--git-sidebar-bg);
    border-right-width: 1px;
    border-right-color: var(--git-border);
}

.git-sidebar__views {
    flex-shrink: 0;
    padding: 4px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--git-border);
}

.git-sidebar__refs {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

/* ── ref-tree: 사이드바 참조 트리 ─────────────────── */
.ref-tree {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.ref-tree__filter {
    flex-shrink: 0;
    width: auto;
    margin: 6px 6px 4px 6px;
}

.ref-tree__error {
    flex-shrink: 0;
    white-space: normal;
    font-size: 10px;
    margin: 0 8px 4px 8px;
    color: var(--git-danger);
}

.ref-tree__tree {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.ref-tree__row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    height: 20px;
    padding-right: 6px;
}

.ref-tree__icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-right: 5px;
    color: var(--git-text-muted);
}

.ref-tree__icon > .action-glyph {
    width: 14px;
    height: 14px;
}

.ref-tree__label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: var(--git-text);
}

.ref-tree__badge {
    flex-shrink: 0;
    font-size: 10px;
    margin-left: 4px;
    color: var(--git-text-muted);
}

/* 구역 머리 줄(로컬·리모트…): GitKraken 처럼 굵은 대문자 느낌. */
.ref-tree__row--section .ref-tree__label {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
    color: var(--git-text-muted);
}

.ref-tree__row--section .ref-tree__badge {
    color: var(--git-accent);
}

/* 현재 브랜치·워크트리: 굵게, 아이콘은 강조색. */
.ref-tree__row--current .ref-tree__label {
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Bold.ttf");
}

.ref-tree__row--current .ref-tree__icon {
    color: var(--git-accent);
}

.git-sidebar__tab {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding: 0 10px;
}

.git-sidebar__tab:hover {
    background-color: var(--git-hover);
}

.git-sidebar__tab--selected,
.git-sidebar__tab--selected:hover {
    background-color: var(--git-selected);
}

.git-sidebar__tab-title {
    flex-grow: 1;
    color: var(--git-text);
}

.git-sidebar__tab--selected .git-sidebar__tab-title {
    color: var(--git-selected-text);
}

.git-sidebar__tab-badge {
    font-size: 10px;
    padding: 0 5px;
    border-radius: 8px;
    background-color: var(--git-badge-bg);
    color: var(--git-text);
}

.git-sidebar__tab-badge--hidden {
    display: none;
}
