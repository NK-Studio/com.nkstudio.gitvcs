<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement class="view branch-explorer">
        <uie:Toolbar class="branch-explorer__toolbar">
            <ui:DropdownField name="range" class="branch-explorer__range" />
            <ui:Label name="summary" class="view__toolbar-label" />
            <ui:VisualElement class="spacer" />
            <uie:ToolbarSearchField name="search" class="branch-explorer__search" />
            <uie:ToolbarButton name="next-match-button" text="@explorer.next" tooltip="@explorer.nextTooltip" />
        </uie:Toolbar>

        <ui:VisualElement name="error-notice" class="notice notice--error">
            <ui:Label name="error-text" class="notice__text" />
        </ui:VisualElement>
        <ui:VisualElement name="empty-notice" class="notice">
            <ui:Label text="@common.noCommits" class="notice__text" />
        </ui:VisualElement>

        <!-- Unity VCS 처럼 오른쪽이 인스펙터: 커밋을 누를 때마다 그 커밋의 작성자·날짜·부모·메시지·바뀐 파일을 보인다. -->
        <ui:TwoPaneSplitView name="split" fixed-pane-index="1" fixed-pane-initial-dimension="380" orientation="Horizontal" class="view__split">
            <ui:VisualElement name="graph-pane" class="branch-explorer__graph-pane">
                <ui:VisualElement name="graph-host" class="branch-explorer__graph-pane" />
                <ui:VisualElement class="branch-explorer__overlay">
                    <ui:Button name="head-button" tooltip="@explorer.head" class="branch-explorer__overlay-button" />
                    <ui:Button name="zoom-in-button" tooltip="@explorer.zoomIn" class="branch-explorer__overlay-button" />
                    <ui:Button name="zoom-out-button" tooltip="@explorer.zoomOut" class="branch-explorer__overlay-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="detail-host" class="view__pane graph-workspace__side branch-explorer__detail" />
        </ui:TwoPaneSplitView>
    </ui:VisualElement>
</ui:UXML>
