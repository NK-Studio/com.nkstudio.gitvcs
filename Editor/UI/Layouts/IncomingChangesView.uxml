<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement class="view incoming-changes">
        <uie:Toolbar class="incoming-changes__toolbar">
            <ui:Label name="summary" class="view__toolbar-label" />
            <ui:VisualElement class="spacer" />
            <uie:ToolbarButton name="fetch-button" text="Fetch" />
            <uie:ToolbarButton name="pull-button" text="Pull" tooltip="@common.ffOnly" />
        </uie:Toolbar>

        <ui:VisualElement name="error-notice" class="notice notice--error">
            <ui:Label name="error-text" class="notice__text" />
        </ui:VisualElement>
        <ui:VisualElement name="info-notice" class="notice">
            <ui:Label name="info-text" class="notice__text" />
        </ui:VisualElement>
        <ui:VisualElement name="diverged-notice" class="notice notice--warning">
            <ui:Label name="diverged-text" class="notice__text" />
        </ui:VisualElement>
        <ui:VisualElement name="overlap-notice" class="notice notice--warning">
            <ui:Label name="overlap-text" class="notice__text" />
        </ui:VisualElement>

        <ui:TwoPaneSplitView name="split" fixed-pane-index="1" fixed-pane-initial-dimension="220" orientation="Vertical" class="view__split">
            <ui:VisualElement class="view__pane">
                <ui:VisualElement class="list-header">
                    <ui:Label text="@column.hash" class="list-header__cell column--hash" />
                    <ui:Label text="@column.message" class="list-header__cell column--grow-3" />
                    <ui:Label text="@column.author" class="list-header__cell column--author" />
                    <ui:Label text="@column.date" class="list-header__cell column--date" />
                </ui:VisualElement>
                <ui:ListView name="commit-list" class="list" />
            </ui:VisualElement>
            <ui:VisualElement class="view__pane">
                <ui:VisualElement class="list-header">
                    <ui:Label text="@column.incomingFiles" class="list-header__cell list-header__cell--grow" />
                    <ui:Label text="@column.local" class="list-header__cell column--local" />
                    <ui:VisualElement name="view-mode-host" class="list-header__tools" />
                </ui:VisualElement>
                <ui:VisualElement name="file-list" class="list file-browser" />
            </ui:VisualElement>
        </ui:TwoPaneSplitView>
    </ui:VisualElement>
</ui:UXML>
