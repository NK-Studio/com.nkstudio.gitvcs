<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <!-- Unity VCS(Gluon) "변경사항 체크인" 배치: 맨 위 동작 줄·커밋 메시지, 그 아래 파일 목록·고른 파일 diff, 오른쪽에 접히는 세부사항. -->
    <ui:VisualElement class="view pending-changes">
        <!-- 동작 줄: 커밋·변경 되돌리기(왼쪽), 세부사항 표시(오른쪽). -->
        <ui:VisualElement class="pending-changes__actions">
            <ui:Button name="commit-button" class="pending-changes__commit-button" />
            <ui:Button name="discard-button" text="@pending.discard" class="pending-changes__action-button" />
            <ui:VisualElement class="pending-changes__actions-spacer" />
            <ui:Button name="details-button" text="@pending.showDetails" class="pending-changes__action-button pending-changes__details-button" />
        </ui:VisualElement>

        <ui:VisualElement class="pending-changes__commit">
            <ui:TextField name="commit-message" multiline="true" vertical-scroller-visibility="Auto" class="pending-changes__message" />
            <ui:VisualElement name="author-notice" class="notice notice--warning">
                <ui:Label text="@pending.noAuthor" class="notice__text" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 왼쪽(목록·diff)과 오른쪽 세부사항. 세부사항을 끄면 오른쪽을 접는다. -->
        <ui:TwoPaneSplitView name="details-split" fixed-pane-index="1" fixed-pane-initial-dimension="340" orientation="Horizontal" class="view__split">
            <ui:VisualElement class="view__pane pending-changes__main">
                <!-- 머리 줄 하나: 모두 선택·개수(왼쪽), 경로/트리 전환(오른쪽). 스테이징 구역 머리 줄과 같은 높이·여백. -->
                <ui:VisualElement class="pending-changes__header">
                    <ui:Toggle name="select-all" class="pending-changes__select-all" />
                    <ui:Label name="summary" class="pending-changes__summary" />
                    <ui:VisualElement name="view-mode-host" class="pending-changes__tools" />
                </ui:VisualElement>

                <!-- 파일 목록(위)·고른 파일의 diff(아래). 경계선을 끌어 diff 높이를 바꾼다. -->
                <ui:TwoPaneSplitView name="split" fixed-pane-index="1" fixed-pane-initial-dimension="300" orientation="Vertical" class="view__split">
                    <ui:VisualElement class="view__pane">
                        <ui:VisualElement name="file-list" class="list file-browser pending-changes__list" />
                    </ui:VisualElement>
                    <ui:VisualElement name="diff-host" class="view__pane pending-changes__diff" />
                </ui:TwoPaneSplitView>
            </ui:VisualElement>

            <ui:VisualElement class="view__pane workspace__side pending-changes__details">
                <ui:Label name="info-placeholder" text="@workspace.selectHint" class="list__empty" />
                <ui:VisualElement name="info" class="workspace__info">
                    <ui:Label name="info-name" class="workspace__info-name ellipsis" />
                    <ui:VisualElement name="info-rows" class="workspace__info-rows" />
                </ui:VisualElement>
                <ui:Label name="history-title" text="@workspace.history" class="workspace__history-title" />
                <ui:Label name="history-empty" class="list__empty" />
                <ui:ListView name="history" class="list workspace__history" />
                <ui:Label name="history-message" class="pending-changes__history-message" />
            </ui:VisualElement>
        </ui:TwoPaneSplitView>
    </ui:VisualElement>
</ui:UXML>
