<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <!-- 스타일은 창 루트에 한 번만 붙인다. 아래에 끼워 넣는 탭·목록 줄은 모두 이 루트의 자손이라 같이 적용된다. -->
    <ui:Style src="../Styles/GitCommon.uss" />
    <ui:Style src="../Styles/GitWindow.uss" />
    <ui:Style src="../Styles/GitRows.uss" />
    <ui:Style src="../Styles/GitViews.uss" />
    <ui:Style src="../Styles/BranchGraph.uss" />
    <ui:Style src="../Styles/GitDiff.uss" />
    <ui:Style src="../Styles/GitStaging.uss" />

    <ui:VisualElement name="git-window" class="git-window">
        <!-- GitKraken·Fork 처럼 아이콘+글자 버튼을 묶음으로 둔 작업 막대. 버튼 안 아이콘·글자·숫자는 GitToolbar 가 채운다. -->
        <ui:VisualElement name="action-bar" class="git-actionbar">
            <ui:VisualElement class="git-actionbar__context">
                <ui:Label text="@actionbar.repository" class="git-actionbar__caption" />
                <ui:Label name="repo-name" class="git-actionbar__value ellipsis" />
            </ui:VisualElement>
            <ui:VisualElement class="git-actionbar__context git-actionbar__context--branch">
                <ui:Label text="@actionbar.branch" class="git-actionbar__caption" />
                <ui:Button name="branch-button" tooltip="@common.openBranchesTab" class="git-actionbar__value git-actionbar__branch ellipsis" />
            </ui:VisualElement>
            <ui:VisualElement class="spacer" />
            <ui:VisualElement class="git-actionbar__group git-actionbar__group--first">
                <ui:Button name="undo-button" text="@actionbar.undo" class="git-action" />
                <ui:Button name="redo-button" text="@actionbar.redo" class="git-action" />
            </ui:VisualElement>
            <ui:VisualElement class="git-actionbar__group">
                <ui:Button name="fetch-button" text="@actionbar.fetch" tooltip="@actionbar.fetchTooltip" class="git-action" />
                <ui:Button name="pull-button" text="@actionbar.pull" class="git-action" />
                <ui:Button name="push-button" text="@actionbar.push" class="git-action" />
            </ui:VisualElement>
            <ui:VisualElement class="git-actionbar__group">
                <ui:Button name="new-branch-button" text="@actionbar.newBranch" tooltip="@actionbar.newBranchTooltip" class="git-action" />
            </ui:VisualElement>
            <ui:VisualElement class="git-actionbar__group">
                <ui:Button name="stash-button" text="@actionbar.stash" tooltip="@actionbar.stashTooltip" class="git-action" />
                <ui:Button name="pop-button" text="@actionbar.pop" class="git-action" />
            </ui:VisualElement>
            <ui:VisualElement class="spacer" />
            <ui:VisualElement class="git-actionbar__side">
                <ui:Label name="status-label" class="git-actionbar__status ellipsis" />
            </ui:VisualElement>
            <!-- 터미널·새로고침은 맨 오른쪽. 새로고침은 창에 하나만 두고, 저장소 상태와 보고 있는 탭 내용을 함께 다시 읽는다. -->
            <ui:VisualElement class="git-actionbar__group">
                <ui:Button name="terminal-button" text="@actionbar.terminal" tooltip="@actionbar.terminalTooltip" class="git-action" />
                <ui:Button name="refresh-button" text="@common.refresh" tooltip="@actionbar.refreshTooltip" class="git-action" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="not-ready" class="git-window__notice notice">
            <ui:Label name="not-ready-message" class="notice__text" />
            <ui:Button name="open-settings-button" text="@common.openVcsSettings" class="notice__action" />
        </ui:VisualElement>

        <ui:TwoPaneSplitView name="body" fixed-pane-index="0" fixed-pane-initial-dimension="230" orientation="Horizontal" class="git-window__body">
            <!-- 왼쪽: 위는 탭(뷰) 목록, 아래는 GitKraken·Fork 식 참조 트리(로컬·리모트·워크트리·스태시·서브모듈·태그). -->
            <ui:VisualElement name="sidebar" class="git-sidebar">
                <ui:VisualElement name="sidebar-views" class="git-sidebar__views" />
                <ui:VisualElement name="sidebar-refs" class="git-sidebar__refs" />
            </ui:VisualElement>
            <ui:VisualElement name="content" class="git-window__content" />
        </ui:TwoPaneSplitView>
    </ui:VisualElement>
</ui:UXML>
