@import url("../Styles/GitThemes.uss");

/* JetBrains — Dark (IntelliJ/Android Studio 2026 Dark: 모든 패널이 같은 바탕이고 얇은 구분선으로만 나눈다). 색·모서리 토큰을 정의하고, Unity 기본 컨트롤이 이 토큰을 따르게 하는 Styles/GitThemes.uss 를 함께 묶는다. 배치·모양은 Styles/*.uss 가 이 토큰을 쓴다. */
:root {
    --git-bg: #191a1c;
    --git-sidebar-bg: #191a1c;
    --git-toolbar-bg: #191a1c;
    --git-header-bg: #191a1c;
    --git-list-bg: #191a1c;
    --git-text: #d1d3d9;
    --git-text-muted: #80838a;
    /* 위 작업 막대(Fetch·Push…) 아이콘. */
    --git-action-icon: #d1d3d9;
    --git-border: #33353b;
    --git-divider: #26282c;
    --git-hover: #26282c;
    --git-pressed: #33353b;
    --git-selected: #2a4371;
    --git-selected-text: #d1d3d9;
    --git-row-alt: rgba(0,0,0,0);
    --git-accent: #3871e1;
    --git-accent-hover: #3366cc;
    --git-accent-text: #ffffff;
    /* 강조색을 글자·선 아이콘에 쓸 때(개수·현재 브랜치 아이콘·링크). 바탕용 --git-accent 는 작은 글자로 읽기 어려워 따로 둔다(대비 5:1 이상). */
    --git-accent-fg: #7aa7ff;
    /* 사이드바 참조 트리 구역(로컬·리모트…) 옆 개수. */
    --git-section-count: #7aa7ff;
    /* 우클릭 메뉴(GitContextMenu): 바탕·테두리·고른 줄·고른 줄 글자·그림자. */
    --git-menu-bg: #2b2d30;
    --git-menu-border: #43454a;
    --git-menu-hover: #2e436e;
    --git-menu-hover-text: #dfe1e5;
    --git-menu-shadow: rgba(0,0,0,0.45);
    --git-success: #5fb865;
    --git-warning: #d6ae58;
    --git-danger: #db5c5c;
    /* 성공(Stage·추가)·위험(Unstage·버리기) 버튼: 테두리는 --git-success·--git-danger, 바탕은 같은 색을 옅게(soft → 올림 → 누름),
       꽉 채운 바탕(strong, 누름)과 그 위 글자(--git-on-strong). */
    --git-success-soft: rgba(95, 184, 101, 0.18);
    --git-success-soft-hover: rgba(95, 184, 101, 0.32);
    --git-success-soft-pressed: rgba(95, 184, 101, 0.45);
    --git-success-strong: rgba(95, 184, 101, 0.6);
    --git-success-strong-pressed: rgba(95, 184, 101, 0.8);
    --git-danger-soft: rgba(219, 92, 92, 0.18);
    --git-danger-soft-hover: rgba(219, 92, 92, 0.32);
    --git-danger-soft-pressed: rgba(219, 92, 92, 0.45);
    --git-danger-strong: rgba(219, 92, 92, 0.6);
    --git-danger-strong-pressed: rgba(219, 92, 92, 0.8);
    --git-on-strong: #ffffff;
    --git-refs: #3876fd;
    --git-badge-bg: #33353b;
    --git-field-bg: #191a1c;
    --git-field-border: #40434a;
    --git-button-bg: #191a1c;
    --git-button-border: #40434a;
    --git-button-hover: #26282c;
    --git-radius: 6px;
    --git-state-modified: #70aeff;
    --git-state-added: #73bd79;
    --git-state-deleted: #80838a;
    --git-state-renamed: #6abec2;
    --git-state-untracked: #e88f89;
    --git-state-conflicted: #f75464;
    --git-state-text: #191a1c;
    --git-graph-bg: #191a1c;
    --git-graph-header-bg: #191a1c;
    --git-graph-header-border: #26282c;
    --git-graph-subject: #b0b3ba;
    --git-graph-date: #b4b7bd;
    --git-graph-lane-bg: #26282c;
    --git-graph-lane-text: #d1d3d9;
    --git-graph-pill-bg: #233558;
    --git-graph-pill-head: #5fb865;
    --git-graph-pill-tag: #c79a3a;
    --git-graph-pill-text: #ffffff;
    --git-graph-empty: #6a6d74;
    --git-graph-tooltip-bg: #26282c;
    --git-graph-tooltip-text: #d1d3d9;
    --git-graph-selection: #d1d3d9;
    --git-graph-search: #d6ae58;
    --git-graph-head: #5fb865;
    --git-graph-date-band: rgba(255,255,255,0.06);
    --git-graph-truncated: rgba(128,131,138,0.5);
    /* 커밋 그래프 작업 중 줄의 변경 개수 아이콘(+·−)의 색: 추가·지움. */
    --git-count-added: #73bd79;
    --git-count-deleted: #e88f89;
    --git-diff-bg: #191a1c;
    --git-diff-added-line: #22352a;
    --git-diff-added-change: #33573c;
    --git-diff-removed-line: #3f2c2c;
    --git-diff-removed-change: #683837;
    --git-diff-hunk: #233042;
    --git-diff-hunk-text: #6f96f0;
    --git-diff-gutter: #191a1c;
    --git-diff-number: #4c4f56;
    --git-diff-text: #bcbec4;
    --git-diff-empty: #202124;
    --git-diff-added-sign: #73bd79;
    --git-diff-removed-sign: #f75464;
    --git-diff-split-border: #26282c;
    --git-diff-text-selection: rgba(33,66,131,0.95);
    /* diff 의 "이 파일 편집" 코드 편집기: 문법 색(키워드·문자열·숫자·주석·키), 지금 줄, 들여쓰기 안내선, 커서, 지금 줄 번호. */
    --git-code-keyword: #cf8e6d;
    --git-code-string: #6aab73;
    --git-code-number: #2aacb8;
    --git-code-comment: #7a7e85;
    --git-code-key: #c77dbb;
    --git-editor-current-line: rgba(255,255,255,0.045);
    --git-editor-indent-guide: rgba(255,255,255,0.09);
    --git-editor-caret: #cecfd2;
    --git-editor-number-current: #a1a3ab;
}

/* 양쪽 사이드 패널(왼쪽 사이드바, 오른쪽 작업 패널)은 가운데보다 한 단계 밝은 바탕. 안쪽 목록·머리 줄·입력 칸도 같은 바탕을 쓰고, 호버·눌림은 한 단계씩 올린다. */
.git-sidebar,
.graph-workspace__side,
.workspace__side {
    --git-sidebar-bg: #26282c;
    --git-header-bg: #26282c;
    --git-list-bg: #26282c;
    --git-field-bg: #26282c;
    --git-button-bg: #26282c;
    --git-hover: #33353b;
    --git-button-hover: #33353b;
    --git-pressed: #3c3f45;
    --git-divider: #33353b;
}
