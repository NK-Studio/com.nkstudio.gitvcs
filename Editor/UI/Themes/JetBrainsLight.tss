@import url("../Styles/GitThemes.uss");

/* JetBrains — Light (IntelliJ/Android Studio New UI Light). 색·모서리 토큰을 정의하고, Unity 기본 컨트롤이 이 토큰을 따르게 하는 Styles/GitThemes.uss 를 함께 묶는다. 배치·모양은 Styles/*.uss 가 이 토큰을 쓴다. */
:root {
    /* 스크롤바 막대(화살표·바탕 없이 둥근 막대만, macOS·IntelliJ 처럼). 평소·마우스 올림·끄는 중. */
    --git-scroll-thumb: rgba(0,0,0,0.18);
    --git-scroll-thumb-hover: rgba(0,0,0,0.30);
    --git-scroll-thumb-active: rgba(0,0,0,0.42);
    --git-bg: #ffffff;
    --git-sidebar-bg: #f7f8fa;
    --git-toolbar-bg: #f7f8fa;
    --git-header-bg: #f7f8fa;
    --git-list-bg: #ffffff;
    --git-text: #000000;
    --git-text-muted: #6c707e;
    /* 본문과 흐린 글자 사이: 늘 보여야 하는 보조 아이콘(PR 필터 추가 등). */
    --git-text-secondary: #4e5260;
    /* 위 작업 막대(Fetch·Push…) 아이콘. 밝은 테마에서 글자색(검정)을 쓰면 막대가 무거워 보여 IntelliJ 도구 막대처럼 한 단계 흐리게. */
    --git-action-icon: #5e6270;
    --git-border: #ebecf0;
    --git-divider: #ebecf0;
    --git-hover: #dfe1e5;
    --git-pressed: #d3d5db;
    --git-selected: #d5e1ff;
    --git-selected-text: #000000;
    /* 사이드바에서 지금 체크아웃한 브랜치 줄의 바탕(한 단계 밝은 회색, 왼쪽 강조 막대와 함께). 고른 줄(--git-selected)이 이보다 앞선다. */
    --git-current-row: #e9ebef;
    --git-row-alt: rgba(0,0,0,0);
    --git-accent: #3574f0;
    --git-accent-hover: #3369d6;
    --git-accent-text: #ffffff;
    /* 강조색을 글자·선 아이콘에 쓸 때(개수·현재 브랜치 아이콘·링크). 바탕용 --git-accent 는 작은 글자로 읽기 어려워 따로 둔다(대비 5:1 이상). */
    --git-accent-fg: #1d55b8;
    /* 사이드바 참조 트리 구역(로컬·리모트…) 옆 개수. */
    --git-section-count: #1d55b8;
    /* 우클릭 메뉴(GitContextMenu): 바탕·테두리·고른 줄·고른 줄 글자·그림자. */
    --git-menu-bg: #ffffff;
    --git-menu-border: #dfe1e5;
    --git-menu-hover: #d5e1ff;
    --git-menu-hover-text: #000000;
    --git-menu-shadow: rgba(0,0,0,0.12);
    /* 떠 있는 UI 그림자(GitShadow): 메뉴·팝업·대화 상자·서랍은 large, 말풍선·떠 있는 버튼은 small. */
    --git-shadow-large: rgba(0,0,0,0.06);
    --git-shadow-small: rgba(0,0,0,0.08);
    --git-success: #208a3c;
    --git-warning: #a46704;
    --git-danger: #db3b4b;
    /* 성공(Stage·추가)·위험(Unstage·버리기) 버튼: 평소엔 테두리(--git-success·--git-danger)만, 마우스를 올리면 꽉 채운 바탕(strong, 누름)과 그 위 글자(--git-on-strong). */
    --git-success-strong: #2ea44f;
    --git-success-strong-pressed: #2a9147;
    --git-danger-strong: #db3b4b;
    --git-danger-strong-pressed: #c22f3f;
    --git-on-strong: #ffffff;
    --git-refs: #2e55a3;
    --git-badge-bg: #ebecf0;
    --git-field-bg: #ffffff;
    --git-field-border: #c9ccd6;
    --git-button-bg: #ffffff;
    --git-button-border: #c9ccd6;
    --git-button-hover: #f0f1f3;
    --git-radius: 6px;
    --git-radius-small: 4px;
    --git-state-modified: #3574f0;
    --git-state-added: #208a3c;
    --git-state-deleted: #6c707e;
    --git-state-renamed: #078080;
    --git-state-untracked: #db3b4b;
    --git-state-conflicted: #d81b60;
    --git-state-text: #ffffff;
    --git-graph-bg: #ffffff;
    --git-graph-header-bg: #f7f8fa;
    --git-graph-header-border: #ebecf0;
    --git-graph-subject: #494b57;
    --git-graph-date: #6c707e;
    --git-graph-lane-bg: #f2f3f5;
    --git-graph-lane-text: #000000;
    --git-graph-pill-bg: #3574f0;
    --git-graph-pill-head: #208a3c;
    --git-graph-pill-tag: #a46704;
    --git-graph-pill-text: #ffffff;
    --git-graph-empty: #818594;
    --git-graph-tooltip-bg: #ffffff;
    --git-graph-tooltip-text: #000000;
    --git-graph-selection: #3574f0;
    --git-graph-search: #e5a823;
    --git-graph-head: #208a3c;
    --git-graph-date-band: rgba(0,0,0,0.05);
    /* 그래프 커밋 원·이름표 아래 그림자. */
    --git-graph-shadow: rgba(0,0,0,0.14);
    --git-graph-truncated: rgba(108,112,126,0.5);
    /* 커밋 그래프 작업 중 줄의 변경 개수 아이콘(+·−)의 색: 추가·지움. */
    --git-count-added: #208a3c;
    --git-count-deleted: #db3b4b;
    --git-diff-bg: #ffffff;
    --git-diff-added-line: #eaf5ea;
    --git-diff-added-change: #bee6c1;
    --git-diff-removed-line: #fbebeb;
    --git-diff-removed-change: #f5c2c2;
    --git-diff-hunk: #edf3ff;
    --git-diff-hunk-text: #3574f0;
    --git-diff-gutter: #ffffff;
    --git-diff-number: #a8adbd;
    --git-diff-text: #080808;
    --git-diff-empty: #f7f8fa;
    --git-diff-added-sign: #208a3c;
    --git-diff-removed-sign: #db3b4b;
    --git-diff-split-border: #ebecf0;
    --git-diff-text-selection: rgba(166,210,255,0.9);
    /* diff 의 "이 파일 편집" 코드 편집기: 문법 색(키워드·문자열·숫자·주석·키), 지금 줄, 들여쓰기 안내선, 커서, 지금 줄 번호. */
    --git-code-keyword: #0033b3;
    --git-code-string: #067d17;
    --git-code-number: #1750eb;
    --git-code-comment: #8c8c8c;
    --git-code-key: #871094;
    --git-editor-current-line: rgba(0,0,0,0.045);
    --git-editor-indent-guide: rgba(0,0,0,0.10);
    --git-editor-caret: #000000;
    --git-editor-number-current: #767a8a;
}
