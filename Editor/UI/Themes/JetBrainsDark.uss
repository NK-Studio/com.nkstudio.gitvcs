/* JetBrains — Dark (IntelliJ/Android Studio New UI Dark). 색·모서리 토큰만 정의한다 — 배치·모양은 Styles/*.uss 가 이 토큰을 쓴다. */
:root {
    --git-bg: #1e1f22;
    --git-sidebar-bg: #2b2d30;
    --git-toolbar-bg: #2b2d30;
    --git-header-bg: #2b2d30;
    --git-list-bg: #1e1f22;
    --git-text: #dfe1e5;
    --git-text-muted: #868a91;
    --git-border: #393b40;
    --git-divider: #393b40;
    --git-hover: #393b40;
    --git-pressed: #43454a;
    --git-selected: #2e436e;
    --git-selected-text: #dfe1e5;
    --git-row-alt: rgba(0,0,0,0);
    --git-accent: #3574f0;
    --git-accent-hover: #366ace;
    --git-accent-text: #ffffff;
    --git-success: #5fb865;
    --git-warning: #d6ae58;
    --git-danger: #db5c5c;
    --git-refs: #548af7;
    --git-badge-bg: #393b40;
    --git-field-bg: #1e1f22;
    --git-field-border: #4e5157;
    --git-button-bg: #2b2d30;
    --git-button-border: #4e5157;
    --git-button-hover: #393b40;
    --git-radius: 6px;
    --git-state-modified: #70aeff;
    --git-state-added: #73bd79;
    --git-state-deleted: #868a91;
    --git-state-renamed: #6abec2;
    --git-state-untracked: #e88f89;
    --git-state-conflicted: #f75464;
    --git-state-text: #1e1f22;
    --git-graph-bg: #1e1f22;
    --git-graph-header-bg: #2b2d30;
    --git-graph-header-border: #393b40;
    --git-graph-subject: #b4b8bf;
    --git-graph-date: #868a91;
    --git-graph-lane-bg: #2b2d30;
    --git-graph-lane-text: #dfe1e5;
    --git-graph-pill-bg: #35538f;
    --git-graph-pill-head: #5fb865;
    --git-graph-pill-tag: #c79a3a;
    --git-graph-pill-text: #ffffff;
    --git-graph-empty: #6f737a;
    --git-graph-tooltip-bg: #2b2d30;
    --git-graph-tooltip-text: #dfe1e5;
    --git-graph-selection: #dfe1e5;
    --git-graph-search: #d6ae58;
    --git-graph-head: #5fb865;
    --git-graph-date-band: rgba(255,255,255,0.02);
    --git-graph-truncated: rgba(134,138,145,0.5);
    --git-diff-bg: #1e1f22;
    --git-diff-added-line: #253a2b;
    --git-diff-added-change: #375c3f;
    --git-diff-removed-line: #45302f;
    --git-diff-removed-change: #6e3b3a;
    --git-diff-hunk: #2b3346;
    --git-diff-hunk-text: #6f96f0;
    --git-diff-gutter: #1e1f22;
    --git-diff-number: #4b5059;
    --git-diff-text: #bcbec4;
    --git-diff-empty: #262729;
    --git-diff-added-sign: #73bd79;
    --git-diff-removed-sign: #f75464;
    --git-diff-split-border: #393b40;
}
