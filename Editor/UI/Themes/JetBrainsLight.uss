/* JetBrains — Light (IntelliJ/Android Studio New UI Light). 색·모서리 토큰만 정의한다 — 배치·모양은 Styles/*.uss 가 이 토큰을 쓴다. */
:root {
    --git-bg: #ffffff;
    --git-sidebar-bg: #f7f8fa;
    --git-toolbar-bg: #f7f8fa;
    --git-header-bg: #f7f8fa;
    --git-list-bg: #ffffff;
    --git-text: #000000;
    --git-text-muted: #6c707e;
    --git-border: #ebecf0;
    --git-divider: #ebecf0;
    --git-hover: #dfe1e5;
    --git-pressed: #d3d5db;
    --git-selected: #d5e1ff;
    --git-selected-text: #000000;
    --git-row-alt: rgba(0,0,0,0);
    --git-accent: #3574f0;
    --git-accent-hover: #3369d6;
    --git-accent-text: #ffffff;
    /* 강조색을 글자·선 아이콘에 쓸 때(개수·현재 브랜치 아이콘·링크). 바탕용 --git-accent 는 작은 글자로 읽기 어려워 따로 둔다(대비 5:1 이상). */
    --git-accent-fg: #1d55b8;
    --git-success: #208a3c;
    --git-warning: #a46704;
    --git-danger: #db3b4b;
    --git-refs: #2e55a3;
    --git-badge-bg: #ebecf0;
    --git-field-bg: #ffffff;
    --git-field-border: #c9ccd6;
    --git-button-bg: #ffffff;
    --git-button-border: #c9ccd6;
    --git-button-hover: #f0f1f3;
    --git-radius: 6px;
    --git-state-modified: #3574f0;
    --git-state-added: #208a3c;
    --git-state-deleted: #6c707e;
    --git-state-renamed: #078080;
    --git-state-untracked: #db3b4b;
    --git-state-conflicted: #d81b60;
    --git-state-text: #ffffff;
    --git-graph-bg: #ffffff;
    --git-graph-header-bg: #f7f8fa;
    --git-graph-header-border: #ebecf0;
    --git-graph-subject: #494b57;
    --git-graph-date: #6c707e;
    --git-graph-lane-bg: #f2f3f5;
    --git-graph-lane-text: #000000;
    --git-graph-pill-bg: #3574f0;
    --git-graph-pill-head: #208a3c;
    --git-graph-pill-tag: #a46704;
    --git-graph-pill-text: #ffffff;
    --git-graph-empty: #818594;
    --git-graph-tooltip-bg: #ffffff;
    --git-graph-tooltip-text: #000000;
    --git-graph-selection: #3574f0;
    --git-graph-search: #e5a823;
    --git-graph-head: #208a3c;
    --git-graph-date-band: rgba(0,0,0,0.05);
    --git-graph-truncated: rgba(108,112,126,0.5);
    --git-diff-bg: #ffffff;
    --git-diff-added-line: #eaf5ea;
    --git-diff-added-change: #bee6c1;
    --git-diff-removed-line: #fbebeb;
    --git-diff-removed-change: #f5c2c2;
    --git-diff-hunk: #edf3ff;
    --git-diff-hunk-text: #3574f0;
    --git-diff-gutter: #ffffff;
    --git-diff-number: #a8adbd;
    --git-diff-text: #080808;
    --git-diff-empty: #f7f8fa;
    --git-diff-added-sign: #208a3c;
    --git-diff-removed-sign: #db3b4b;
    --git-diff-split-border: #ebecf0;
}
